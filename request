iptions = subs || [];\\r\\n                  debugState.subscriptionsList = debugSafe(subscriptions);\\r\\n                  hasSubscriptions = await checkIsPurchased(subscriptions.map(s => s.id));\\r\\n                  debugState.hasSubscriptionsResolved = hasSubscriptions;\\r\\n                  console.log(\'[assinatura] hasSubscriptions =\', hasSubscriptions, \'produtos:\', subscriptions.map(s => s.id));\\r\\n                } catch (e) {\\r\\n                  debugLogError(\'getSubscriptions:checkIsPurchased\', e);\\r\\n                  console.error(\'[assinatura] erro checando compras (checkIsPurchased)\', e);\\r\\n                  hasSubscriptions = false;\\r\\n                  debugState.hasSubscriptionsResolved = false;\\r\\n                }\\r\\n                resolve();\\r\\n              });\\r\\n            } catch (e) {\\r\\n              debugLogError(\'getSubscriptions:getCurrentUser:catch\', e);\\r\\n              console.error(\'[assinatura] erro no callback de getCurrentUser\', e);\\r\\n              hasSubscriptions = false;\\r\\n              debugState.hasSubscriptionsResolved = false;\\r\\n              resolve();\\r\\n            }\\r\\n          });\\r\\n        } catch (e) {\\r\\n          debugLogError(\'getSubscriptions:catch\', e);\\r\\n          console.error(\'[assinatura] erro ao iniciar checagem de assinatura\', e);\\r\\n          hasSubscriptions = false;\\r\\n          debugState.hasSubscriptionsResolved = false;\\r\\n          resolve();\\r\\n        }\\r\\n      });\\r\\n    }\\r\\n\\r\\n    // ─────────────────────────────────────────────\\r\\n    // GUIAS PAGOS → redireciona para a tela de pagamento (Buildfire)\\r\\n    // ─────────────────────────────────────────────\\r\\n    function goToPaymentScreen() {\\r\\n      if (typeof GuidesAPI.openPaywall === \'function\') {\\r\\n        GuidesAPI.openPaywall().catch(e => debugLogError(\'openPaywall:GuidesAPI\', e));\\r\\n      }\\r\\n    }\\r\\n\\r\\n    function openGuide(