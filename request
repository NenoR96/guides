de montar o corpo: é nele que a âncora de fim de leitura vive.\\r\\n      readerEndAnchor = findReaderEndAnchor(document.getElementById(\'reader-body\'));\\r\\n      buildReaderJump(id);\\r\\n\\r\\n      const tldrList = document.getElementById(\'tldr-list\');\\r\\n      tldrList.innerHTML = guide.tldr.map(t => `<li>${t}</li>`).join(\'\');\\r\\n\\r\\n      const btn = document.getElementById(\'btn-mark-read\');\\r\\n      if (readGuides.has(id)) {\\r\\n        btn.textContent = guideLabel(\'alreadyRead\', \'✓ Já lido\u0021\');\\r\\n        btn.className = \'btn-read done\';\\r\\n      } else {\\r\\n        btn.textContent = guideLabel(\'markRead\', \'✓ Marcar como lido\');\\r\\n        btn.className = \'btn-read\';\\r\\n      }\\r\\n      renderRelatedGuides(guide);\\r\\n\\r\\n      showScreen(\'reader\');\\r\\n      scrollReaderToSavedPosition(id, anchor);\\r\\n      updateReaderProgressBar();\\r\\n    }\\r\\n\\r\\n    function handleDeepLink(value) {\\r\\n      const data = value && value.deeplinkData ? value.deeplinkData : value;\\r\\n      if (\u0021data) return;\\r\\n      if (data.type === \'quiz\') {\\r\\n        const quizId = String(data.quizId || \'\').trim();\\r\\n        if (quizId && QUIZ_BY_ID[quizId]) {\\r\\n          openQuizPlay(quizId);\\r\\n          if (data.origin === \'app-home\') quizReturnScreen = \'age\';\\r\\n        }\\r\\n        return;\\r\\n      }\\r\\n      if (data.type && data.type \u0021== \'guide\') return;\\r\\n      const guideId = String(data.guideId || data.slug || \'\').trim();\\r\\n      if (\u0021guideId || \u0021ALL_GUIDES_FLAT.some(guide => guide.id === guideId)) return;\\r\\n      openGuide(guideId, \'deeplink\', String(data.anchor || \'\').trim());\\r\\n    }\\r\\n\\r\\n    // ─────────────────────────────────────────────\\r\\n    // MARK AS READ\\r\\n    // ─────────────────────────────────────────────\\r\\n    // Mesmo botão marca e desmarca - útil pra corrigir um toque sem querer,\\r\\n    // ou voltar atrás se a pessoa quer reler o guia do zero mais tarde.\\r\\n    function toggleReadStatus() {\\r\\n      if (\u0021currentGuideId) return;\\r\\n      const nowRead = \u0021readGuides.has(currentGuideId);\\r\\n\\r\\n      // Desmarcar é decisão explícita dela: o guia volta ao zero e não pode\\r\\n      // ser remarcado por baixo. Sem desarmar as duas travas, continuar\\r\\n      // parada no fim do texto remarcaria na sequência (auto-concluir), e a\\r\\n      // saída da tela regravaria a fração (posição salva).\\r\\n      if (\u0021nowRead) {\\r\\n        autoCompleteArmed = false;\\r\\n        readerPositionSaveArmed = false;\\r\\n      }\\r\\n\\r\\n      applyReadState(nowRead, { celebrate: nowRead });\\r\\n    }\\r\\n\\r\\n    // Aplica o estado de lido/não lido do guia aberto. Usado pelo botão e pelo\\r\\n    // auto-concluir do fim do guia.\\r\\n    function applyReadState(nowRead, opts) {\\r\\n      const guideId = currentGuideId;\\r\\n      if (\u0021guideId) return;\\r\\n\\r\\n      if (nowRead) {\\r\\n        readGuides.add(guideId);\\r\\n      } else {\\r\\n        readGuides.delete(guideId);\\r\\n      }\\r\\n\\r\\n      // A posição salva perde o sentido nos dois sentidos: concluído reabre do\\r\\n      // início, e desmarcado volta a valer como guia nunca aberto (0%).\\r\\n      delete readerScrollPositions[guideId];\\r\\n      saveReadGuides();\\r\\n\\r\\n      const btn = document.getElementById(\'btn-mark-read\');\\r\\n      if (btn) {\\r\\n        btn.textContent = nowRead ? guideLabel(\'alreadyRead\', \'✓ Já lido\u0021\') : guideLabel(\'markRead\', \'✓ Marcar como lido\');\\r\\n        btn.className = \'btn-read\' + (nowRead ? \' done\' : \'\');\\r\\n      }\\r\\n\\r\\n      const currentGuide = ALL_GUIDES_FLAT.find(g => g.id === guideId);\\r\\n      if (currentGuide) {\\n        renderRelatedGuides(currentGuide);\\n        document.getElementById(\'reader-title\').innerHTML = guideIconBadgeHTML(currentGuide, 26, 40) + `<span>${currentGuide.title}</span>`;\\n  