c/span>\\\\u003c/p>\\",\\n      \\"premium\\": false,\\n      \\"published\\": true,\\n      \\"migratedFrom\\": \\"guias-interativo_cateogries.html\\",\\n      \\"updatedAt\\": \\"2026-10-17T22:09:40.097Z\\",\\n      \\"journeySectionKey\\": \\"6\\",\\n      \\"callOuts\\": [],\\n      \\"callOut\\": \\"\\",\\n      \\"callOutAnchor\\": \\"\\",\\n      \\"iconUnread\\": \\"\\",\\n      \\"iconStart\\": \\"\\",\\n      \\"iconRead\\": \\"\\"\\n    },\\n    {\\n      \\"schemaVersion\\": 1,\\n      \\"slug\\": \\"manual-coco\\",\\n      \\"title\\": \\"Todo sobre la caca\\",\\n      \\"tag\\": \\"Saúde\\",\\n      \\"icon\\": \\"diaper\\",\\n      \\"readTime\\": \\"10 min\\",\\n      \\"phaseKeys\\": [\\n        \\"6\\",\\n        \\"7\\",\\n        \\"8\\",\\n        \\"9\\",\\n        \\"10\\",\\n        \\"11\\",\\n        \\"12\\",\\n        \\"24\\"\\n      ],\\n      \\"listThemeKey\\": \\"tema-saude\\",\\n      \\"listThemeLabel\\": \\"Saúde do bebê\\",\\n      \\"listThemeSubtitle\\": \\"Cocô, dentinhos e dias de doença\\",\\n      \\"listThemeIcon\\": \\"heart-pulse\\",\\n      \\"tldr\\": [\\n        \\"Mudanças nas fezes são esperadas com a IA - textura, cor e frequência vão mudar\\",\\n        \\"Ver pedaços de alimento nas fezes é completamente normal no início\\",\\n        \\"Fezes duras e secas indicam constipação - ajuste a hidratação\\",\\n        \\"Cores preocupantes: branco, vermelho vivo (sangue), preto (exceto se comeu beterraba/carvão)\\"\\n      ],\\n      \\"bodyHtml\\": \\"\\\\u003cp class=\\\\\\"bf-wysiwyg-top bf-wysiwyg-hide-app\\\\\\">\\\\u003cimg data-no-blob=\\\\\\"\\\\\\" data-id=\\\\\\"1740065560101\\\\\\" src=\\\\\\"data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAAEAAAABAQMAAAAl21bKAAAAA1BMVEUAAACnej3aAAAAAXRSTlMAQObYZgAAAApJREFUCNdjYAAAAAIAAeIhvDMAAAAASUVORK5CYII=\\\\\\" style=\\\\\\"display: none;\\\\\\" data-type=\\\\\\"dynamic-expression\\\\\\" class=\\\\\\"\\\\\\">\\\\u003c/p>\\\\n\\\\u003cp class=\\\\\\"bf-wysiwyg-top bf-wysiwyg-hide-app\\\\\\">\\\\u003cstrong>\\\\u003ca href=\\\\\\"#poop\\\\\\">• Patrones de heces\\\\u003c/a>\\\\u003c/strong>\\\\u003c/p>\\\\n\\\\u003cp class=\\\\\\"bf-wysiwyg-top bf-wysiwyg-hide-app\\\\\\">\\\\u003cstrong>\\\\u003ca href=\\\\\\"#navigating\\\\\\">• Qué hacer frente al estreñimiento\\\\u003c/a>\\\\u003c/strong>\\\\u003c/p>\\\\n\\\\u003cp class=\\\\\\"bf-wysiwyg-top bf-wysiwyg-hide-app\\\\\\">\\\\u003ca href=\\\\\\"#top3\\\\\\">&nbsp;- Tres remedios para el estreñimiento\\\\u003c/a>\\\\u003c/p>\\\\n\\\\u003cp class=\\\\\\"bf-wysiwyg-top bf-wysiwyg-hide-app\\\\\\">\\\\u003ca href=\\\\\\"#loosen\\\\\\">&nbsp;- Alimentos laxantes\\\\u003c/a>\\\\u003c/p>\\\\n\\\\u003cp class=\\\\\\"bf-wysiwyg-top bf-wysiwyg-hide-app\\\\\\">\\\\u003ca href=\\\\\\"#transitioning\\\\\\">&nbsp;- Cómo evitar el estreñimiento al inicio de la alimentación complementaria\\\\u003c/a>\\\\u003c/p>\\\\n\\\\u003cp class=\\\\\\"bf-wysiwyg-top bf-wysiwyg-hide-app\\\\\\">\\\\u003cstrong>\\\\u003ca href=\\\\\\"#diarrhea\\\\\\">• Diarrea\\\\u003c/a>\\\\u003c/strong>\\\\u003c/p>\\\\n\\\\u003chr class=\\\\\\"bf-wysiwyg-top bf-wysiwyg-hide-app\\\\\\">\\\\n\\\\u003cp id=\\\\\\"poop\\\\\\" class=\\\\\\"bf-wysiwyg-top bf-wysiwyg-hide-app\\\\\\">\\\\u003cimg src=\\\\\\"https://buildfire.imgix.net/dcbca80b-3d23-11ea-91c9-06e43182e96c/691611d0-f062-11ef-b10e-992dd3732961.png?width=1440&amp;height=1440\\\\\\" alt=\\\\\\"\\\\\\" expr-src=\\\\\\"${buildfire.imageLib.resizeImage(\'https://s3-us-west-2.amazonaws.com/imageserver.prod/dcbca80b-3d23-11ea-91c9-06e43182e96c/691611d0-f062-11ef-b10e-992dd3732961.png\', { size: \'full_width\', aspect: \'1:1\' })}\\\\\\" class=\\\\\\"full_width\\\\\\" data-bf-image=\\\\\\"%7B%22resize%22%3Atrue%2C%22crop%22%3A%22%22%2C%22fixed%22%3A%22%22%2C%22responsive%22%3A%22full_width%22%2C%22originalSrc%22%3A%22https%3A//s3-us-west-2.amazonaws.com/imageserver.prod/dcbca80b-3d23-11ea-91c9-06e43182e96c/691611d0-f062-11ef-b10e-992dd3732961.png%22%7D\\\\\\">\\\\u003c/p>\\\\n\\\\u003ch4 class=\\\\\\"bf-wysiwyg-top bf-wysiwyg-hide-app\\\\\\">\\\\u003cstrong>Patrones de heces en bebés que de pecho y en bebés alimentados con leche de fórmula\\\\u003c/strong>\\\\u003c/h4>\\\\n\\\\u003cp class=\\\\\\"bf-wysiwyg-top bf-wysiwyg-hide-app\\\\\\">\\\\u003cspan style=\\\\\\"font-weight: 400;\\\\\\">A medida que los bebés crecen, las cacas pueden variar mucho, además de que cada bebé es diferente.&nbsp;\\\\u003c/span>\\\\u003c/p>\\\\n\\\\u003cp class=\\\\\\"bf-wysiwyg-top bf-wysiwyg-hide-app\\\\\\">\\\\u003cspan style=\\\\\\"font-weight: 400;\\\\\\">Según diversos estudios, si un bebé toma el pecho, sus deposiciones pueden ser más líquidas, amarillentas y más frecuentes durante los 3 primeros meses de vida.\\\\u003c/span>\\\\u003cspan style=\\\\\\"font-weight: 400;\\\\\\">\\\\u003csup>1\\\\u003c/sup> \\\\u003c/span>\\\\u003cspan style=\\\\\\"font-weight: 400;\\\\\\">Se trata de deposiciones normales, aunque pueda parecer “diarrea”.&nbsp;\\\\u003c/span>\\\\u003c/p>\\\\n\\\\u003cp class=\\\\\\"bf-wysiwyg-top bf-wysiwyg-hide-app\\\\\\">\\\\u003cspan style=\\\\\\"font-weight: 400;\\\\\\">A medida que el bebé crece, la frecuencia de las deposiciones puede cambiar, pero es algo variable de un peque a otro. Algunos bebés pueden hacer deposiciones blandas varias veces al día, mientras que otros pueden hacerlas una vez al día o incluso no hacer algunos días. Todos estos casos son normales.\\\\u003c/span>\\\\u003c/p>\\\\n\\\\u003cp class=\\\\\\"bf-wysiwyg-top bf-wysiwyg-hide-app\\\\\\">\\\\u003cspan style=\\\\\\"font-weight: 400;\\\\\\">En el caso de los bebés alimentados con leche de fórmula, las deposiciones pueden ser menos frecuentes (tanto si se alimentan exclusivamente con fórmula como si hacéis lactancia mixta). Alrededor de los 3 meses, pueden empezar a hacer más deposiciones de color verdoso.\\\\u003c/span>\\\\u003csup>\\\\u003cspan style=\\\\\\"font-weight: 400;\\\\\\">1\\\\u003c/span>\\\\u003c/sup>\\\\u003c/p>\\\\n\\\\u003chr class=\\\\\\"bf-wysiwyg-top bf-wysiwyg-hide-app\\\\\\">\\\\n\\\\u003ch4 class=\\\\\\"bf-wysiwyg-top bf-wysiwyg-hide-app\\\\\\">\\\\u003cstrong>Cambios normales en la caca a medida que tu bebé crece\\\\u003c/strong>\\\\u003c/h4>\\\\n\\\\u003cp class=\\\\\\"bf-wysiwyg-top bf-wysiwyg-hide-app\\\\\\">\\\\u003cstrong>Antes de empezar la alimentación complementaria:&nbsp;\\\\u003c/strong>\\\\u003c/p>\\\\n\\\\u003cp class=\\\\\\"bf-wysiwyg-top bf-wysiwyg-hide-app\\\\\\">\\\\u003cspan style=\\\\\\"font-weight: 400;\\\\\\">Después de expulsar el meconio (la primera caca, que suele ser espesa, pegajosa y de color verde oscuro o negro), los bebés pueden presentar una amplia variedad de colores en las heces, como amarillo, marrón o verde\\\\u003c/span>.&nbsp;\\\\u003c/p>\\\\n\\\\u003cp class=\\\\\\"bf-wysiwyg-top bf-wysiwyg-hide-app\\\\\\">\\\\u003cimg src=\\\\\\"https://buildfire.imgix.net/dcbca80b-3d23-11ea-91c9-06e43182e96c/colores-caca.png?width=1440&amp;height=1440\\\\\\" alt=\\\\\\"\\\\\\" expr-src=\\\\\\"${buildfire.imageLib.resizeImage(\'https://s3-us-west-2.amazonaws.com/imageserver.prod/dcbca80b-3d23-11ea-91c9-06e43182e96c/colores-caca.png\', { size: \'full_width\', aspect: \'1:1\' })}\\\\\\" class=\\\\\\"full_width\\\\\\" data-bf-image=\\\\\\"%7B%22resize%22%3Atrue%2C%22crop%22%3A%22%22%2C%22fixed%22%3A%22%22%2C%22responsive%22%3A%22full_width%22%2C%22originalSrc%22%3A%22https%3A//s3-us-west-2.amazonaws.com/imageserver.prod/dcbca80b-3d23-11ea-91c9-06e43182e96c/colores-caca.png%22%7D\\\\\\">\\\\u003c/p>\\\\n\\\\u003cp class=\\\\\\"bf-wysiwyg-top bf-wysiwyg-hide-app\\\\\\">\\\\u003cstrong>Los bebés de pecho\\\\u003c/strong>\\\\u003cspan style=\\\\\\"font-weight: 400;\\\\\\"> pueden tener deposiciones amarillas o mostaza que a veces se describen como “blandas” o “diarreicas”. A veces también pueden hacer cacas de color verde, eso significa que no están vaciando el pecho correctamente y solo están tomando la primera parte de la leche materna que es más rica en lactosa, pero no están tomando la parte final que es más rica en grasa. En estos casos hay que comprobar que vacíe bien el pecho\\\\u003c/span>.\\\\u003c/p>\\\\n\\\\u003cp class=\\\\\\"bf-wysiwyg-top bf-wysiwyg-hide-app\\\\\\">\\\\u003cstrong>Los bebés que toman fórmula\\\\u003c/strong>\\\\u003cspan style=\\\\\\"font-weight: 400;\\\\\\"> pueden hacer cacas más firmes (como la crema de cacahuete) que van del amarillo al marrón verdoso\\\\u003c/span>.\\\\u003c/p>\\\\n\\\\u003cp class=\\\\\\"bf-wysiwyg-top bf-wysiwyg-hide-app\\\\\\">\\\\u003cspan style=\\\\\\"font-weight: 400;\\\\\\">\\\\u003cimg src=\\\\\\"https://buildfire.imgix.net/51951dd8-1771-11eb-91c9-06e43182e96c/info-poop-guide--color-chartformula-fed.png?width=1215&amp;height=1215\\\\\\" alt=\\\\\\"\\\\\\" data-bf-image=\\\\\\"%7B%22resize%22%3Atrue%2C%22crop%22%3A%22%22%2C%22fixed%22%3A%22%22%2C%22responsive%22%3A%22full_width%22%2C%22originalSrc%22%3A%22https%3A//s3-us-west-2.amazonaws.com/imageserver.prod/51951dd8-1771-11eb-91c9-06e43182e96c/info-poop-guide--color-chartformula-fed.png%22%7D\\\\\\">\\\\u003c/span>\\\\u003c/p>\\\\n\\\\u003cp class=\\\\\\"bf-wysiwyg-top bf-wysiwyg-hide-app\\\\\\">\\\\u003cspan style=\\\\\\"font-weight: 400;\\\\\\">Los bebés alimentados con\\\\u003c/span>\\\\u003cstrong> lactancia mixta\\\\u003c/strong>\\\\u003cspan style=\\\\\\"font-weight: 400;\\\\\\"> pueden presentar una combinación de todos estos colores y consistencias\\\\u003c/span>.&nbsp;\\\\u003cspan style=\\\\\\"font-weight: 400;\\\\\\">\\\\u003c/span>\\\\u003c/p>\\\\n\\\\u003cblockquote class=\\\\\\"bf-wysiwyg-top bf-wysiwyg-hide-app\\\\\\">\\\\n\\\\u003cp class=\\\\\\"\\\\\\">\\\\u003cspan style=\\\\\\"font-weight: 400;\\\\\\">Si ves hilillos de sangre en las heces y tu bebé está visiblemente agitado, conviene consultar con el pediatra, ya que estos podrían ser signos de alguna alergia como a la proteína de la leche de vaca.\\\\u003c/span>\\\\u003c/p>\\\\n\\\\u003c/blockquote>\\\\n\\\\u003cp class=\\\\\\"bf-wysiwyg-top bf-wysiwyg-hide-app\\\\\\">\\\\u003cstrong>\\\\u003cbr>Una vez iniciada la alimentación complementaria:&nbsp;\\\\u003c/strong>\\\\u003c/p>\\\\n\\\\u003cp class=\\\\\\"bf-wysiwyg-top bf-wysiwyg-hide-app\\\\\\">\\\\u003cspan style=\\\\\\"font-weight: 400;\\\\\\">Es muy habitual que haya cambios en el patrón de heces del bebé. Puedes nota\\\\u003c/span>r:&nbsp;\\\\u003c/p>\\\\n\\\\u003cp class=\\\\\\"bf-wysiwyg-top bf-wysiwyg-hide-app\\\\\\">\\\\u003cspan style=\\\\\\"font-weight: 400;\\\\\\">• Trozos de comida sin digerir\\\\u003c/span>\\\\u003c/p>\\\\n\\\\u003cp class=\\\\\\"bf-wysiwyg-top bf-wysiwyg-hide-app\\\\\\">\\\\u003cspan style=\\\\\\"font-weight: 400;\\\\\\">• Cambios de color\\\\u003c/span>\\\\u003c/p>\\\\n\\\\u003cp class=\\\\\\"bf-wysiwyg-top bf-wysiwyg-hide-app\\\\\\">\\\\u003cspan style=\\\\\\"font-weight: 400;\\\\\\">• Cambios de frecuencia\\\\u003c/span>\\\\u003c/p>\\\\n\\\\u003cp class=\\\\\\"bf-wysiwyg-top bf-wysiwyg-hide-app\\\\\\">\\\\u003cspan style=\\\\\\"font-weight: 400;\\\\\\">• Cambios en la consistencia, el olor o la textura&nbsp;\\\\u003cbr>\\\\u003c/span>\\\\u003c/p>\\\\n\\\\u003cp class=\\\\\\"bf-wysiwyg-top bf-wysiwyg-hide-app\\\\\\">Todo esto es normal.\\\\u003c/p>\\\\n\\\\u003cp class=\\\\\\"bf-wysiwyg-top bf-wysiwyg-hide-app\\\\\\">\\\\u003cspan style=\\\\\\"font-weight: 400;\\\\\\">Si encuentras trozos de comida sin digerir en las deposiciones de tu bebé, ¡no te preocupes\u0021 Esto no significa que el bebé no esté absorbiendo los nutrientes de la comida, sobre todo si su curva de crecimiento sigue como siempre\\\\u003c/span>.&nbsp;\\\\u003c/p>\\\\n\\\\u003chr class=\\\\\\"bf-wysiwyg-top bf-wysiwyg-hide-app\\\\\\">\\\\n\\\\u003ch5 class=\\\\\\"bf-wysiwyg-top bf-wysiwyg-hide-app\\\\\\">\\\\u003cstrong>Escala de heces de Bristol:\\\\u003c/strong>\\\\u003c/h5>\\\\n\\\\u003cp class=\\\\\\"bf-wysiwyg-top bf-wysiwyg-hide-app\\\\\\">\\\\u003cspan style=\\\\\\"font-weight: 400;\\\\\\">Esta escala es solo un ejemplo de las diferencias apreciables en las deposiciones, y puede ayudar a determinar y diagnosticar patrones como el estreñimiento o la diarrea\\\\u003c/span>.&nbsp;\\\\u003c/p>\\\\n\\\\u003cp class=\\\\\\"bf-wysiwyg-top bf-wysiwyg-hide-app\\\\\\">\\\\u003cimg src=\\\\\\"https://buildfire.imgix.net/dcbca80b-3d23-11ea-91c9-06e43182e96c/caca_bristol.png?width=1440&amp;height=1440\\\\\\" alt=\\\\\\"\\\\\\" expr-src=\\\\\\"${buildfire.imageLib.resizeImage(\'https://s3-us-west-2.amazonaws.com/imageserver.prod/dcbca80b-3d23-11ea-91c9-06e43182e96c/caca_bristol.png\', { size: \'full_width\', aspect: \'1:1\' })}\\\\\\" class=\\\\\\"full_width\\\\\\" data-bf-image=\\\\\\"%7B%22resize%22%3Atrue%2C%22crop%22%3A%22%22%2C%22fixed%22%3A%22%22%2C%22responsive%22%3A%22full_width%22%2C%22originalSrc%22%3A%22https%3A//s3-us-west-2.amazonaws.com/imageserver.prod/dcbca80b-3d23-11ea-91c9-06e43182e96c/caca_bristol.png%22%7D\\\\\\">\\\\u003cbr>\\\\u003cem>\\\\u003cspan style=\\\\\\"font-size: 12px;\\\\\\">\\\\u003cbr>*Imágenes de Stanford University Pediatric Surgery. Ilustraciones originales extraídas de \\\\u003ca data-action-item=\\\\\\"%7B%22title%22%3A%22x%22%2C%22action%22%3A%22linkToWeb%22%2C%22openIn%22%3A%22_system%22%2C%22url%22%3A%22https%3A//pediatricsurgery.stanford.edu/Conditions/BowelManagement/bristol-stool-form-scale.html%22%7D\\\\\\">pediatricsurgery.stanford.edu\\\\u003c/a>&nbsp;\\\\u003c/span>\\\\u003c/em>\\\\u003c/p>\\\\n\\\\u003cp class=\\\\\\"bf-wysiwyg-top bf-wysiwyg-hide-app\\\\\\">\\\\u003ca href=\\\\\\"#top\\\\\\">\\\\u003cimg src=\\\\\\"https://buildfire.imgix.net/dcbca80b-3d23-11ea-91c9-06e43182e96c/volver-arriba-grande.png?width=1440&amp;height=1440\\\\\\" alt=\\\\\\"\\\\\\" data-bf-image=\\\\\\"%7B%22resize%22%3Atrue%2C%22crop%22%3A%22%22%2C%22fixed%22%3A%22%22%2C%22responsive%22%3A%22full_width%22%2C%22originalSrc%22%3A%22https%3A//s3-us-west-2.amazonaws.com/imageserver.prod/dcbca80b-3d23-11ea-91c9-06e43182e96c/volver-arriba-grande.png%22%7D\\\\\\" expr-src=\\\\\\"${buildfire.imageLib.resizeImage(\'https://s3-us-west-2.amazonaws.com/imageserver.prod/dcbca80b-3d23-11ea-91c9-06e43182e96c/volver-arriba-grande.png\', { size: \'full_width\', aspect: \'1:1\' })}\\\\\\" class=\\\\\\"full_width\\\\\\">\\\\u003c/a>\\\\u003c/p>\\\\n\\\\u003chr class=\\\\\\"bf-wysiwyg-top bf-wysiwyg-hide-app\\\\\\">\\\\n\\\\u003cp class=\\\\\\"bf-wysiwyg-top bf-wysiwyg-hide-app\\\\\\" id=\\\\\\"navigating\\\\\\">\\\\u003cimg src=\\\\\\"https://buildfire.imgix.net/dcbca80b-3d23-11ea-91c9-06e43182e96c/95779c80-f062-11ef-b10e-992dd3732961.png?width=1440&amp;height=1440\\\\\\" alt=\\\\\\"\\\\\\" data-bf-image=\\\\\\"%7B%22resize%22%3Atrue%2C%22crop%22%3A%22%22%2C%22fixed%22%3A%22%22%2C%22responsive%22%3A%22full_width%22%2C%22originalSrc%22%3A%22https%3A//s3-us-west-2.amazonaws.com/imageserver.prod/dcbca80b-3d23-11ea-91c9-06e43182e96c/95779c80-f062-11ef-b10e-992dd3732961.png%22%7D\\\\\\" expr-src=\\\\\\"${buildfire.imageLib.resizeImage(\'https://s3-us-west-2.amazonaws.com/imageserver.prod/dcbca80b-3d23-11ea-91c9-06e43182e96c/95779c80-f062-11ef-b10e-992dd3732961.png\', { size: \'full_width\', aspect: \'1:1\' })}\\\\\\" class=\\\\\\"full_width\\\\\\">\\\\u003c/p>\\\\n\\\\u003cp class=\\\\\\"bf-wysiwyg-top bf-wysiwyg-hide-app\\\\\\">\\\\u003cspan style=\\\\\\"font-weight: 400;\\\\\\">El estreñimiento ocurre cuando un bebé experimenta un cambio en la consistencia y/o la frecuencia habitual de las deposiciones. Puede obligar a los bebés a hacer un esfuerzo para evacuar, y en niños mayores, pueden tener la sensación de que no han vaciado completamente el intestino.\\\\u003c/span>\\\\u003c/p>\\\\n\\\\u003cp class=\\\\\\"bf-wysiwyg-top bf-wysiwyg-hide-app\\\\\\">\\\\u003cspan style=\\\\\\"font-weight: 400;\\\\\\">Es un problema común que puede ser temporal o persistente. Un estreñimiento temporal puede coincidir con cambios en la medicación, la dieta o la hidratación.\\\\u003c/span>\\\\u003c/p>\\\\n\\\\u003cp class=\\\\\\"bf-wysiwyg-top bf-wysiwyg-hide-app\\\\\\">\\\\u003cspan style=\\\\\\"font-weight: 400;\\\\\\">También puede presentarse al inicio de la alimentación complementaria, al dejar la lactancia materna o la fórmula, y cuando dejan el pañal.\\\\u003c/span>\\\\u003c/p>\\\\n\\\\u003cp class=\\\\\\"bf-wysiwyg-top bf-wysiwyg-hide-app\\\\\\">\\\\u003cspan style=\\\\\\"font-weight: 400;\\\\\\">Si un bebé tiene estreñimiento antes de empezar la alimentación complementaria, puede ser útil trabajar con un especialista digestivo o un nutricionista/dietista infantil para elaborar un plan de cara a la introducción de los sólidos\\\\u003c/span>.\\\\u003csup>1,2,3&nbsp;\\\\u003c/sup>\\\\u003c/p>\\\\n\\\\u003chr class=\\\\\\"bf-wysiwyg-top bf-wysiwyg-hide-app\\\\\\">\\\\n\\\\u003cp class=\\\\\\"bf-wysiwyg-top bf-wysiwyg-hide-app\\\\\\">\\\\u003cstrong>Señales de que tu bebé puede estar estreñido:\\\\u003c/strong>\\\\u003c/p>\\\\n\\\\u003cp class=\\\\\\"bf-wysiwyg-top bf-wysiwyg-hide-app\\\\\\">\\\\u003cspan style=\\\\\\"font-weight: 400;\\\\\\">Los signos de estreñimiento pueden variar de un bebé a otro, pero pueden observarse uno o más de estos síntomas:\\\\u003c/span>\\\\u003c/p>\\\\n\\\\u003cp class=\\\\\\"bf-wysiwyg-top bf-wysiwyg-hide-app\\\\\\">\\\\u003cspan style=\\\\\\"font-weight: 400;\\\\\\">• Esfuerzo al hacer caca (que se ponga colorado/a, que haga ruiditos o se lleve las rodillas al pecho, etc.)\\\\u003cbr>\\\\u003c/span>\\\\u003c/p>\\\\n\\\\u003cp class=\\\\\\"bf-wysiwyg-top bf-wysiwyg-hide-app\\\\\\">\\\\u003cspan style=\\\\\\"font-weight: 400;\\\\\\">• Heces duras o en bolitas\\\\u003cbr>\\\\u003c/span>\\\\u003c/p>\\\\n\\\\u003cp class=\\\\\\"bf-wysiwyg-top bf-wysiwyg-hide-app\\\\\\">\\\\u003cspan style=\\\\\\"font-weight: 400;\\\\\\">• Presencia de fisuras anales que dejen restos de sangre en las heces\\\\u003cbr>\\\\u003c/span>\\\\u003c/p>\\\\n\\\\u003cp class=\\\\\\"bf-wysiwyg-top bf-wysiwyg-hide-app\\\\\\">\\\\u003cspan style=\\\\\\"font-weight: 400;\\\\\\">• Hinchazón o molestia abdominal y presencia de gases o flato\\\\u003c/span>\\\\u003c/p>\\\\n\\\\u003cp class=\\\\\\"bf-wysiwyg-top bf-wysiwyg-hide-app\\\\\\">\\\\u003cspan style=\\\\\\"font-weight: 400;\\\\\\">• Irritabilidad \\\\u003cbr>\\\\u003c/span>\\\\u003c/p>\\\\n\\\\u003chr class=\\\\\\"bf-wysiwyg-top bf-wysiwyg-hide-app\\\\\\">\\\\n\\\\u003ch4 class=\\\\\\"bf-wysiwyg-top bf-wysiwyg-hide-app\\\\\\">\\\\u003cstrong>Qué hacer frente al estreñimiento\\\\u003cbr>\\\\u003cbr>\\\\u003c/strong>\\\\u003c/h4>\\\\n\\\\u003cp class=\\\\\\"bf-wysiwyg-top bf-wysiwyg-hide-app\\\\\\">\\\\u003cspan style=\\\\\\"font-size: 16px;\\\\\\">\\\\u003cstrong>\\\\u003cimg src=\\\\\\"https://buildfire.imgix.net/dcbca80b-3d23-11ea-91c9-06e43182e96c/caca_menos6meses.png?width=1440&amp;height=1440\\\\\\" alt=\\\\\\"\\\\\\" data-bf-image=\\\\\\"%7B%22resize%22%3Atrue%2C%22crop%22%3A%22%22%2C%22fixed%22%3A%22%22%2C%22responsive%22%3A%22full_width%22%2C%22originalSrc%22%3A%22https%3A//s3-us-west-2.amazonaws.com/imageserver.prod/dcbca80b-3d23-11ea-91c9-06e43182e96c/caca_menos6meses.png%22%7D\\\\\\" expr-src=\\\\\\"${buildfire.imageLib.resizeImage(\'https://s3-us-west-2.amazonaws.com/imageserver.prod/dcbca80b-3d23-11ea-91c9-06e43182e96c/caca_menos6meses.png\', { size: \'full_width\', aspect: \'1:1\' })}\\\\\\" class=\\\\\\"full_width\\\\\\">\\\\u003c/strong>\\\\u003c/span>\\\\u003c/p>\\\\n\\\\u003cp class=\\\\\\"bf-wysiwyg-top bf-wysiwyg-hide-app\\\\\\">\\\\u003cspan style=\\\\\\"font-size: 16px;\\\\\\">\\\\u003cstrong>\\\\u003cimg src=\\\\\\"https://buildfire.imgix.net/dcbca80b-3d23-11ea-91c9-06e43182e96c/caca_mas6meses.png?width=1440&amp;height=1440\\\\\\" alt=\\\\\\"\\\\\\" data-bf-image=\\\\\\"%7B%22resize%22%3Atrue%2C%22crop%22%3A%22%22%2C%22fixed%22%3A%22%22%2C%22responsive%22%3A%22full_width%22%2C%22originalSrc%22%3A%22https%3A//s3-us-west-2.amazonaws.com/imageserver.prod/dcbca80b-3d23-11ea-91c9-06e43182e96c/caca_mas6meses.png%22%7D\\\\\\" expr-src=\\\\\\"${buildfire.imageLib.resizeImage(\'https://s3-us-west-2.amazonaws.com/imageserver.prod/dcbca80b-3d23-11ea-91c9-06e43182e96c/caca_mas6meses.png\', { size: \'full_width\', aspect: \'1:1\' })}\\\\\\" class=\\\\\\"full_width\\\\\\">&nbsp;\\\\u003c/strong>\\\\u003c/span>\\\\u003c/p>\\\\n\\\\u003cp class=\\\\\\"bf-wysiwyg-top bf-wysiwyg-hide-app\\\\\\">\\\\u003cspan style=\\\\\\"font-weight: 400;\\\\\\">Un truco que puede ayudar es poner en remojo durante toda la noche, \\\\u003cstrong>en un vaso de agua, dos cucharaditas de semillas de lino\\\\u003c/strong>. Al día siguiente, se cuela para retirar las semillas y ofreceremos el agua al bebé. También se puede hacer sustituyendo el lino por dos \\\\u003cstrong>ciruelas pasa\\\\u003c/strong>\\\\u003c/span>\\\\u003cstrong>s\\\\u003c/strong>.\\\\u003c/p>\\\\n\\\\u003cp class=\\\\\\"bf-wysiwyg-top bf-wysiwyg-hide-app\\\\\\">\\\\u003ca href=\\\\\\"#top\\\\\\">\\\\u003cimg src=\\\\\\"https://buildfire.imgix.net/dcbca80b-3d23-11ea-91c9-06e43182e96c/volver-arriba-grande.png?width=1440&amp;height=1440\\\\\\" alt=\\\\\\"\\\\\\" data-bf-image=\\\\\\"%7B%22resize%22%3Atrue%2C%22crop%22%3A%22%22%2C%22fixed%22%3A%22%22%2C%22responsive%22%3A%22full_width%22%2C%22originalSrc%22%3A%22https%3A//s3-us-west-2.amazonaws.com/imageserver.prod/dcbca80b-3d23-11ea-91c9-06e43182e96c/volver-arriba-grande.png%22%7D\\\\\\" expr-src=\\\\\\"${buildfire.imageLib.resizeImage(\'https://s3-us-west-2.amazonaws.com/imageserver.prod/dcbca80b-3d23-11ea-91c9-06e43182e96c/volver-arriba-grande.png\', { size: \'full_width\', aspect: \'1:1\' })}\\\\\\" class=\\\\\\"full_width\\\\\\">\\\\u003c/a>\\\\u003c/p>\\\\n\\\\u003chr class=\\\\\\"bf-wysiwyg-top bf-wysiwyg-hide-app\\\\\\">\\\\n\\\\u003ch4 id=\\\\\\"top3\\\\\\" class=\\\\\\"bf-wysiwyg-top bf-wysiwyg-hide-app\\\\\\">\\\\u003cstrong>Tres remedios para el estreñimiento:\\\\u003c/strong>\\\\u003c/h4>\\\\n\\\\u003cp class=\\\\\\"bf-wysiwyg-top bf-wysiwyg-hide-app\\\\\\">\\\\u003cspan style=\\\\\\"font-size: 16px;\\\\\\">\\\\u003cstrong>\\\\u003cimg src=\\\\\\"https://buildfire.imgix.net/dcbca80b-3d23-11ea-91c9-06e43182e96c/caca_3trucos.png?width=1440&amp;height=1440\\\\\\" alt=\\\\\\"\\\\\\" data-bf-image=\\\\\\"%7B%22resize%22%3Atrue%2C%22crop%22%3A%22%22%2C%22fixed%22%3A%22%22%2C%22responsive%22%3A%22full_width%22%2C%22originalSrc%22%3A%22https%3A//s3-us-west-2.amazonaws.com/imageserver.prod/dcbca80b-3d23-11ea-91c9-06e43182e96c/caca_3trucos.png%22%7D\\\\\\" expr-src=\\\\\\"${buildfire.imageLib.resizeImage(\'https://s3-us-west-2.amazonaws.com/imageserver.prod/dcbca80b-3d23-11ea-91c9-06e43182e96c/caca_3trucos.png\', { size: \'full_width\', aspect: \'1:1\' })}\\\\\\" class=\\\\\\"full_width\\\\\\">\\\\u003c/strong>\\\\u003c/span>\\\\u003c/p>\\\\n\\\\u003ch4 class=\\\\\\"bf-wysiwyg-top bf-wysiwyg-hide-app\\\\\\">\\\\u003cspan style=\\\\\\"font-size: 18px;\\\\\\">\\\\u003cstrong>Fibra\\\\u003c/strong>\\\\u003c/span>\\\\u003c/h4>\\\\n\\\\u003cp class=\\\\\\"bf-wysiwyg-top bf-wysiwyg-hide-app\\\\\\">\\\\u003cspan style=\\\\\\"font-weight: 400;\\\\\\">La fibra suele definirse como un tipo de carbohidrato que el cuerpo no digiere por completo. La fibra es muy beneficiosa para la salud general del colon y puede aliviar los síntomas del estreñimiento.\\\\u003c/span>\\\\u003csup>\\\\u003cspan style=\\\\\\"font-weight: 400;\\\\\\">3\\\\u003c/span>\\\\u003c/sup>\\\\u003c/p>\\\\n\\\\u003cp class=\\\\\\"bf-wysiwyg-top bf-wysiwyg-hide-app\\\\\\">\\\\u003cspan style=\\\\\\"font-weight: 400;\\\\\\">Una dieta rica en fibra como la que contiene la fruta, la verdura, los frutos secos y semillas, los cereales integrales y las legumbres contribuye al tránsito intestinal y a la digestión\\\\u003c/span>\\\\u003c/p>\\\\n\\\\u003cp class=\\\\\\"bf-wysiwyg-top bf-wysiwyg-hide-app\\\\\\">\\\\u003cspan style=\\\\\\"font-weight: 400;\\\\\\">La AEP (Asociación Española de Pediatría) recomienda la ingesta de unos 14 g de fibra por cada 1000 Kcal consumidas. Según la AAP (American Academy of Pediatrics) , a la edad del niño habría que sumarle 5 g de fibra dietética, es decir, un niño de 1 año debería consumir unos 6 g diarios de fibra y, uno de 3, unos 8 g diarios.&nbsp;\\\\u003c/span>\\\\u003c/p>\\\\n\\\\u003cp class=\\\\\\"bf-wysiwyg-top bf-wysiwyg-hide-app\\\\\\">\\\\u003cstrong>Incremento paulatino de fibra\\\\u003c/strong>\\\\u003c/p>\\\\n\\\\u003cp class=\\\\\\"bf-wysiwyg-top bf-wysiwyg-hide-app\\\\\\">\\\\u003cspan style=\\\\\\"font-weight: 400;\\\\\\">Aumentar el aporte de fibra a la dieta de tu peque demasiado deprisa puede provocar molestias gastrointestinales, por eso se recomienda un incremento paulatino\\\\u003c/span>.&nbsp;\\\\u003c/p>\\\\n\\\\u003cp class=\\\\\\"bf-wysiwyg-top bf-wysiwyg-hide-app\\\\\\">\\\\u003cstrong>\\\\u003cspan style=\\\\\\"font-weight: 400;\\\\\\">También se recomienda \\\\u003c/span>aumentar la hidratación si se consumen más alimentos ricos en fibra.\\\\u003c/strong>\\\\u003csup>2-9\\\\u003c/sup>\\\\u003c/p>\\\\n\\\\u003cp class=\\\\\\"bf-wysiwyg-top bf-wysiwyg-hide-app\\\\\\">\\\\u003cspan style=\\\\\\"font-size: 16px;\\\\\\">\\\\u003cimg src=\\\\\\"https://buildfire.imgix.net/dcbca80b-3d23-11ea-91c9-06e43182e96c/caca_fibra.png?width=1440&amp;height=1440\\\\\\" alt=\\\\\\"\\\\\\" data-bf-image=\\\\\\"%7B%22resize%22%3Atrue%2C%22crop%22%3A%22%22%2C%22fixed%22%3A%22%22%2C%22responsive%22%3A%22full_width%22%2C%22originalSrc%22%3A%22https%3A//s3-us-west-2.amazonaws.com/imageserver.prod/dcbca80b-3d23-11ea-91c9-06e43182e96c/caca_fibra.png%22%7D\\\\\\" expr-src=\\\\\\"${buildfire.imageLib.resizeImage(\'https://s3-us-west-2.amazonaws.com/imageserver.prod/dcbca80b-3d23-11ea-91c9-06e43182e96c/caca_fibra.png\', { size: \'full_width\', aspect: \'1:1\' })}\\\\\\" class=\\\\\\"full_width\\\\\\">\\\\u003c/span>\\\\u003c/p>\\\\n\\\\u003chr class=\\\\\\"bf-wysiwyg-top bf-wysiwyg-hide-app\\\\\\">\\\\n\\\\u003ch4 class=\\\\\\"bf-wysiwyg-top bf-wysiwyg-hide-app\\\\\\">\\\\u003cstrong>\\\\u003cspan style=\\\\\\"font-size: 18px;\\\\\\">Sorbitol\\\\u003c/span>\\\\u003c/strong>\\\\u003c/h4>\\\\n\\\\u003cp class=\\\\\\"bf-wysiwyg-top bf-wysiwyg-hide-app\\\\\\">\\\\u003cspan style=\\\\\\"font-weight: 400;\\\\\\">Además de priorizar los alimentos ricos en fibra, hay una razón por la que muchos profesionales de la salud recomiendan alimentos como las bayas, los albaricoques, los melocotones y las ciruelas.\\\\u003c/span>\\\\u003c/p>\\\\n\\\\u003cp class=\\\\\\"bf-wysiwyg-top bf-wysiwyg-hide-app\\\\\\">\\\\u003cspan style=\\\\\\"font-weight: 400;\\\\\\">Estos alimentos \\\\u003c/span>\\\\u003cstrong>contienen de forma natural\\\\u003c/strong>\\\\u003cspan style=\\\\\\"font-weight: 400;\\\\\\"> un tipo de alcohol de azúcar llamado \\\\u003c/span>\\\\u003cstrong>sorbitol\\\\u003c/strong>\\\\u003cspan style=\\\\\\"font-weight: 400;\\\\\\">. Se sabe que el sorbitol tiene un efecto laxante en el organismo.\\\\u003c/span>\\\\u003c/p>\\\\n\\\\u003cp class=\\\\\\"bf-wysiwyg-top bf-wysiwyg-hide-app\\\\\\">\\\\u003cspan style=\\\\\\"font-weight: 400;\\\\\\">El sorbitol presente de forma natural en los productos agrícolas es seguro para bebés y niños\\\\u003c/span>.\\\\u003c/p>\\\\n\\\\u003cp class=\\\\\\"bf-wysiwyg-top bf-wysiwyg-hide-app\\\\\\">\\\\u003cspan style=\\\\\\"font-weight: 400;\\\\\\">Sin embargo, \\\\u003c/span>\\\\u003cstrong>no se recomienda ofrecer sorbitol producido de manera comercial y utilizado como edulcorante artificial,\\\\u003c/strong>\\\\u003cspan style=\\\\\\"font-weight: 400;\\\\\\"> que se encuentra con frecuencia en los productos etiquetados como “sin azúcar”\\\\u003c/span>.\\\\u003c/p>\\\\n\\\\u003cp class=\\\\\\"bf-wysiwyg-top bf-wysiwyg-hide-app\\\\\\">\\\\u003cspan style=\\\\\\"font-weight: 400;\\\\\\">El problema es que suele estar presente en mayor cantidad y puede provocar problemas digestivos como hinchazón, gases o incluso diarrea\\\\u003c/span>.\\\\u003cbr>\\\\u003cspan style=\\\\\\"font-weight: 400;\\\\\\">\\\\u003cbr>\\\\u003cimg src=\\\\\\"https://buildfire.imgix.net/dcbca80b-3d23-11ea-91c9-06e43182e96c/caca_sorbitol.png?width=1440&amp;height=1440\\\\\\" alt=\\\\\\"\\\\\\" data-bf-image=\\\\\\"%7B%22resize%22%3Atrue%2C%22crop%22%3A%22%22%2C%22fixed%22%3A%22%22%2C%22responsive%22%3A%22full_width%22%2C%22originalSrc%22%3A%22https%3A//s3-us-west-2.amazonaws.com/imageserver.prod/dcbca80b-3d23-11ea-91c9-06e43182e96c/caca_sorbitol.png%22%7D\\\\\\" expr-src=\\\\\\"${buildfire.imageLib.resizeImage(\'https://s3-us-west-2.amazonaws.com/imageserver.prod/dcbca80b-3d23-11ea-91c9-06e43182e96c/caca_sorbitol.png\', { size: \'full_width\', aspect: \'1:1\' })}\\\\\\" class=\\\\\\"full_width\\\\\\">\\\\u003cbr>\\\\u003c/span>\\\\u003c/p>\\\\n\\\\u003chr class=\\\\\\"bf-wysiwyg-top bf-wysiwyg-hide-app\\\\\\">\\\\n\\\\u003ch4 class=\\\\\\"bf-wysiwyg-top bf-wysiwyg-hide-app\\\\\\">\\\\u003cstrong>Hidratación\\\\u003c/strong>\\\\u003c/h4>\\\\n\\\\u003cp class=\\\\\\"bf-wysiwyg-top bf-wysiwyg-hide-app\\\\\\">\\\\u003cimg src=\\\\\\"https://buildfire.imgix.net/dcbca80b-3d23-11ea-91c9-06e43182e96c/caca_hidratacion.png?width=1440&amp;height=1440\\\\\\" alt=\\\\\\"\\\\\\" data-bf-image=\\\\\\"%7B%22resize%22%3Atrue%2C%22crop%22%3A%22%22%2C%22fixed%22%3A%22%22%2C%22responsive%22%3A%22full_width%22%2C%22originalSrc%22%3A%22https%3A//s3-us-west-2.amazonaws.com/imageserver.prod/dcbca80b-3d23-11ea-91c9-06e43182e96c/caca_hidratacion.png%22%7D\\\\\\" expr-src=\\\\\\"${buildfire.imageLib.resizeImage(\'https://s3-us-west-2.amazonaws.com/imageserver.prod/dcbca80b-3d23-11ea-91c9-06e43182e96c/caca_hidratacion.png\', { size: \'full_width\', aspect: \'1:1\' })}\\\\\\" class=\\\\\\"full_width\\\\\\">\\\\u003c/p>\\\\n\\\\u003cp class=\\\\\\"bf-wysiwyg-top bf-wysiwyg-hide-app\\\\\\">\\\\u003cspan style=\\\\\\"font-size: 16px;\\\\\\">\\\\u003cstrong>\\\\u003cbr>\\\\u003c/strong>\\\\u003c/span>\\\\u003cstrong>Bebés menores de 6 meses:\\\\u003c/strong>\\\\u003c/p>\\\\n\\\\u003cp class=\\\\\\"bf-wysiwyg-top bf-wysiwyg-hide-app\\\\\\">\\\\u003cspan style=\\\\\\"font-weight: 400;\\\\\\">La leche materna y la leche artificial son suficientes para la hidratación.\\\\u003c/span>\\\\u003c/p>\\\\n\\\\u003cp class=\\\\\\"bf-wysiwyg-top bf-wysiwyg-hide-app\\\\\\">\\\\u003cspan style=\\\\\\"font-weight: 400;\\\\\\">Normalmente, un bebé lactante consume alrededor de 150 ml de leche de fórmula por kg de peso al día durante los primeros meses de vida, aunque puede variar entre bebés. Por ejemplo, un lactante de 4,5 kg puede consumir aproximadamente unos 675 ml diarios. No obstante, se trata de una cifra orientativa y es importante respetar las señales de hambre y saciedad del bebé. La leche de fórmula es a demanda.\\\\u003c/span>\\\\u003c/p>\\\\n\\\\u003cp class=\\\\\\"bf-wysiwyg-top bf-wysiwyg-hide-app\\\\\\">\\\\u003cspan style=\\\\\\"font-weight: 400;\\\\\\">Esto puede ser difícil de calcular con la lactancia materna, por lo que recomendamos que sea siempre a demand\\\\u003c/span>a.\\\\u003csup>4\\\\u003c/sup>\\\\u003cspan style=\\\\\\"font-weight: 400;\\\\\\">\\\\u003csup>&nbsp;\\\\u003c/sup>&nbsp;&nbsp;\\\\u003c/span>\\\\u003c/p>\\\\n\\\\u003cp class=\\\\\\"bf-wysiwyg-top bf-wysiwyg-hide-app\\\\\\">\\\\u003cspan style=\\\\\\"font-size: 16px;\\\\\\">\\\\u003cstrong>\\\\u003cbr>\\\\u003c/strong>\\\\u003c/span>\\\\u003cstrong>Bebés mayores de 6 meses:\\\\u003c/strong>\\\\u003c/p>\\\\n\\\\u003cp class=\\\\\\"bf-wysiwyg-top bf-wysiwyg-hide-app\\\\\\">\\\\u003cspan style=\\\\\\"font-weight: 400;\\\\\\">Cuando tu bebé empiece con la alimentación complementaria, ofrécele agua en un vasito abierto durante las comidas y deja que el bebé regule la cantidad que necesita.\\\\u003c/span>\\\\u003c/p>\\\\n\\\\u003cp class=\\\\\\"bf-wysiwyg-top bf-wysiwyg-hide-app\\\\\\">\\\\u003cspan style=\\\\\\"font-weight: 400;\\\\\\">La leche materna o de fórmula siguen siendo a demanda y la principal fuente de hidratación durante el primer año de vida.\\\\u003c/span>\\\\u003c/p>\\\\n\\\\u003cp class=\\\\\\"bf-wysiwyg-top bf-wysiwyg-hide-app\\\\\\">\\\\u003cspan style=\\\\\\"font-weight: 400;\\\\\\">&nbsp;Consulta la guí\\\\u003c/span>a \\\\u003cstrong>\\\\u003ca data-action-item=\\\\\\"%7B%22action%22%3A%22linkToApp%22%2C%22instanceId%22%3A%2203dd5856-99ed-4950-ad40-6d95a29ef7f2-1562922829783%22%2C%22title%22%3A%22C%F3mo%20ofrecer%20l%EDquidos%22%2C%22iconUrl%22%3A%22https%3A//s3-us-west-2.amazonaws.com/imageserver.prod/dcbca80b-3d23-11ea-91c9-06e43182e96c/liquidos-home.jpg%22%2C%22iconClassName%22%3Anull%2C%22queryString%22%3Anull%2C%22deeplinkId%22%3Anull%7D\\\\\\">\\\\\\"Cómo ofrecer líquidos\\\\\\"&nbsp;\\\\u003c/a>\\\\u003c/strong>en la app.\\\\u003c/p>\\\\n\\\\u003chr class=\\\\\\"bf-wysiwyg-top bf-wysiwyg-hide-app\\\\\\">\\\\n\\\\u003ch4 class=\\\\\\"bf-wysiwyg-top bf-wysiwyg-hide-app\\\\\\">\\\\u003cstrong>Movimiento físico\\\\u003cbr>\\\\u003c/strong>\\\\u003c/h4>\\\\n\\\\u003cp class=\\\\\\"bf-wysiwyg-top bf-wysiwyg-hide-app\\\\\\">\\\\u003cspan style=\\\\\\"font-weight: 400;\\\\\\">Si tu bebé está estreñido, el movimiento puede ayudarl\\\\u003c/span>e:\\\\u003c/p>\\\\n\\\\u003cp class=\\\\\\"bf-wysiwyg-top bf-wysiwyg-hide-app\\\\\\">• Pon al bebé boca abajo: \\\\u003cspan style=\\\\\\"font-weight: 400;\\\\\\">esto puede ayudar a ejercer una leve presión en el intestino y puede aliviar el estreñimiento. Hazlo durante 30 minutos o más al día (prueba a ponerlo boca abajo cuando esté despierto poniéndole sus juguetes preferidos\\\\u003c/span>\\\\u003cstrong> \\\\u003c/strong>\\\\u003cspan style=\\\\\\"font-weight: 400;\\\\\\">cerca).\\\\u003c/span>\\\\u003c/p>\\\\n\\\\u003cp class=\\\\\\"bf-wysiwyg-top bf-wysiwyg-hide-app\\\\\\">• Dale un masaje abdominal en la dirección de las agujas del reloj \\\\u003cspan style=\\\\\\"font-weight: 400;\\\\\\">(empezando por el cuadrante inferior derecho), le aliviará.&nbsp;\\\\u003c/span>\\\\u003c/p>\\\\n\\\\u003cp class=\\\\\\"bf-wysiwyg-top bf-wysiwyg-hide-app\\\\\\">• Hacer el movimiento de la bicicleta con sus piernas también puede ayudar a tu bebé a echar los gases, y el movimiento intestinal puede ser útil si el bebé está incómodo.&nbsp;\\\\u003c/p>\\\\n\\\\u003cp class=\\\\\\"bf-wysiwyg-top bf-wysiwyg-hide-app\\\\\\">\\\\u003ca href=\\\\\\"#top\\\\\\">\\\\u003cimg src=\\\\\\"https://buildfire.imgix.net/dcbca80b-3d23-11ea-91c9-06e43182e96c/volver-arriba-grande.png?width=1440&amp;height=1440\\\\\\" alt=\\\\\\"\\\\\\" data-bf-image=\\\\\\"%7B%22resize%22%3Atrue%2C%22crop%22%3A%22%22%2C%22fixed%22%3A%22%22%2C%22responsive%22%3A%22full_width%22%2C%22originalSrc%22%3A%22https%3A//s3-us-west-2.amazonaws.com/imageserver.prod/dcbca80b-3d23-11ea-91c9-06e43182e96c/volver-arriba-grande.png%22%7D\\\\\\" expr-src=\\\\\\"${buildfire.imageLib.resizeImage(\'https://s3-us-west-2.amazonaws.com/imageserver.prod/dcbca80b-3d23-11ea-91c9-06e43182e96c/volver-arriba-grande.png\', { size: \'full_width\', aspect: \'1:1\' })}\\\\\\" class=\\\\\\"full_width\\\\\\">\\\\u003c/a>\\\\u003c/p>\\\\n\\\\u003chr class=\\\\\\"bf-wysiwyg-top bf-wysiwyg-hide-app\\\\\\">\\\\n\\\\u003cp class=\\\\\\"bf-wysiwyg-top bf-wysiwyg-hide-app\\\\\\" id=\\\\\\"loosen\\\\\\">\\\\u003cimg src=\\\\\\"https://buildfire.imgix.net/dcbca80b-3d23-11ea-91c9-06e43182e96c/caca_laxantes.png?width=1440&amp;height=1440\\\\\\" alt=\\\\\\"\\\\\\" data-bf-image=\\\\\\"%7B%22resize%22%3Atrue%2C%22crop%22%3A%22%22%2C%22fixed%22%3A%22%22%2C%22responsive%22%3A%22full_width%22%2C%22originalSrc%22%3A%22https%3A//s3-us-west-2.amazonaws.com/imageserver.prod/dcbca80b-3d23-11ea-91c9-06e43182e96c/caca_laxantes.png%22%7D\\\\\\" expr-src=\\\\\\"${buildfire.imageLib.resizeImage(\'https://s3-us-west-2.amazonaws.com/imageserver.prod/dcbca80b-3d23-11ea-91c9-06e43182e96c/caca_laxantes.png\', { size: \'full_width\', aspect: \'1:1\' })}\\\\\\" class=\\\\\\"full_width\\\\\\">\\\\u003cimg src=\\\\\\"https://buildfire.imgix.net/dcbca80b-3d23-11ea-91c9-06e43182e96c/caca_laxantes1.png?width=1440&amp;height=1440\\\\\\" alt=\\\\\\"\\\\\\" data-bf-image=\\\\\\"%7B%22resize%22%3Atrue%2C%22crop%22%3A%22%22%2C%22fixed%22%3A%22%22%2C%22responsive%22%3A%22full_width%22%2C%22originalSrc%22%3A%22https%3A//s3-us-west-2.amazonaws.com/imageserver.prod/dcbca80b-3d23-11ea-91c9-06e43182e96c/caca_laxantes1.png%22%7D\\\\\\" expr-src=\\\\\\"${buildfire.imageLib.resizeImage(\'https://s3-us-west-2.amazonaws.com/imageserver.prod/dcbca80b-3d23-11ea-91c9-06e43182e96c/caca_laxantes1.png\', { size: \'full_width\', aspect: \'1:1\' })}\\\\\\" class=\\\\\\"full_width\\\\\\">\\\\u003cimg src=\\\\\\"https://buildfire.imgix.net/dcbca80b-3d23-11ea-91c9-06e43182e96c/caca_laxantes2.png?width=1440&amp;height=1440\\\\\\" alt=\\\\\\"\\\\\\" data-bf-image=\\\\\\"%7B%22resize%22%3Atrue%2C%22crop%22%3A%22%22%2C%22fixed%22%3A%22%22%2C%22responsive%22%3A%22full_width%22%2C%22originalSrc%22%3A%22https%3A//s3-us-west-2.amazonaws.com/imageserver.prod/dcbca80b-3d23-11ea-91c9-06e43182e96c/caca_laxantes2.png%22%7D\\\\\\" expr-src=\\\\\\"${buildfire.imageLib.resizeImage(\'https://s3-us-west-2.amazonaws.com/imageserver.prod/dcbca80b-3d23-11ea-91c9-06e43182e96c/caca_laxantes2.png\', { size: \'full_width\', aspect: \'1:1\' })}\\\\\\" class=\\\\\\"full_width\\\\\\">\\\\u003c/p>\\\\n\\\\u003cp class=\\\\\\"bf-wysiwyg-top bf-wysiwyg-hide-app\\\\\\">\\\\u003cspan style=\\\\\\"font-weight: 400;\\\\\\">Usa los filtros en la\\\\u003c/span> sección de \\\\u003cstrong>\\\\u003ca data-action-item=\\\\\\"%7B%22action%22%3A%22linkToApp%22%2C%22instanceId%22%3A%22b99b546b-5fd7-4b34-a79f-568d3105957d-1620399589282%22%2C%22title%22%3A%22Alimentos%3A%20C%F3mo%20ofrecer%22%2C%22iconUrl%22%3A%22https%3A//s3-us-west-2.amazonaws.com/imageserver.prod/dcbca80b-3d23-11ea-91c9-06e43182e96c/lupa.jpg%22%2C%22iconClassName%22%3Anull%2C%22queryString%22%3Anull%2C%22deeplinkId%22%3Anull%7D\\\\\\">Alimentos\\\\u003c/a>\\\\u003ca data-action-item=\\\\\\"%7B%22action%22%3A%22linkToApp%22%2C%22instanceId%22%3A%22b99b546b-5fd7-4b34-a79f-568d3105957d-1620823932168%22%2C%22title%22%3A%22Foods%3A%20How%20to%20offer%22%2C%22iconUrl%22%3A%22https%3A//s3-us-west-2.amazonaws.com/imageserver.prod/51951dd8-1771-11eb-91c9-06e43182e96c/menu9.jpg%22%2C%22iconClassName%22%3Anull%2C%22queryString%22%3Anull%2C%22deeplinkId%22%3Anull%7D\\\\\\"> \\\\u003c/a>\\\\u003c/strong>\\\\u003cspan style=\\\\\\"font-weight: 400;\\\\\\">para encontrar más alimentos laxantes\\\\u003c/span>.\\\\u003c/p>\\\\n\\\\u003cp class=\\\\\\"bf-wysiwyg-top bf-wysiwyg-hide-app\\\\\\">\\\\u003cimg width=\\\\\\"600\\\\\\" src=\\\\\\"https://buildfire.imgix.net/dcbca80b-3d23-11ea-91c9-06e43182e96c/laxante.gif?width=600&amp;height=600\\\\\\" alt=\\\\\\"\\\\\\" expr-src=\\\\\\"${buildfire.imageLib.resizeImage(\'https://s3-us-west-2.amazonaws.com/imageserver.prod/dcbca80b-3d23-11ea-91c9-06e43182e96c/laxante.gif\', { size: \'xxl\', aspect: \'1:1\' })}\\\\\\" class=\\\\\\"\\\\\\" data-bf-image=\\\\\\"%7B%22resize%22%3Atrue%2C%22crop%22%3A%22%22%2C%22fixed%22%3A%22xxl%22%2C%22responsive%22%3A%22%22%2C%22originalSrc%22%3A%22https%3A//s3-us-west-2.amazonaws.com/imageserver.prod/dcbca80b-3d23-11ea-91c9-06e43182e96c/laxante.gif%22%7D\\\\\\">\\\\u003c/p>\\\\n\\\\u003ch4 class=\\\\\\"bf-wysiwyg-top bf-wysiwyg-hide-app\\\\\\">\\\\u003cstrong>\\\\u003cbr>Alimentos cuyo consumo se puede restringir:\\\\u003c/strong>\\\\u003c/h4>\\\\n\\\\u003cp class=\\\\\\"bf-wysiwyg-top bf-wysiwyg-hide-app\\\\\\">• \\\\u003cspan style=\\\\\\"font-weight: 400;\\\\\\">Lácteos, incluidos el yogur y el queso:\\\\u003c/span>\\\\u003c/p>\\\\n\\\\u003cul class=\\\\\\"bf-wysiwyg-top bf-wysiwyg-hide-app\\\\\\" style=\\\\\\"list-style-type: circle;\\\\\\">\\\\n\\\\u003cli class=\\\\\\"\\\\\\">\\\\u003cspan style=\\\\\\"font-weight: 400;\\\\\\">si tu bebé tiene más de 1 año, limita la leche entera a un máximo de \\\\u003c/span>\\\\u003cspan style=\\\\\\"font-weight: 400;\\\\\\">500 \\\\u003c/span>\\\\u003cspan style=\\\\\\"font-weight: 400;\\\\\\">ml al día;\\\\u003c/span>\\\\u003c/li>\\\\n\\\\u003cli class=\\\\\\"\\\\\\">\\\\u003cspan style=\\\\\\"font-weight: 400;\\\\\\">en general, es conveniente limitar la ingesta de lácteos a 2-3 raciones al día a partir del año.\\\\u003c/span>\\\\u003csup>4\\\\u003c/sup>\\\\u003c/li>\\\\n\\\\u003c/ul>\\\\n\\\\u003cp class=\\\\\\"bf-wysiwyg-top bf-wysiwyg-hide-app\\\\\\">• \\\\u003cspan style=\\\\\\"font-weight: 400;\\\\\\">Cereales refinados como el pan blanco o el arroz.\\\\u003c/span>\\\\u003c/p>\\\\n\\\\u003cp class=\\\\\\"bf-wysiwyg-top bf-wysiwyg-hide-app\\\\\\">\\\\u003cspan style=\\\\\\"font-weight: 400;\\\\\\">• Plátano verde.* \\\\u003cbr>\\\\u003c/span>\\\\u003c/p>\\\\n\\\\u003cp class=\\\\\\"bf-wysiwyg-top bf-wysiwyg-hide-app\\\\\\">\\\\u003cspan style=\\\\\\"font-size: 12px;\\\\\\">\\\\u003cem>*\\\\u003cspan style=\\\\\\"font-weight: 400;\\\\\\">Nota: La recomendación de restringir ciertos alimentos se hace con una finalidad divulgativa. Recomendamos consultar con tu pediatra antes de restringir alimentos o grupos de alimentos para garantizar que tu bebé está cubriendo sus necesidades nutricionales para un correcto crecimiento\\\\u003c/span>.\\\\u003c/em> \\\\u003csup>7-9\\\\u003c/sup>&nbsp;\\\\u003c/span>\\\\u003c/p>\\\\n\\\\u003cp class=\\\\\\"bf-wysiwyg-top bf-wysiwyg-hide-app\\\\\\">\\\\u003ca href=\\\\\\"#top\\\\\\">\\\\u003cimg src=\\\\\\"https://buildfire.imgix.net/dcbca80b-3d23-11ea-91c9-06e43182e96c/volver-arriba-grande.png?width=1440&amp;height=1440\\\\\\" alt=\\\\\\"\\\\\\" data-bf-image=\\\\\\"%7B%22resize%22%3Atrue%2C%22crop%22%3A%22%22%2C%22fixed%22%3A%22%22%2C%22responsive%22%3A%22full_width%22%2C%22originalSrc%22%3A%22https%3A//s3-us-west-2.amazonaws.com/imageserver.prod/dcbca80b-3d23-11ea-91c9-06e43182e96c/volver-arriba-grande.png%22%7D\\\\\\" expr-src=\\\\\\"${buildfire.imageLib.resizeImage(\'https://s3-us-west-2.amazonaws.com/imageserver.prod/dcbca80b-3d23-11ea-91c9-06e43182e96c/volver-arriba-grande.png\', { size: \'full_width\', aspect: \'1:1\' })}\\\\\\" class=\\\\\\"full_width\\\\\\">\\\\u003c/a>\\\\u003c/p>\\\\n\\\\u003chr class=\\\\\\"bf-wysiwyg-top bf-wysiwyg-hide-app\\\\\\">\\\\n\\\\u003ch4 id=\\\\\\"plan\\\\\\" class=\\\\\\"bf-wysiwyg-top bf-wysiwyg-hide-app\\\\\\">\\\\u003cstrong>\\\\u003cspan id=\\\\\\"transitioning\\\\\\">Cómo evitar el estreñimiento al inicio de la alimentación complementaria\\\\u003c/span>\\\\u003c/strong>\\\\u003c/h4>\\\\n\\\\u003cp class=\\\\\\"bf-wysiwyg-top bf-wysiwyg-hide-app\\\\\\">Si has empezado con la alimentación complementaria y tu bebé hace menos caca o notas que le cuesta, hay algunos trucos que puedes poner en práctica:&nbsp;\\\\u003c/p>\\\\n\\\\u003cp class=\\\\\\"bf-wysiwyg-top bf-wysiwyg-hide-app\\\\\\">\\\\u003cstrong>1. Más actividad física\\\\u003cbr>\\\\u003c/strong>\\\\u003c/p>\\\\n\\\\u003cp class=\\\\\\"bf-wysiwyg-top bf-wysiwyg-hide-app\\\\\\">\\\\u003cspan style=\\\\\\"font-weight: 400;\\\\\\">Mueve su cuerpecito durante 10-15 minutos dos veces al día. Puedes hacerle un masaje abdominal o movimientos de bicicleta con las piernas. Ponlo boca abajo tan a menudo como puedas\\\\u003c/span>.\\\\u003c/p>\\\\n\\\\u003cp class=\\\\\\"bf-wysiwyg-top bf-wysiwyg-hide-app\\\\\\">\\\\u003cstrong>2. Más hidratación\\\\u003c/strong>\\\\u003c/p>\\\\n\\\\u003cp class=\\\\\\"bf-wysiwyg-top bf-wysiwyg-hide-app\\\\\\">Ofrécele agua en un vasito abierto en cada comida.\\\\u003c/p>\\\\n\\\\u003cp class=\\\\\\"bf-wysiwyg-top bf-wysiwyg-hide-app\\\\\\">\\\\u003cstrong>3. Más fibra\\\\u003c/strong>\\\\u003c/p>\\\\n\\\\u003cp class=\\\\\\"bf-wysiwyg-top bf-wysiwyg-hide-app\\\\\\">\\\\u003cspan style=\\\\\\"font-weight: 400;\\\\\\">Recomendamos aumentar la ingesta de fibra de forma \\\\u003c/span>\\\\u003cstrong>gradual, añadiendo un alimento rico en fibra cada pocos días\\\\u003c/strong>\\\\u003cspan style=\\\\\\"font-weight: 400;\\\\\\"> hasta llegar a 5 gramos de fibra al día o hasta que se normalice el patrón de heces.&nbsp;\\\\u003c/span>\\\\u003c/p>\\\\n\\\\u003cp class=\\\\\\"bf-wysiwyg-top bf-wysiwyg-hide-app\\\\\\">\\\\u003cspan style=\\\\\\"font-weight: 400;\\\\\\">Empieza con 1-2 cucharaditas de alimentos ricos en fibra y sírvele más si se lo termina para evitar el desperdicio de comida\\\\u003c/span>.&nbsp;\\\\u003c/p>\\\\n\\\\u003cp class=\\\\\\"bf-wysiwyg-top bf-wysiwyg-hide-app\\\\\\">\\\\u003cimg src=\\\\\\"https://buildfire.imgix.net/dcbca80b-3d23-11ea-91c9-06e43182e96c/caca_guiafibra.png?width=1440&amp;height=1440\\\\\\" alt=\\\\\\"\\\\\\" data-bf-image=\\\\\\"%7B%22resize%22%3Atrue%2C%22crop%22%3A%22%22%2C%22fixed%22%3A%22%22%2C%22responsive%22%3A%22full_width%22%2C%22originalSrc%22%3A%22https%3A//s3-us-west-2.amazonaws.com/imageserver.prod/dcbca80b-3d23-11ea-91c9-06e43182e96c/caca_guiafibra.png%22%7D\\\\\\" expr-src=\\\\\\"${buildfire.imageLib.resizeImage(\'https://s3-us-west-2.amazonaws.com/imageserver.prod/dcbca80b-3d23-11ea-91c9-06e43182e96c/caca_guiafibra.png\', { size: \'full_width\', aspect: \'1:1\' })}\\\\\\" class=\\\\\\"full_width\\\\\\">\\\\u003c/p>\\\\n\\\\u003cp class=\\\\\\"bf-wysiwyg-top bf-wysiwyg-hide-app\\\\\\">\\\\u003cspan style=\\\\\\"font-weight: 400; font-size: 12px;\\\\\\">\\\\u003cem>*Nota: No es realista que un niño pueda ingerir todas estas raciones de una vez. No se trata de un requisito diario que haya que contabilizar ni que deba añadir estrés a las comidas. El objetivo es un incremento gradual. \\\\u003c/em>\\\\u003c/span>\\\\u003c/p>\\\\n\\\\u003cp class=\\\\\\"bf-wysiwyg-top bf-wysiwyg-hide-app\\\\\\">\\\\u003cspan style=\\\\\\"font-weight: 400;\\\\\\">Si el estreñimiento de tu bebé persiste, ponte en contacto con tu pediatra\\\\u003c/span>.\\\\u003c/p>\\\\n\\\\u003cp class=\\\\\\"bf-wysiwyg-top bf-wysiwyg-hide-app\\\\\\">\\\\u003ca href=\\\\\\"#top\\\\\\">\\\\u003cimg src=\\\\\\"https://buildfire.imgix.net/dcbca80b-3d23-11ea-91c9-06e43182e96c/volver-arriba-grande.png?width=1440&amp;height=1440\\\\\\" alt=\\\\\\"\\\\\\" data-bf-image=\\\\\\"%7B%22resize%22%3Atrue%2C%22crop%22%3A%22%22%2C%22fixed%22%3A%22%22%2C%22responsive%22%3A%22full_width%22%2C%22originalSrc%22%3A%22https%3A//s3-us-west-2.amazonaws.com/imageserver.prod/dcbca80b-3d23-11ea-91c9-06e43182e96c/volver-arriba-grande.png%22%7D\\\\\\" expr-src=\\\\\\"${buildfire.imageLib.resizeImage(\'https://s3-us-west-2.amazonaws.com/imageserver.prod/dcbca80b-3d23-11ea-91c9-06e43182e96c/volver-arriba-grande.png\', { size: \'full_width\', aspect: \'1:1\' })}\\\\\\" class=\\\\\\"full_width\\\\\\">\\\\u003c/a>\\\\u003c/p>\\\\n\\\\u003chr class=\\\\\\"bf-wysiwyg-top bf-wysiwyg-hide-app\\\\\\">\\\\n\\\\u003cp class=\\\\\\"bf-wysiwyg-top bf-wysiwyg-hide-app\\\\\\" id=\\\\\\"diarrhea\\\\\\">\\\\u003cimg src=\\\\\\"https://buildfire.imgix.net/dcbca80b-3d23-11ea-91c9-06e43182e96c/caca_titulos.png?width=1440&amp;height=1440\\\\\\" alt=\\\\\\"\\\\\\" data-bf-image=\\\\\\"%7B%22resize%22%3Atrue%2C%22crop%22%3A%22%22%2C%22fixed%22%3A%22%22%2C%22responsive%22%3A%22full_width%22%2C%22originalSrc%22%3A%22https%3A//s3-us-west-2.amazonaws.com/imageserver.prod/dcbca80b-3d23-11ea-91c9-06e43182e96c/caca_titulos.png%22%7D\\\\\\" expr-src=\\\\\\"${buildfire.imageLib.resizeImage(\'https://s3-us-west-2.amazonaws.com/imageserver.prod/dcbca80b-3d23-11ea-91c9-06e43182e96c/caca_titulos.png\', { size: \'full_width\', aspect: \'1:1\' })}\\\\\\" class=\\\\\\"full_width\\\\\\">\\\\u003c/p>\\\\n\\\\u003cp class=\\\\\\"bf-wysiwyg-top bf-wysiwyg-hide-app\\\\\\">\\\\u003cspan style=\\\\\\"font-weight: 400;\\\\\\">La diarrea se produce cuando el bebé hace deposiciones muy frecuentes y líquidas. Suele ser repentina y puede ser una afección habitual en bebés y niños. \\\\u003c/span>\\\\u003cstrong>Si tu bebé hace 3 o más deposiciones muy líquidas o sueltas, se considera diarrea\\\\u003c/strong>\\\\u003csup>15\\\\u003c/sup>.\\\\u003cspan style=\\\\\\"font-weight: 400;\\\\\\"> La diarrea puede ser temporal (aguda) o recurrente.&nbsp;\\\\u003c/span>\\\\u003c/p>\\\\n\\\\u003cp class=\\\\\\"bf-wysiwyg-top bf-wysiwyg-hide-app\\\\\\">\\\\u003cstrong>Posibles causas de diarrea aguda: \\\\u003c/strong>\\\\u003cspan style=\\\\\\"font-weight: 400;\\\\\\">\\\\u003cbr>\\\\u003c/span>\\\\u003cspan style=\\\\\\"font-weight: 400;\\\\\\">Una enfermedad vírica, una infección bacteriana (intoxicación alimentaria), efectos secundarios de una medicación concreta o del uso prolongado de antibióticos.\\\\u003c/span>\\\\u003c/p>\\\\n\\\\u003cp class=\\\\\\"bf-wysiwyg-top bf-wysiwyg-hide-app\\\\\\">\\\\u003cstrong>Posibles causas de diarrea recurrente:\\\\u003c/strong>\\\\u003cspan style=\\\\\\"font-weight: 400;\\\\\\">\\\\u003cbr>\\\\u003c/span>\\\\u003cspan style=\\\\\\"font-weight: 400;\\\\\\">Alergia a la proteína de la leche de vaca (APLV), sobre todo si las deposiciones tienen un color verdoso o presentan trazas de sangre, diarrea en niños mayores y enfermedades como la celiaquía, etc.&nbsp;\\\\u003c/span>\\\\u003c/p>\\\\n\\\\u003cp class=\\\\\\"bf-wysiwyg-top bf-wysiwyg-hide-app\\\\\\">\\\\u003cspan style=\\\\\\"font-weight: 400;\\\\\\">Como los patrones y la consistencia de las heces pueden variar de un bebé a otro, la diarrea se suele categorizar en la siguiente escala para determinar su gravedad o si es necesaria asistencia médica\\\\u003c/span>:&nbsp;\\\\u003c/p>\\\\n\\\\u003cp class=\\\\\\"bf-wysiwyg-top bf-wysiwyg-hide-app\\\\\\">• \\\\u003cstrong>Leve:\\\\u003c/strong> 3-5 deposiciones líquidas al día\\\\u003c/p>\\\\n\\\\u003cp class=\\\\\\"bf-wysiwyg-top bf-wysiwyg-hide-app\\\\\\">• \\\\u003cstrong>Moderada:\\\\u003c/strong> 6-9 deposiciones líquidas al día\\\\u003c/p>\\\\n\\\\u003cp class=\\\\\\"bf-wysiwyg-top bf-wysiwyg-hide-app\\\\\\">• \\\\u003cstrong>Severa:\\\\u003c/strong> 10 o más deposiciones líquidas al día\\\\u003cspan style=\\\\\\"font-weight: 400;\\\\\\">\\\\u003cbr>\\\\u003c/span>&nbsp;\\\\u003c/p>\\\\n\\\\u003chr class=\\\\\\"bf-wysiwyg-top bf-wysiwyg-hide-app\\\\\\">\\\\n\\\\u003ch5 class=\\\\\\"bf-wysiwyg-top bf-wysiwyg-hide-app\\\\\\">\\\\u003cstrong>Recomendaciones para la diarrea leve:\\\\u003c/strong>\\\\u003c/h5>\\\\n\\\\u003cp class=\\\\\\"bf-wysiwyg-top bf-wysiwyg-hide-app\\\\\\">\\\\u003cspan style=\\\\\\"font-weight: 400;\\\\\\">Antiguamente se recomendaba hacer dieta blanda para tratar la diarrea. Sin embargo, se trata de una recomendación obsoleta y está demostrado que los bebés que ya han empezado la AC pueden seguir una dieta normal si tienen diarrea\\\\u003c/span>.&nbsp;\\\\u003c/p>\\\\n\\\\u003cp class=\\\\\\"bf-wysiwyg-top bf-wysiwyg-hide-app\\\\\\">\\\\u003cstrong>Qué hacer:&nbsp;\\\\u003c/strong>\\\\u003c/p>\\\\n\\\\u003cp class=\\\\\\"bf-wysiwyg-top bf-wysiwyg-hide-app\\\\\\">• \\\\u003cspan style=\\\\\\"font-weight: 400;\\\\\\">Reanudar una dieta normal en cuanto sea posible. Sírvele menos cantidad de comida y con más frecuencia. \\\\u003cstrong>Ofrece lo que le apetezca y tolere bien, sin hacer dieta astringente\\\\u003c/strong>\\\\u003c/span>.\\\\u003c/p>\\\\n\\\\u003cp class=\\\\\\"bf-wysiwyg-top bf-wysiwyg-hide-app\\\\\\">• \\\\u003cspan style=\\\\\\"font-weight: 400;\\\\\\">Beber más líquidos para evitar la deshidratación. En bebés de 6 a 12 meses, lo mejor es seguir con la lactancia materna o artificial a demanda. En algunos casos, el pediatra podrá recomendar un suero de rehidratación oral\\\\u003c/span>.&nbsp;\\\\u003c/p>\\\\n\\\\u003cp class=\\\\\\"bf-wysiwyg-top bf-wysiwyg-hide-app\\\\\\">• \\\\u003cspan style=\\\\\\"font-weight: 400;\\\\\\">Priorizar los alimentos ricos en almidón (cereales, arroz, pasta), ya que son más fáciles de digeri\\\\u003c/span>r.&nbsp;\\\\u003c/p>\\\\n\\\\u003cp class=\\\\\\"bf-wysiwyg-top bf-wysiwyg-hide-app\\\\\\">• \\\\u003cspan style=\\\\\\"font-weight: 400;\\\\\\">Después de cambiarle el pañal al bebé, asegúrate de que el culete quede limpio, y déjalo secar al aire en la medida de lo posible para evitar erupciones (¡incluso puedes secarle con el secador en modo frío\u0021), y usa linimento y crema de pañal (muchos pediatras recomiendan cremas con óxido de zinc) para evitar la irritación. Lávate muy bien las manos después de cambiarle\\\\u003c/span>.&nbsp;\\\\u003c/p>\\\\n\\\\u003cp class=\\\\\\"bf-wysiwyg-top bf-wysiwyg-hide-app\\\\\\">• \\\\u003cspan style=\\\\\\"font-weight: 400;\\\\\\">Puedes ofrecer lácteos de leche de vaca a partir del año si el peque los quiere tomar y le sientan bien\\\\u003c/span>. El yogur o el kéfir pueden ayudar con la regeneración de la flora.\\\\u003c/p>\\\\n\\\\u003cp class=\\\\\\"bf-wysiwyg-top bf-wysiwyg-hide-app\\\\\\">\\\\u003cspan style=\\\\\\"font-size: 12px;\\\\\\">\\\\u003cem>\\\\u003cspan style=\\\\\\"font-weight: 400;\\\\\\">*Nota: Algunas personas pueden mostrar una intolerancia temporal a la lactosa durante los episodios de diarrea. Cuando vayas a introducir la leche de vaca, lo mejor es empezar con cantidades muy pequeñas. Los alimentos con menos lactosa, como el yogur y el queso, pueden tolerarse mejor\\\\u003c/span>\\\\u003c/em>.\\\\u003csup>10-15\\\\u003c/sup>\\\\u003c/span>\\\\u003c/p>\\\\n\\\\u003cp class=\\\\\\"bf-wysiwyg-top bf-wysiwyg-hide-app\\\\\\">\\\\u003cstrong>Uno de los principales riesgos de la diarrea es la \\\\u003cspan style=\\\\\\"text-decoration: underline;\\\\\\">deshidratación\\\\u003c/span>.&nbsp;\\\\u003c/strong>\\\\u003c/p>\\\\n\\\\u003cp class=\\\\\\"bf-wysiwyg-top bf-wysiwyg-hide-app\\\\\\">\\\\u003cspan style=\\\\\\"font-weight: 400;\\\\\\">Puedes saber si tu bebé está deshidratado si presenta uno o más de estos síntomas\\\\u003c/span>:\\\\u003c/p>\\\\n\\\\u003cp class=\\\\\\"bf-wysiwyg-top bf-wysiwyg-hide-app\\\\\\">• \\\\u003cspan style=\\\\\\"font-weight: 400;\\\\\\">\\\\u003c/span>\\\\u003cspan style=\\\\\\"font-weight: 400;\\\\\\">No moja suficientes pañales (no se lo tienes que cambiar en más de 6-8 horas\\\\u003c/span>).\\\\u003c/p>\\\\n\\\\u003cp class=\\\\\\"bf-wysiwyg-top bf-wysiwyg-hide-app\\\\\\">\\\\u003cspan style=\\\\\\"font-weight: 400;\\\\\\">• La orina presenta un color amarillo oscuro y aspecto concentrado\\\\u003c/span>.\\\\u003c/p>\\\\n\\\\u003cp class=\\\\\\"bf-wysiwyg-top bf-wysiwyg-hide-app\\\\\\">\\\\u003cspan style=\\\\\\"font-weight: 400;\\\\\\">• Está muy somnoliento e irritable.\\\\u003c/span>\\\\u003c/p>\\\\n\\\\u003cp class=\\\\\\"bf-wysiwyg-top bf-wysiwyg-hide-app\\\\\\">\\\\u003cspan style=\\\\\\"font-weight: 400;\\\\\\">• Tiene la fontanela muy hundida.\\\\u003c/span>\\\\u003csup>\\\\u003cspan style=\\\\\\"font-weight: 400;\\\\\\">4\\\\u003c/span>\\\\u003c/sup>\\\\u003c/p>\\\\n\\\\u003cp class=\\\\\\"bf-wysiwyg-top bf-wysiwyg-hide-app\\\\\\">\\\\u003cstrong>Qué \\\\u003cspan style=\\\\\\"text-decoration: underline;\\\\\\">no\\\\u003c/span> hacer:\\\\u003c/strong>\\\\u003c/p>\\\\n\\\\u003cp class=\\\\\\"bf-wysiwyg-top bf-wysiwyg-hide-app\\\\\\">• \\\\u003cspan style=\\\\\\"font-weight: 400;\\\\\\">No se recomienda ofrecer zumos de frutas ni bebidas isotónicas, ya que pueden agravar la diarrea por su alto contenido en azúca\\\\u003c/span>r. &nbsp;\\\\u003c/p>\\\\n\\\\u003chr class=\\\\\\"bf-wysiwyg-top bf-wysiwyg-hide-app\\\\\\">\\\\n\\\\u003cp class=\\\\\\"bf-wysiwyg-top bf-wysiwyg-hide-app\\\\\\">\\\\u003cstrong>En caso de diarrea moderada o severa:\\\\u003cbr>\\\\u003c/strong>\\\\u003cstrong>\\\\u003cspan style=\\\\\\"text-decoration: underline;\\\\\\">Ponte en contacto con tu pediatra\\\\u003c/span> si:\\\\u003c/strong>\\\\u003c/p>\\\\n\\\\u003cp class=\\\\\\"bf-wysiwyg-top bf-wysiwyg-hide-app\\\\\\">\\\\u003cstrong>Los síntomas graves derivan en\\\\u003c/strong>\\\\u003cstrong>:&nbsp;\\\\u003c/strong>\\\\u003c/p>\\\\n\\\\u003cp class=\\\\\\"bf-wysiwyg-top bf-wysiwyg-hide-app\\\\\\">• \\\\u003cspan style=\\\\\\"font-weight: 400;\\\\\\">Fiebre con curso de más de 2-3 días (en un bebé de menos de 2 meses, con más de 38 ºC hay que ir a Urgencias).\\\\u003c/span>\\\\u003c/p>\\\\n\\\\u003cp class=\\\\\\"bf-wysiwyg-top bf-wysiwyg-hide-app\\\\\\">• \\\\u003cspan style=\\\\\\"font-weight: 400;\\\\\\">Ausencia de micción en 6-8 horas.\\\\u003c/span>\\\\u003c/p>\\\\n\\\\u003cp class=\\\\\\"bf-wysiwyg-top bf-wysiwyg-hide-app\\\\\\">• \\\\u003cspan style=\\\\\\"font-weight: 400;\\\\\\">Signos de deshidratación: fontanela hundida, ausencia de lágrimas al llorar, labios muy secos y agrietados…\\\\u003c/span>\\\\u003c/p>\\\\n\\\\u003cp class=\\\\\\"bf-wysiwyg-top bf-wysiwyg-hide-app\\\\\\">• \\\\u003cspan style=\\\\\\"font-weight: 400;\\\\\\">Vientre muy blando al tacto.\\\\u003c/span>\\\\u003c/p>\\\\n\\\\u003cp class=\\\\\\"bf-wysiwyg-top bf-wysiwyg-hide-app\\\\\\">• \\\\u003cspan style=\\\\\\"font-weight: 400;\\\\\\">Somnolencia o palidez y falta de reacción.\\\\u003c/span>\\\\u003c/p>\\\\n\\\\u003cp class=\\\\\\"bf-wysiwyg-top bf-wysiwyg-hide-app\\\\\\">• Sangre en heces.\\\\u003c/p>\\\\n\\\\u003cp class=\\\\\\"bf-wysiwyg-top bf-wysiwyg-hide-app\\\\\\">• \\\\u003cspan style=\\\\\\"font-weight: 400;\\\\\\">Episodios de dolor agudo y posterior somnolencia (pueden ser síntomas de una enfermedad llamada intususcepción\\\\u003c/span>).\\\\u003c/p>\\\\n\\\\u003cp class=\\\\\\"bf-wysiwyg-top bf-wysiwyg-hide-app\\\\\\">\\\\u003cstrong>Los síntomas crónicos derivan en:\\\\u003c/strong>\\\\u003c/p>\\\\n\\\\u003cp class=\\\\\\"bf-wysiwyg-top bf-wysiwyg-hide-app\\\\\\">• \\\\u003cspan style=\\\\\\"font-weight: 400;\\\\\\">Dolor de tripa intermitente que dura días o semanas.\\\\u003c/span>\\\\u003c/p>\\\\n\\\\u003cp class=\\\\\\"bf-wysiwyg-top bf-wysiwyg-hide-app\\\\\\">• Sangre en heces.\\\\u003c/p>\\\\n\\\\u003cp class=\\\\\\"bf-wysiwyg-top bf-wysiwyg-hide-app\\\\\\">• Pérdida de peso.\\\\u003c/p>\\\\n\\\\u003cp class=\\\\\\"bf-wysiwyg-top bf-wysiwyg-hide-app\\\\\\">\\\\u003cstrong>Acude a Urgencias cuanto antes si el bebé:\\\\u003c/strong>\\\\u003c/p>\\\\n\\\\u003cp class=\\\\\\"bf-wysiwyg-top bf-wysiwyg-hide-app\\\\\\">• \\\\u003cspan style=\\\\\\"font-weight: 400;\\\\\\">No se mueve, no responde a los estímulos o no se despierta.\\\\u003c/span>\\\\u003c/p>\\\\n\\\\u003cp class=\\\\\\"bf-wysiwyg-top bf-wysiwyg-hide-app\\\\\\">• \\\\u003cspan style=\\\\\\"font-weight: 400;\\\\\\">Está muy débil o mareado.\\\\u003c/span>\\\\u003c/p>\\\\n\\\\u003cp class=\\\\\\"bf-wysiwyg-top bf-wysiwyg-hide-app\\\\\\">• \\\\u003cspan style=\\\\\\"font-weight: 400;\\\\\\">Crees que está en riesgo.\\\\u003c/span> &nbsp;\\\\u003c/p>\\\\n\\\\u003chr class=\\\\\\"bf-wysiwyg-top bf-wysiwyg-hide-app\\\\\\">\\\\n\\\\u003cp class=\\\\\\"bf-wysiwyg-top bf-wysiwyg-hide-app\\\\\\" id=\\\\\\"bind\\\\\\">\\\\u003cimg src=\\\\\\"https://buildfire.imgix.net/dcbca80b-3d23-11ea-91c9-06e43182e96c/alimentos-astringentes1.png?width=1440&amp;height=1440\\\\\\" alt=\\\\\\"\\\\\\" expr-src=\\\\\\"${buildfire.imageLib.resizeImage(\'https://s3-us-west-2.amazonaws.com/imageserver.prod/dcbca80b-3d23-11ea-91c9-06e43182e96c/alimentos-astringentes1.png\', { size: \'full_width\', aspect: \'1:1\' })}\\\\\\" class=\\\\\\"full_width\\\\\\" data-bf-image=\\\\\\"%7B%22resize%22%3Atrue%2C%22crop%22%3A%22%22%2C%22fixed%22%3A%22%22%2C%22responsive%22%3A%22full_width%22%2C%22originalSrc%22%3A%22https%3A//s3-us-west-2.amazonaws.com/imageserver.prod/dcbca80b-3d23-11ea-91c9-06e43182e96c/alimentos-astringentes1.png%22%7D\\\\\\">&nbsp;\\\\u003c/p>\\\\n\\\\u003cp class=\\\\\\"bf-wysiwyg-top bf-wysiwyg-hide-app\\\\\\">\\\\u003cspan style=\\\\\\"font-weight: 400;\\\\\\">Aunque, como ya hemos mencionado, \\\\u003cstrong>no es necesario hacer una dieta astringente en caso de diarrea\\\\u003c/strong>, si te interesa saber qué alimentos son astringentes, puedes usar los filtros en la sección de \\\\u003ca data-action-item=\\\\\\"%7B%22action%22%3A%22linkToApp%22%2C%22instanceId%22%3A%22b99b546b-5fd7-4b34-a79f-568d3105957d-1620399589282%22%2C%22title%22%3A%22Alimentos%3A%20C%F3mo%20ofrecer%22%2C%22iconUrl%22%3A%22https%3A//s3-us-west-2.amazonaws.com/imageserver.prod/dcbca80b-3d23-11ea-91c9-06e43182e96c/lupa.jpg%22%2C%22iconClassName%22%3Anull%2C%22queryString%22%3Anull%2C%22deeplinkId%22%3Anull%7D\\\\\\">\\\\u003cstrong>Alimentos\\\\u003c/strong>\\\\u003c/a>.\\\\u003c/span>\\\\u003c/p>\\\\n\\\\u003cp class=\\\\\\"bf-wysiwyg-top bf-wysiwyg-hide-app\\\\\\">&nbsp;\\\\u003cimg width=\\\\\\"600\\\\\\" src=\\\\\\"https://buildfire.imgix.net/dcbca80b-3d23-11ea-91c9-06e43182e96c/astringente.gif?width=600&amp;height=600\\\\\\" alt=\\\\\\"\\\\\\" expr-src=\\\\\\"${buildfire.imageLib.resizeImage(\'https://s3-us-west-2.amazonaws.com/imageserver.prod/dcbca80b-3d23-11ea-91c