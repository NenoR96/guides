none;\\r\\n      cursor: pointer;\\r\\n      display: flex;\\r\\n      align-items: center;\\r\\n      justify-content: center;\\r\\n      flex-shrink: 0;\\r\\n    }\\r\\n\\r\\n    .reader-nav-title {\\r\\n      min-width: 0;\\r\\n      font-size: 15px;\\r\\n      font-weight: 600;\\r\\n      color: #1a1a1a;\\r\\n      flex: 1;\\r\\n      white-space: nowrap;\\r\\n      overflow: hidden;\\r\\n      text-overflow: ellipsis;\\r\\n    }\\r\\n\\r\\n    .reader-content {\\r\\n      padding: 24px 20px 300px;\\r\\n      overflow-wrap: anywhere;\\r\\n    }\\r\\n\\r\\n    .tldr-box {\\r\\n      background: #fff8ee;\\r\\n      border: 2px solid #f4a540;\\r\\n      border-radius: 18px;\\r\\n      padding: 18px;\\r\\n      margin-bottom: 28px;\\r\\n    }\\r\\n\\r\\n    .tldr-header {\\r\\n      display: flex;\\r\\n      align-items: center;\\r\\n      gap: 8px;\\r\\n      font-size: 12px;\\r\\n      font-weight: 800;\\r\\n      color: #c47e0e;\\r\\n      text-transform: uppercase;\\r\\n      letter-spacing: 0.5px;\\r\\n      margin-bottom: 10px;\\r\\n    }\\r\\n\\r\\n    .tldr-box ul {\\r\\n      padding-left: 16px;\\r\\n    }\\r\\n\\r\\n    .tldr-box li {\\r\\n      font-size: 14px;\\r\\n      color: #444;\\r\\n      line-height: 1.6;\\r\\n      margin-bottom: 4px;\\r\\n    }\\r\\n\\r\\n    .reader-title {\\r\\n      font-size: 24px;\\r\\n      font-weight: 800;\\r\\n      color: #1a1a1a;\\r\\n      line-height: 1.25;\\r\\n      margin-bottom: 6px;\\r\\n      display: flex;\\r\\n      align-items: center;\\r\\n      gap: 10px;\\r\\n    }\\r\\n\\r\\n    .reader-title .icon-svg {\\r\\n      color: #1ABC9C;\\r\\n      flex-shrink: 0;\\r\\n    }\\r\\n\\r\\n    .reader-meta {\\r\\n      display: flex;\\r\\n      gap: 12px;\\r\\n      margin-bottom: 24px;\\r\\n    }\\r\\n\\r\\n    .reader-tag {\\r\\n      display: none;\\r\\n    }\\r\\n\\r\\n    .reader-time {\\r\\n      font-size: 12px;\\r\\n      color: #999;\\r\\n      display: flex;\\r\\n      align-items: center;\\r\\n      gap: 4px;\\r\\n    }\\r\\n\\r\\n    .divider {\\r\\n      height: 1px;\\r\\n      background: #f0ebe5;\\r\\n      margin: 20px 0;\\r\\n    }\\r\\n\\r\\n    .reader-body {\\r\\n      font-size: 15px;\\r\\n      line-height: 1.75;\\r\\n      color: #333;\\r\\n    }\\r\\n\\r\\n    .reader-body h3 {\\r\\n      font-size: 17px;\\r\\n      font-weight: 700;\\r\\n      color: #1a1a1a;\\r\\n      margin: 32px 0 10px;\\r\\n      padding-top: 4px;\\r\\n      scroll-margin-top: 24px;\\r\\n    }\\r\\n\\r\\n    .reader-body h3:first-of-type {\\r\\n      margin-top: 0;\\r\\n    }\\r\\n\\r\\n    .reader-body p {\\r\\n      margin-bottom: 14px;\\r\\n      line-height: 1.75;\\r\\n    }\\r\\n\\r\\n    .reader-body img,\\r\\n    .reader-body video,\\r\\n    .reader-body iframe {\\r\\n      display: block;\\r\\n      max-width: 100%;\\r\\n      height: auto;\\r\\n      margin: 18px auto;\\r\\n      border-radius: 12px;\\r\\n    }\\r\\n\\r\\n    .reader-body a {\\r\\n      color: #138a73;\\r\\n      text-decoration: underline;\\r\\n      text-underline-offset: 2px;\\r\\n    }\\r\\n\\r\\n    .reader-body blockquote {\\r\\n      margin: 20px 0;\\r\\n      padding: 12px 16px;\\r\\n      border-left: 3px solid #1ABC9C;\\r\\n      border-radius: 0 10px 10px 0;\\r\\n      background: #edf7f1;\\r\\n      color: #285447;\\r\\n    }\\r\\n\\r\\n    .reader-body blockquote p:last-child { margin-bottom: 0; }\\r\\n    .reader-body hr { margin: 26px 0; border: 0; border-top: 1px solid #e3ddd7; }\\r\\n    .reader-body sup { line-height: 0; }\\r\\n    .reader-body [id] { scroll-margin-top: 72px; }\\r\\n\\r\\n    .reader-body ul {\\r\\n      padding-left: 18px;\\r\\n      margin-bottom: 14px;\\r\\n    }\\r\\n\\r\\n    .reader-body li {\\r\\n      margin-bottom: 6px;\\r\\n    }\\r\\n\\r\\n    .reader-body .highlight {\\r\\n      background: #edf7f1;\\r\\n      border-left: 3px solid #1ABC9C;\\r\\n      padding: 12px 16px;\\r\\n      border-radius: 0 10px 10px 0;\\r\\n      margin: 16px 0;\\r\\n      font-size: 14px;\\r\\n      color: #1a6b40;\\r\\n      font-weight: 500;\\r\\n    }\\r\\n\\r\\n    /* GUIDE TOC BOX */\\r\\n    .guide-toc {\\r\\n      background: #f7f4f0;\\r\\n      border-radius: 14px;\\r\\n      padding: 14px 14px 4px;\\r\\n      margin-bottom: 28px;\\r\\n    }\\r\\n\\r\\n    .toc-label {\\r\\n      font-size: 10px;\\r\\n      font-weight: 800;\\r\\n      color: #9ba5ad;\\r\\n      text-transform: uppercase;\\r\\n      letter-spacing: 0.7px;\\r\\n      margin-bottom: 10px;\\r\\n      padding: 0 2px;\\r\\n    }\\r\\n\\r\\n    .toc-link {\\r\\n      display: flex;\\r\\n      align-items: center;\\r\\n      gap: 10px;\\r\\n      padding: 11px 14px;\\r\\n      margin-bottom: 8px;\\r\\n      background: #fff;\\r\\n      border: 1.5px solid #e3f5f0;\\r\\n      border-radius: 12px;\\r\\n      font-size: 13.5px;\\r\\n      font-weight: 700;\\r\\n      color: #12805e;\\r\\n      text-decoration: none;\\r\\n      cursor: pointer;\\r\\n      transition: transform 0.12s, filter 0.12s;\\r\\n    }\\r\\n\\r\\n    .toc-link:active {\\r\\n      transform: scale(0.98);\\r\\n      filter: brightness(0.97);\\r\\n    }\\r\\n\\r\\n    .toc-link-noanchor {\\r\\n      background: transparent;\\r\\n      border-color: #ede9e4;\\r\\n      color: #9ba5ad;\\r\\n      cursor: default;\\r\\n    }\\r\\n\\r\\n    .toc-link-noanchor:active {\\r\\n      transform: none;\\r\\n      filter: none;\\r\\n    }\\r\\n\\r\\n    .toc-link-noanchor::before {\\r\\n      opacity: 0.35;\\r\\n    }\\r\\n\\r\\n    .toc-link::before {\\r\\n      content: \'›\';\\r\\n      display: flex;\\r\\n      align-items: center;\\r\\n      justify-content: center;\\r\\n      width: 20px;\\r\\n      height: 20px;\\r\\n      flex-shrink: 0;\\r\\n      font-size: 14px;\\r\\n      font-weight: 800;\\r\\n      color: #fff;\\r\\n      background: #1ABC9C;\\r\\n      border-radius: 50%;\\r\\n      line-height: 1;\\r\\n    }\\r\\n\\r\\n    .toc-link-noanchor::before {\\r\\n      background: #d9d2c8;\\r\\n    }\\r\\n\\r\\n    /* GUIDE REFERENCES SECTION */\\r\\n    .guide-refs {\\r\\n      margin-top: 40px;\\r\\n      padding-top: 18px;\\r\\n      border-top: 1.5px solid #f0ebe5;\\r\\n    }\\r\\n\\r\\n    .refs-label {\\r\\n      font-size: 11px;\\r\\n      font-weight: 800;\\r\\n      color: #9ba5ad;\\r\\n      text-transform: uppercase;\\r\\n      letter-spacing: 0.6px;\\r\\n      margin-bottom: 12px;\\r\\n    }\\r\\n\\r\\n    .ref-item {\\r\\n      font-size: 11.5px;\\r\\n      color: #aaa;\\r\\n      line-height: 1.6;\\r\\n      margin-bottom: 8px;\\r\\n      padding-left: 10px;\\r\\n      border-left: 2px solid #e8e0d8;\\r\\n    }\\r\\n\\r\\n    .ref-item a {\\r\\n      color: #1ABC9C;\\r\\n      word-break: break-all;\\r\\n    }\\r\\n\\r\\n    /* MARK AS READ BUTTON */\\r\\n    .read-action {\\r\\n      padding: 16px 20px 18px;\\r\\n    }\\r\\n\\r\\n    .btn-read {\\r\\n      width: 100%;\\r\\n      padding: 16px;\\r\\n      background: #2d7d4e;\\r\\n      color: #fff;\\r\\n      border: none;\\r\\n      border-radius: 16px;\\r\\n      font-size: 16px;\\r\\n      font-weight: 700;\\r\\n      cursor: pointer;\\r\\n      display: flex;\\r\\n      align-items: center;\\r\\n      justify-content: center;\\r\\n      gap: 8px;\\r\\n      transition: background 0.2s;\\r\\n    }\\r\\n\\r\\n    .btn-read.done {\\r\\n      background: #f0f9f4;\\r\\n      color: #2d7d4e;\\r\\n      border: 2px solid #2d7d4e;\\r\\n      cursor: pointer;\\r\\n    }\\r\\n\\r\\n    /* ═════════════════════════════════════════════\\r\\n       QUIZ — motor de jogo\\r\\n       ═════════════════════════════════════════════\\r\\n       A identidade é a mesma do resto do app (fundo #faf7f4, cantos de 16–24px,\\r\\n       sombra \\"chapada\\" 0 3px 0 e a paleta oficial BLW), mas com o contraste\\r\\n       subido de propósito: aqui a tela é um JOGO, não um texto. O que muda é o\\r\\n       ritmo — uma pergunta por vez ocupando a tela inteira, resposta com um\\r\\n       toque só e devolutiva imediata numa gaveta que sobe de baixo.\\r\\n\\r\\n       Decisões de engajamento (Sexy Canvas — André Diamand):\\r\\n       • SEGURANÇA: errar nunca é vermelho de reprovação. O erro usa o coral da\\r\\n         marca, texto acolhedor e SEMPRE mostra a resposta certa explicada — não\\r\\n         existe \\"game over\\", nem cronômetro, nem perder vidas.\\r\\n       • RECOMPENSA/VAIDADE: pontos, sequência (\\"em chamas\\") e um selo com\\r\\n         título no fim são o troféu que a pessoa quer mostrar.\\r\\n       • CURIOSIDADE: cada devolutiva termina com um \\"sabia?\\" curto que ela não\\r\\n         sabia — é o que faz querer a próxima pergunta.\\r\\n       • PERTENCIMENTO/INVEJA: a estatística \\"X% das mães erram essa\\" transforma\\r\\n         o erro em algo coletivo (e o acerto em algo raro). */\\r\\n\\r\\n    .quiz-nav {\\r\\n      display: flex;\\r\\n      align-items: center;\\r\\n      gap: 12px;\\r\\n      padding: 14px 16px 10px;\\r\\n      position: sticky;\\r\\n      top: 0;\\r\\n      background: #faf7f4;\\r\\n      z-index: 20;\\r\\n    }\\r\\n\\r\\n    /* Barra de progresso segmentada: um traço por pergunta. Vale mais que uma\\r\\n       barra contínua porque ela vê de cara quantas faltam (e que são poucas). */\\r\\n    .quiz-seg-track {\\r\\n      flex: 1;\\r\\n      display: flex;\\r\\n      gap: 4px;\\r\\n    }\\r\\n\\r\\n    .quiz-seg {\\r\\n      flex: 1;\\r\\n      height: 7px;\\r\\n      border-radius: 4px;\\r\\n      background: #e8e0d8;\\r\\n      transition: background 0.25s;\\r\\n    }\\r\\n\\r\\n    .quiz-seg.hit {\\r\\n      background: linear-gradient(135deg, #1ABC9C, #0d9a7e);\\r\\n    }\\r\\n\\r\\n    .quiz-seg.miss {\\r\\n      background: #f0b4b4;\\r\\n    }\\r\\n\\r\\n    .quiz-seg.now {\\r\\n      background: #F9A247;\\r\\n    }\\r\\n\\r\\n    .quiz-stage {\\r\\n      display: none;\\r\\n      padding: 4px 20px 40px;\\r\\n    }\\r\\n\\r\\n    .quiz-stage.on {\\r\\n      display: block;\\r\\n      animation: quizStageIn 0.3s ease;\\r\\n    }\\r\\n\\r\\n    @keyframes quizStageIn {\\r\\n      from {\\r\\n        opacity: 0;\\r\\n        transform: translateY(8px);\\r\\n      }\\r\\n\\r\\n      to {\\r\\n        opacity: 1;\\r\\n        transform: none;\\r\\n      }\\r\\n    }\\r\\n\\r\\n    /* ── ABERTURA ── */\\r\\n    .quiz-hero {\\r\\n      background: linear-gradient(150deg, #14577C, #1d7fae);\\r\\n      border-radius: 24px;\\r\\n      padding: 26px 22px 24px;\\r\\n      color: #fff;\\r\\n      text-align: center;\\r\\n      box-shadow: 0 4px 0 #0e405c;\\r\\n      margin-bottom: 20px;\\r\\n      position: relative;\\r\\n      overflow: hidden;\\r\\n    }\\r\\n\\r\\n    .quiz-hero::after {\\r\\n      content: \'\';\\r\\n      position: absolute;\\r\\n      width: 190px;\\r\\n      height: 190px;\\r\\n      border-radius: 50%;\\r\\n      background: rgba(255, 255, 255, 0.07);\\r\\n      top: -80px;\\r\\n      right: -60px;\\r\\n    }\\r\\n\\r\\n    .quiz-hero-kicker {\\r\\n      font-size: 10.5px;\\r\\n      font-weight: 800;\\r\\n      letter-spacing: 1.2px;\\r\\n      text-transform: uppercase;\\r\\n      opacity: 0.75;\\r\\n      margin-bottom: 8px;\\r\\n    }\\r\\n\\r\\n    .quiz-hero-title {\\r\\n      font-size: 25px;\\r\\n      font-weight: 800;\\r\\n      line-height: 1.2;\\r\\n      margin-bottom: 10px;\\r\\n    }\\r\\n\\r\\n    .quiz-hero-sub {\\r\\n      font-size: 14px;\\r\\n      line-height: 1.55;\\r\\n      opacity: 0.92;\\r\\n      position: relative;\\r\\n      z-index: 1;\\r\\n    }\\r\\n\\r\\n    .quiz-facts {\\r\\n      display: flex;\\r\\n      gap: 8px;\\r\\n      margin-bottom: 18px;\\r\\n    }\\r\\n\\r\\n    .quiz-fact {\\r\\n      flex: 1;\\r\\n      background: #fff;\\r\\n      border: 2px solid #f0ebe5;\\r\\n      border-radius: 16px;\\r\\n      padding: 12px 6px;\\r\\n      text-align: center;\\r\\n    }\\r\\n\\r\\n    .quiz-fact-num {\\r\\n      font-size: 19px;\\r\\n      font-weight: 800;\\r\\n      color: #14577C;\\r\\n      line-height: 1.1;\\r\\n    }\\r\\n\\r\\n    .quiz-fact-lbl {\\r\\n      font-size: 10.5px;\\r\\n      font-weight: 600;\\r\\n      color: #9a9088;\\r\\n      margin-top: 3px;\\r\\n      line-height: 1.3;\\r\\n    }\\r\\n\\r\\n    /* Cartão de \\"você já fez este quiz\\" — só aparece pra quem tem resultado\\r\\n       salvo. Existe por dois motivos do Sexy Canvas: VAIDADE (o recorde é um\\r\\n       troféu, e troféu guardado na gaveta não vale nada) e RECOMPENSA (ver o\\r\\n       número anterior é o que transforma \\"jogar de novo\\" em \\"bater isso\\"). */\\r\\n    .quiz-done-card {\\r\\n      display: flex;\\r\\n      align-items: center;\\r\\n      gap: 12px;\\r\\n      background: linear-gradient(135deg, #f0fbf8, #eafaf5);\\r\\n      border: 2px solid #b7ebe0;\\r\\n      border-radius: 18px;\\r\\n      padding: 14px 16px;\\r\\n      margin-bottom: 14px;\\r\\n    }\\r\\n\\r\\n    .quiz-done-medal {\\r\\n      width: 42px;\\r\\n      height: 42px;\\r\\n      flex-shrink: 0;\\r\\n      border-radius: 50%;\\r\\n      background: linear-gradient(135deg, #1ABC9C, #0d9a7e);\\r\\n      display: flex;\\r\\n      align-items: center;\\r\\n      justify-content: center;\\r\\n      color: #fff;\\r\\n    }\\r\\n\\r\\n    .quiz-done-title {\\r\\n      font-size: 14.5px;\\r\\n      font-weight: 800;\\r\\n      color: #0d7a63;\\r\\n      line-height: 1.3;\\r\\n    }\\r\\n\\r\\n    .quiz-done-stats {\\r\\n      font-size: 13px;\\r\\n      color: #4a7d6c;\\r\\n      line-height: 1.45;\\r\\n      margin-top: 2px;\\r\\n    }\\r\\n\\r\\n    .quiz-done-stats b {\\r\\n      color: #0d7a63;\\r\\n    }\\r\\n\\r\\n    /* Promessa de segurança: some o medo de \\"e se eu errar?\\" antes do primeiro\\r\\n       toque. Sem isso, uma parte das mães simplesmente não começa. */\\r\\n    .btn-quiz-primary {\\r\\n      width: 100%;\\r\\n      padding: 17px;\\r\\n      background: linear-gradient(135deg, #f9a247, #e8902a);\\r\\n      color: #fff;\\r\\n      border: none;\\r\\n      border-radius: 18px;\\r\\n      font-size: 16.5px;\\r\\n      font-weight: 800;\\r\\n      cursor: pointer;\\r\\n      box-shadow: 0 4px 0 #c76f16;\\r\\n      transition: transform 0.12s, box-shadow 0.12s;\\r\\n    }\\r\\n\\r\\n    .btn-quiz-primary:active {\\r\\n      transform: translateY(3px);\\r\\n      box-shadow: 0 1px 0 #c76f16;\\r\\n    }\\r\\n\\r\\n    .btn-quiz-ghost {\\r\\n      width: 100%;\\r\\n      padding: 15px;\\r\\n      background: none;\\r\\n      color: #7d746c;\\r\\n      border: 2px solid #e8e0d8;\\r\\n      border-radius: 16px;\\r\\n      font-size: 14.5px;\\r\\n      font-weight: 700;\\r\\n      cursor: pointer;\\r\\n      margin-top: 10px;\\r\\n    }\\r\\n\\r\\n    /* ── PERGUNTA ── */\\r\\n    .quiz-q-tag {\\r\\n      display: inline-block;\\r\\n      font-size: 10px;\\r\\n      font-weight: 800;\\r\\n      text-transform: uppercase;\\r\\n      letter-spacing: 0.8px;\\r\\n      padding: 4px 10px;\\r\\n      border-radius: 999px;\\r\\n      margin-bottom: 12px;\\r\\n      background: #3B82C422;\\r\\n      color: #14577C;\\r\\n    }\\r\\n\\r\\n    .quiz-q-tag.mito {\\r\\n      background: #EB575722;\\r\\n      color: #c23c3c;\\r\\n    }\\r\\n\\r\\n    .quiz-q-tag.cena {\\r\\n      background: #F9A24722;\\r\\n      color: #b56d13;\\r\\n    }\\r\\n\\r\\n    .quiz-q-tag.bonus {\\r\\n      background: #FFCF4E33;\\r\\n      color: #8a6a00;\\r\\n    }\\r\\n\\r\\n    /* Pergunta + cena formam UM bloco só, amarrado pelo fio laranja lateral.\\r\\n\\r\\n       A cena vem DEPOIS da pergunta (ver ordem em #quiz-stage-play): a\\r\\n       pergunta no topo é o que a pessoa precisa ler primeiro.\\r\\n\\r\\n       Antes a cena era um cartão branco com sombra. O problema é que as\\r\\n       opções também são cartões brancos com sombra — o olho classificava a\\r\\n       cena como \\"mais um botão\\" e passava direto pra procurar onde clicar.\\r\\n       Por isso aqui não tem fundo, nem sombra, nem canto arredondado: o único\\r\\n       branco com sombra da tela voltou a ser o das opções.\\r\\n\\r\\n       O fio lateral corre ao lado das duas, então a cena não tem como ser\\r\\n       lida como coisa separada. Sem itálico (dificulta a leitura corrida), e\\r\\n       a cor é quase tão escura quanto a da pergunta: as duas formam uma\\r\\n       sequência, não manchete + legenda. */\\r\\n    .quiz-scene {\\r\\n      font-size: 16.5px;\\r\\n      font-weight: 500;\\r\\n      color: #4a443c;\\r\\n      line-height: 1.5;\\r\\n    }\\r\\n\\r\\n    /* O fio só aparece quando existe cena; sem ela, a pergunta fica solta na\\r\\n       margem como sempre foi. A classe é ligada em renderQuizQuestion(). */\\r\\n    #quiz-q-block {\\r\\n      margin-bottom: 18px;\\r\\n    }\\r\\n\\r\\n    #quiz-q-block.has-cena {\\r\\n      border-left: 3px solid #F9A247;\\r\\n      padding-left: 14px;\\r\\n    }\\r\\n\\r\\n    #quiz-q-block.has-cena .quiz-q-text {\\r\\n      margin-bottom: 8px;\\r\\n    }\\r\\n\\r\\n    .quiz-q-text {\\r\\n      font-size: 18px;\\r\\n      font-weight: 800;\\r\\n      color: #1a1a1a;\\r\\n      line-height: 1.35;\\r\\n    }\\r\\n\\r\\n    .quiz-options {\\r\\n      display: flex;\\r\\n      flex-direction: column;\\r\\n      gap: 10px;\\r\\n      /* espaço pra gaveta de devolutiva não cobrir a última opção */\\r\\n      padding-bottom: 8px;\\r\\n    }\\r\\n\\r\\n    .quiz-opt {\\r\\n      display: flex;\\r\\n      align-items: center;\\r\\n      gap: 12px;\\r\\n      width: 100%;\\r\\n      text-align: left;\\r\\n      background: #fff;\\r\\n      border: 2px solid #ece5dd;\\r\\n      border-radius: 18px;\\r\\n      padding: 15px 16px;\\r\\n      font-size: 15px;\\r\\n      font-weight: 600;\\r\\n      color: #2d2d2d;\\r\\n      line-height: 1.4;\\r\\n      cursor: pointer;\\r\\n      box-shadow: 0 3px 0 #ece5dd;\\r\\n      transition: transform 0.12s, box-shadow 0.12s, border-color 0.15s, background 0.15s;\\r\\n    }\\r\\n\\r\\n    .quiz-opt:active {\\r\\n      transform: translateY(3px);\\r\\n      box-shadow: 0 0 0 #ece5dd;\\r\\n    }\\r\\n\\r\\n    .quiz-opt-key {\\r\\n      width: 27px;\\r\\n      height: 27px;\\r\\n      flex-shrink: 0;\\r\\n      border-radius: 9px;\\r\\n      background: #f6f1eb;\\r\\n      color: #9a9088;\\r\\n      font-size: 12.5px;\\r\\n      font-weight: 800;\\r\\n      display: flex;\\r\\n      align-items: center;\\r\\n      justify-content: center;\\r\\n    }\\r\\n\\r\\n    .quiz-opt.right {\\r\\n      border-color: #1ABC9C;\\r\\n      background: #f0fbf8;\\r\\n      box-shadow: 0 3px 0 #1ABC9C;\\r\\n    }\\r\\n\\r\\n    .quiz-opt.right .quiz-opt-key {\\r\\n      background: #1ABC9C;\\r\\n      color: #fff;\\r\\n    }\\r\\n\\r\\n    .quiz-opt.wrong {\\r\\n      border-color: #EB5757;\\r\\n      background: #fef3f3;\\r\\n      box-shadow: 0 3px 0 #EB5757;\\r\\n    }\\r\\n\\r\\n    .quiz-opt.wrong .quiz-opt-key {\\r\\n      background: #EB5757;\\r\\n      color: #fff;\\r\\n    }\\r\\n\\r\\n    .quiz-opt.dim {\\r\\n      opacity: 0.45;\\r\\n    }\\r\\n\\r\\n    .quiz-opt[disabled] {\\r\\n      cursor: default;\\r\\n    }\\r\\n\\r\\n    /* ── DEVOLUTIVA (gaveta que sobe) ── */\\r\\n    .quiz-feedback {\\r\\n      position: fixed;\\r\\n      bottom: 0;\\r\\n      left: 50%;\\r\\n      transform: translateX(-50%) translateY(105%);\\r\\n      width: 100%;\\r\\n      max-width: 430px;\\r\\n      background: #fff;\\r\\n      border-radius: 26px 26px 0 0;\\r\\n      box-shadow: 0 -8px 34px rgba(0, 0, 0, 0.16);\\r\\n      padding: 20px 20px 26px;\\r\\n      z-index: 300;\\r\\n      transition: transform 0.32s cubic-bezier(.34, 1.3, .64, 1);\\r\\n      max-height: 78vh;\\r\\n      overflow-y: auto;\\r\\n    }\\r\\n\\r\\n    .quiz-feedback.up {\\r\\n      transform: translateX(-50%) translateY(0);\\r\\n    }\\r\\n\\r\\n    .quiz-fb-head {\\r\\n      display: flex;\\r\\n      align-items: center;\\r\\n      gap: 10px;\\r\\n      margin-bottom: 10px;\\r\\n    }\\r\\n\\r\\n    .quiz-fb-mark {\\r\\n      width: 38px;\\r\\n      height: 38px;\\r\\n      border-radius: 50%;\\r\\n      display: flex;\\r\\n      align-items: center;\\r\\n      justify-content: center;\\r\\n      font-size: 20px;\\r\\n      font-weight: 800;\\r\\n      color: #fff;\\r\\n      flex-shrink: 0;\\r\\n    }\\r\\n\\r\\n    .quiz-feedback.ok .quiz-fb-mark {\\r\\n      background: linear-gradient(135deg, #1ABC9C, #0d9a7e);\\r\\n    }\\r\\n\\r\\n    .quiz-feedback.no .quiz-fb-mark {\\r\\n      background: linear-gradient(135deg, #f28a8a, #EB5757);\\r\\n    }\\r\\n\\r\\n    .quiz-fb-title {\\r\\n      font-size: 17.5px;\\r\\n      font-weight: 800;\\r\\n      line-height: 1.25;\\r\\n    }\\r\\n\\r\\n    .quiz-feedback.ok .quiz-fb-title {\\r\\n      color: #0d9a7e;\\r\\n    }\\r\\n\\r\\n    .quiz-feedback.no .quiz-fb-title {\\r\\n      color: #c23c3c;\\r\\n    }\\r\\n\\r\\n    .quiz-fb-body {\\r\\n      font-size: 14.5px;\\r\\n      color: #4a4a4a;\\r\\n      line-height: 1.6;\\r\\n      margin-bottom: 12px;\\r\\n    }\\r\\n\\r\\n    .quiz-fb-body b {\\r\\n      color: #1a1a1a;\\r\\n    }\\r\\n\\r\\n    .quiz-fb-did {\\r\\n      background: #fff8e8;\\r\\n      border: 1.5px solid #ffe4ad;\\r\\n      border-radius: 14px;\\r\\n      padding: 12px 14px;\\r\\n      font-size: 13.5px;\\r\\n      color: #7a5c15;\\r\\n      line-height: 1.55;\\r\\n      margin-bottom: 12px;\\r\\n    }\\r\\n\\r\\n    .quiz-fb-did b {\\r\\n      color: #8a6a00;\\r\\n    }\\r\\n\\r\\n    .quiz-fb-social {\\r\\n      font-size: 12.5px;\\r\\n      font-weight: 700;\\r\\n      color: #8b827a;\\r\\n      line-height: 1.5;\\r\\n      margin-bottom: 14px;\\r\\n      display: flex;\\r\\n      align-items: flex-start;\\r\\n      gap: 6px;\\r\\n    }\\r\\n\\r\\n    .quiz-fb-social span {\\r\\n      color: #14577C;\\r\\n    }\\r\\n\\r\\n    /* Selo de sequência: mora dentro da gaveta de devolutiva e só aparece a\\r\\n       partir do 2º acerto seguido. Aparecer cedo demais desvaloriza; aparecer\\r\\n       só aí vira conquista. */\\r\\n    .quiz-fb-streak {\\r\\n      display: inline-block;\\r\\n      background: linear-gradient(135deg, #f9a247, #e8902a);\\r\\n      color: #fff;\\r\\n      font-size: 12px;\\r\\n      font-weight: 800;\\r\\n      padding: 5px 12px;\\r\\n      border-radius: 999px;\\r\\n      margin-bottom: 12px;\\r\\n      box-shadow: 0 3px 10px rgba(232, 144, 42, 0.35);\\r\\n      animation: celebratePop 0.4s cubic-bezier(.34, 1.56, .64, 1);\\r\\n    }\\r\\n\\r\\n    /* ── RESULTADO ── */\\r\\n    .quiz-result-card {\\r\\n      background: linear-gradient(150deg, #1ABC9C, #0d9a7e);\\r\\n      border-radius: 26px;\\r\\n      padding: 28px 22px 24px;\\r\\n      text-align: center;\\r\\n      color: #fff;\\r\\n      box-shadow: 0 4px 0 #0b7d63;\\r\\n      margin-bottom: 16px;\\r\\n      position: relative;\\r\\n      overflow: hidden;\\r\\n    }\\r\\n\\r\\n    .quiz-result-card.mid {\\r\\n      background: linear-gradient(150deg, #f9a247, #e8902a);\\r\\n      box-shadow: 0 4px 0 #c76f16;\\r\\n    }\\r\\n\\r\\n    .quiz-result-card.low {\\r\\n      background: linear-gradient(150deg, #3B82C4, #14577C);\\r\\n      box-shadow: 0 4px 0 #0e405c;\\r\\n    }\\r\\n\\r\\n    .quiz-result-medal {\\r\\n      width: 76px;\\r\\n      height: 76px;\\r\\n      margin: 0 auto 12px;\\r\\n      border-radius: 50%;\\r\\n      background: rgba(255, 255, 255, 0.18);\\r\\n      display: flex;\\r\\n      align-items: center;\\r\\n      justify-content: center;\\r\\n      color: #FFCF4E;\\r\\n      animation: celebratePop 0.5s cubic-bezier(.34, 1.56, .64, 1);\\r\\n    }\\r\\n\\r\\n    .quiz-result-title {\\r\\n      font-size: 23px;\\r\\n      font-weight: 800;\\r\\n      line-height: 1.2;\\r\\n      margin-bottom: 6px;\\r\\n    }\\r\\n\\r\\n    .quiz-result-sub {\\r\\n      font-size: 14px;\\r\\n      line-height: 1.55;\\r\\n      opacity: 0.94;\\r\\n      margin-bottom: 16px;\\r\\n    }\\r\\n\\r\\n    .quiz-result-stats {\\r\\n      display: flex;\\r\\n      gap: 8px;\\r\\n    }\\r\\n\\r\\n    .quiz-result-stat {\\r\\n      flex: 1;\\r\\n      background: rgba(255, 255, 255, 0.16);\\r\\n      border-radius: 14px;\\r\\n      padding: 10px 4px;\\r\\n    }\\r\\n\\r\\n    .quiz-result-stat-num {\\r\\n      font-size: 20px;\\r\\n      font-weight: 800;\\r\\n      line-height: 1.1;\\r\\n    }\\r\\n\\r\\n    .quiz-result-stat-lbl {\\r\\n      font-size: 10px;\\r\\n      font-weight: 700;\\r\\n      text-transform: uppercase;\\r\\n      letter-spacing: 0.5px;\\r\\n      opacity: 0.85;\\r\\n      margin-top: 2px;\\r\\n    }\\r\\n\\r\\n    .quiz-recap-title {\\r\\n      font-size: 12px;\\r\\n      font-weight: 800;\\r\\n      color: #9a9088;\\r\\n      text-transform: uppercase;\\r\\n      letter-spacing: 0.6px;\\r\\n      margin: 20px 0 10px;\\r\\n    }\\r\\n\\r\\n    .quiz-recap-item {\\r\\n      display: flex;\\r\\n      gap: 10px;\\r\\n      align-items: flex-start;\\r\\n      background: #fff;\\r\\n      border: 2px solid #f0ebe5;\\r\\n      border-radius: 16px;\\r\\n      padding: 12px 14px;\\r\\n      margin-bottom: 8px;\\r\\n    }\\r\\n\\r\\n    .quiz-recap-mark {\\r\\n      width: 20px;\\r\\n      height: 20px;\\r\\n      border-radius: 50%;\\r\\n      flex-shrink: 0;\\r\\n      margin-top: 1px;\\r\\n      display: flex;\\r\\n      align-items: center;\\r\\n      justify-content: center;\\r\\n      font-size: 12px;\\r\\n      font-weight: 800;\\r\\n      color: #fff;\\r\\n    }\\r\\n\\r\\n    .quiz-recap-mark.ok {\\r\\n      background: #1ABC9C;\\r\\n    }\\r\\n\\r\\n    .quiz-recap-mark.no {\\r\\n      background: #EB5757;\\r\\n    }\\r\\n\\r\\n    .quiz-recap-text {\\r\\n      font-size: 13.5px;\\r\\n      color: #4a4a4a;\\r\\n      line-height: 1.5;\\r\\n    }\\r\\n\\r\\n    /* Título da linha de revisão. É um <span> dedicado (e não um <b>) porque o\\r\\n       texto da explicação também usa <b> pra grifar palavras no meio da frase —\\r\\n       se o título fosse <b>, todo grifo virava uma linha nova. */\\r\\n    .quiz-recap-head {\\r\\n      color: #1a1a1a;\\r\\n      display: block;\\r\\n      margin-bottom: 2px;\\r\\n      font-size: 14px;\\r\\n      font-weight: 800;\\r\\n    }\\r\\n\\r\\n    .quiz-recap-text b {\\r\\n      color: #1a1a1a;\\r\\n    }\\r\\n\\r\\n    /* Confete do resultado — pura decoração, sem biblioteca. */\\r\\n    .quiz-confetti {\\r\\n      position: absolute;\\r\\n      inset: 0;\\r\\n      pointer-events: none;\\r\\n      overflow: hidden;\\r\\n    }\\r\\n\\r\\n    .quiz-confetti i {\\r\\n      position: absolute;\\r\\n      top: -14px;\\r\\n      width: 8px;\\r\\n      height: 12px;\\r\\n      border-radius: 2px;\\r\\n      opacity: 0.9;\\r\\n      animation: quizConfettiFall 1.5s linear forwards;\\r\\n    }\\r\\n\\r\\n    @keyframes quizConfettiFall {\\r\\n      to {\\r\\n        transform: translateY(320px) rotate(540deg);\\r\\n        opacity: 0;\\r\\n      }\\r\\n    }\\r\\n\\r\\n    /* PREMIUM */\\r\\n    .premium-badge {\\r\\n      display: inline-block;\\r\\n      font-size: 10px;\\r\\n      font-weight: 700;\\r\\n      color: #b8860b;\\r\\n      background: #fff8e1;\\r\\n      border: 1px solid #ffe082;\\r\\n      border-radius: 20px;\\r\\n      padding: 2px 8px;\\r\\n      margin-bottom: 4px;\\r\\n      letter-spacing: 0.3px;\\r\\n    }\\r\\n\\r\\n    .premium-card {\\r\\n      border-left: 3px solid #ffe082;\\r\\n      background: linear-gradient(to bottom right, #fffef7, #fff);\\r\\n    }\\r\\n\\r\\n    .section-divider {\\r\\n      text-align: center;\\r\\n      font-size: 12px;\\r\\n      font-weight: 700;\\r\\n      color: #b8860b;\\r\\n      letter-spacing: 0.5px;\\r\\n      padding: 16px 0 8px;\\r\\n    }\\r\\n\\r\\n    .section-divider span {\\r\\n      background: #fff8e1;\\r\\n      border: 1px solid #ffe082;\\r\\n      border-radius: 20px;\\r\\n      padding: 4px 16px;\\r\\n    }\\r\\n\\r\\n    .read-pill {\\r\\n      color: #2d7d4e;\\r\\n      border-color: #c8e6c9;\\r\\n      background: #f1f8f2;\\r\\n    }\\r\\n    /* ─────────────────────────────────────────────\\r\\n       INFOGRÁFICOS DENTRO DO GUIA (.ig-*)\\r\\n       O conteúdo (bodyHtml) carrega só markup declarativo - div, span, strong e\\r\\n       um <span data-icon=\\"...\\"> vazio. O desenho vem todo daqui e o ícone é\\r\\n       preenchido por hydrateGuideArt() com o mesmo sprite do resto do app.\\r\\n       Sem <script> e sem <svg> dentro do conteúdo: é o que a regra 7 do\\r\\n       cabeçalho pede, e protege contra o editor do BuildFire limpar markup que\\r\\n       ele não reconhece.\\r\\n       ───────────────────────────────────────────── */\\r\\n    .reader-body .ig {\\r\\n      margin: 26px 0;\\r\\n      opacity: 0;\\r\\n      transform: translateY(12px);\\r\\n      transition: opacity 0.45s ease, transform 0.45s cubic-bezier(0.2, 0.8, 0.2, 1);\\r\\n    }\\r\\n\\r\\n    .reader-body .ig.ig-in {\\r\\n      opacity: 1;\\r\\n      transform: none;\\r\\n    }\\r\\n\\r\\n    .reader-body .ig-label {\\r\\n      display: flex;\\r\\n      align-items: center;\\r\\n      gap: 6px;\\r\\n      font-size: 10px;\\r\\n      font-weight: 800;\\r\\n      color: #9ba5ad;\\r\\n      text-transform: uppercase;\\r\\n      letter-spacing: 0.7px;\\r\\n      margin-bottom: 10px;\\r\\n      padding: 0 2px;\\r\\n    }\\r\\n\\r\\n    .reader-body .ig-card {\\r\\n      background: #fff;\\r\\n      border: 1.5px solid #e8e0d8;\\r\\n      border-radius: 18px;\\r\\n      box-shadow: 0 3px 0 #f0ebe5;\\r\\n      padding: 14px;\\r\\n    }\\r\\n\\r\\n    /* Uma linha do infográfico: ícone à esquerda, texto à direita. Vale para os\\r\\n       três formatos (fases, princípios, desvantagens) - o que muda é a cor da\\r\\n       borda e o tamanho do ícone, não a estrutura. */\\r\\n    .reader-body .ig-row {\\r\\n      display: flex;\\r\\n      align-items: flex-start;\\r\\n      gap: 12px;\\r\\n      padding: 11px 12px;\\r\\n      border-radius: 14px;\\r\\n      background: #faf7f4;\\r\\n      border: 1.5px solid #f0ebe5;\\r\\n    }\\r\\n\\r\\n    .reader-body .ig-row + .ig-row {\\r\\n      margin-top: 8px;\\r\\n    }\\r\\n\\r\\n    .reader-body .ig-ico {\\r\\n      flex: 0 0 auto;\\r\\n      display: flex;\\r\\n      align-items: center;\\r\\n      justify-content: center;\\r\\n      width: 38px;\\r\\n      height: 38px;\\r\\n      border-radius: 12px;\\r\\n      background: #fff;\\r\\n      border: 1.5px solid #f0ebe5;\\r\\n    }\\r\\n\\r\\n    .reader-body .ig-txt {\\r\\n      min-width: 0;\\r\\n    }\\r\\n\\r\\n    .reader-body .ig-main {\\r\\n      font-size: 13.5px;\\r\\n      font-weight: 800;\\r\\n      color: #1a1a1a;\\r\\n      line-height: 1.35;\\r\\n    }\\r\\n\\r\\n    .reader-body .ig-sub {\\r\\n      font-size: 12.5px;\\r\\n      font-weight: 500;\\r\\n      color: #756a5c;\\r\\n      line-height: 1.45;\\r\\n      margin-top: 2px;\\r\\n    }\\r\\n\\r\\n    .reader-body .ig-age {\\r\\n      display: inline-block;\\r\\n      font-size: 10.5px;\\r\\n      font-weight: 800;\\r\\n      color: #12805e;\\r\\n      background: #e3f5f0;\\r\\n      border-radius: 7px;\\r\\n      padding: 2px 7px;\\r\\n      margin-bottom: 4px;\\r\\n      letter-spacing: 0.2px;\\r\\n    }\\r\\n\\r\\n    /* Fases do leite -> comida. O par de ícones é o dado: o grande é o alimento\\r\\n       principal daquela fase, o pequeno é o que complementa. Sem porcentagem,\\r\\n       porque o guia não dá número nenhum - e a gente não inventa. */\\r\\n    .reader-body .ig-pair {\\r\\n      flex: 0 0 auto;\\r\\n      display: flex;\\r\\n      align-items: flex-end;\\r\\n      gap: 4px;\\r\\n      width: 58px;\\r\\n    }\\r\\n\\r\\n    .reader-body .ig-pair .ig-ico {\\r\\n      width: 38px;\\r\\n      height: 38px;\\r\\n      border-radius: 12px;\\r\\n    }\\r\\n\\r\\n    .reader-body .ig-pair .ig-ico-sm {\\r\\n      width: 26px;\\r\\n      height: 26px;\\r\\n      border-radius: 9px;\\r\\n      opacity: 0.8;\\r\\n    }\\r\\n\\r\\n    .reader-body .ig-phases .ig-row {\\r\\n      align-items: center;\\r\\n    }\\r\\n\\r\\n    /* Desvantagem: mesma linha, tingida de laranja, porque o guia trata as três\\r\\n       como \\"existe, e a gente te ajuda com isso\\". */\\r\\n    .reader-body .ig-row-warn {\\r\\n      background: #fdf6ee;\\r\\n      border-color: #f6e3cb;\\r\\n    }\\r\\n\\r\\n    .reader-body .ig-row-warn .ig-ico {\\r\\n      border-color: #f6e3cb;\\r\\n    }\\r\\n\\r\\n    /* Mito x evidência: as duas barras têm exatamente a mesma largura porque o\\r\\n       guia diz que a chance é exatamente a mesma. Se um dia o dado mudar, muda\\r\\n       a largura - a barra é o dado, não decoração. */\\r\\n    .reader-body .ig-equal {\\r\\n      display: flex;\\r\\n      align-items: center;\\r\\n      gap: 10px;\\r\\n      margin: 2px 0 12px;\\r\\n    }\\r\\n\\r\\n    .reader-body .ig-equal-side {\\r\\n      flex: 1;\\r\\n      min-width: 0;\\r\\n    }\\r\\n\\r\\n    .reader-body .ig-equal-name {\\r\\n      font-size: 12px;\\r\\n      font-weight: 800;\\r\\n      color: #1a1a1a;\\r\\n      margin-bottom: 6px;\\r\\n      white-space: nowrap;\\r\\n      overflow: hidden;\\r\\n      text-overflow: ellipsis;\\r\\n    }\\r\\n\\r\\n    .reader-body .ig-equal-bar {\\r\\n      height: 12px;\\r\\n      border-radius: 7px;\\r\\n      background: #1ABC9C;\\r\\n      transform: scaleX(0);\\r\\n      transform-origin: left center;\\r\\n      transition: transform 0.55s cubic-bezier(0.2, 0.8, 0.2, 1) 0.15s;\\r\\n    }\\r\\n\\r\\n    .reader-body .ig-equal-bar-alt {\\r\\n      background: #3B82C4;\\r\\n    }\\r\\n\\r\\n    .reader-body .ig.ig-in .ig-equal-bar {\\r\\n      transform: scaleX(1);\\r\\n    }\\r\\n\\r\\n    .reader-body .ig-equal-sign {\\r\\n      font-size: 17px;\\r\\n      font-weight: 800;\\r\\n      color: #9ba5ad;\\r\\n      padding-top: 14px;\\r\\n    }\\r\\n\\r\\n    .reader-body .ig-note {\\r\\n      font-size: 12.5px;\\r\\n      font-weight: 600;\\r\\n      color: #756a5c;\\r\\n      line-height: 1.5;\\r\\n    }\\r\\n\\r\\n    .reader-body .ig-note-strong {\\r\\n      margin-top: 8px;\\r\\n      padding: 10px 12px;\\r\\n      border-radius: 12px;\\r\\n      background: #edf7f1;\\r\\n      color: #1a6b40;\\r\\n      font-weight: 700;\\r\\n    }\\r\\n\\r\\n    /* Casca