r\\n\\r\\n    .related-guides {\\r\\n      padding: 14px 20px 0;\\r\\n    }\\r\\n\\r\\n    .related-guides-title {\\r\\n      font-size: 13px;\\r\\n      font-weight: 700;\\r\\n      color: #9a9088;\\r\\n      text-transform: uppercase;\\r\\n      letter-spacing: 0.3px;\\r\\n      margin-bottom: 8px;\\r\\n      padding: 0 2px;\\r\\n    }\\r\\n\\r\\n    .related-guides-list {\\r\\n      background: #fff;\\r\\n      border-radius: 14px;\\r\\n      border: 1px solid #f0ebe5;\\r\\n      overflow: hidden;\\r\\n    }\\r\\n\\r\\n    .related-guide-row {\\r\\n      display: flex;\\r\\n      align-items: center;\\r\\n      padding: 13px 14px;\\r\\n      gap: 12px;\\r\\n      cursor: pointer;\\r\\n      border-bottom: 1px solid #f4efe9;\\r\\n      transition: background 0.12s;\\r\\n    }\\r\\n\\r\\n    .related-guide-row:last-child {\\r\\n      border-bottom: none;\\r\\n    }\\r\\n\\r\\n    .related-guide-row:active {\\r\\n      background: #f9f5f0;\\r\\n    }\\r\\n\\r\\n    .related-guide-chevron {\\r\\n      flex-shrink: 0;\\r\\n      color: #c9c0b6;\\r\\n    }\\r\\n\\r\\n    /* SEARCH RESULTS */\\r\\n    .search-results-list {\\r\\n      padding: 0 20px 110px;\\r\\n    }\\r\\n\\r\\n    .search-lesson {\\r\\n      background: #fff;\\r\\n      border-radius: 14px;\\r\\n      margin-bottom: 8px;\\r\\n      display: flex;\\r\\n      align-items: center;\\r\\n      padding: 13px 15px;\\r\\n      gap: 12px;\\r\\n      cursor: pointer;\\r\\n      box-shadow: 0 2px 8px rgba(0, 0, 0, 0.06);\\r\\n      transition: transform 0.12s;\\r\\n    }\\r\\n\\r\\n    .search-lesson:active {\\r\\n      transform: scale(0.98);\\r\\n    }\\r\\n\\r\\n    .search-lesson {\\r\\n      align-items: flex-start;\\r\\n    }\\r\\n\\r\\n    .search-lesson .lesson-em {\\r\\n      margin-top: 1px;\\r\\n    }\\r\\n\\r\\n    .search-lesson .lesson-row.completed .lesson-title {\\r\\n      color: #9ba5ad;\\r\\n    }\\r\\n\\r\\n    .search-lesson-snippet {\\r\\n      font-size: 12px;\\r\\n      color: #8a8580;\\r\\n      line-height: 1.4;\\r\\n      margin-top: 4px;\\r\\n      overflow: hidden;\\r\\n      display: -webkit-box;\\r\\n      -webkit-line-clamp: 2;\\r\\n      -webkit-box-orient: vertical;\\r\\n    }\\r\\n\\r\\n    .search-lesson-snippet mark {\\r\\n      background: none;\\r\\n      color: #1ABC9C;\\r\\n      font-weight: 700;\\r\\n    }\\r\\n\\r\\n    .search-answer {\\r\\n      background: #EAFBF6;\\r\\n      border: 1px solid #B7ECE0;\\r\\n      border-radius: 14px;\\r\\n      padding: 14px 16px;\\r\\n      margin-bottom: 12px;\\r\\n      cursor: pointer;\\r\\n      transition: transform 0.12s;\\r\\n    }\\r\\n\\r\\n    .search-answer:active {\\r\\n      transform: scale(0.98);\\r\\n    }\\r\\n\\r\\n    .search-answer-label {\\r\\n      font-size: 11px;\\r\\n      font-weight: 700;\\r\\n      color: #12967f;\\r\\n      text-transform: uppercase;\\r\\n      letter-spacing: 0.03em;\\r\\n      margin-bottom: 5px;\\r\\n    }\\r\\n\\r\\n    .search-answer-text {\\r\\n      font-size: 14px;\\r\\n      color: #1a1a1a;\\r\\n      line-height: 1.45;\\r\\n    }\\r\\n\\r\\n    .search-answer-cta {\\r\\n      font-size: 13px;\\r\\n      font-weight: 600;\\r\\n      color: #12967f;\\r\\n      margin-top: 9px;\\r\\n    }\\r\\n\\r\\n    .search-empty {\\r\\n      text-align: center;\\r\\n      padding: 48px 20px;\\r\\n      color: #9ba5ad;\\r\\n      font-size: 14px;\\r\\n      line-height: 1.6;\\r\\n    }\\r\\n\\r\\n    .search-empty .search-empty-icon {\\r\\n      font-size: 36px;\\r\\n      display: block;\\r\\n      margin-bottom: 10px;\\r\\n    }\\r\\n\\r\\n    /* GUIDE READER */\\r\\n    /* A tela de leitura tem fundo branco, diferente do bege (#faf7f4) do resto\\r\\n       do app: no texto corrido o branco é o que dá o contraste mais alto e\\r\\n       cansa menos a vista. Jornada e lista continuam bege. */\\r\\n    #screen-reader {\\r\\n      background: #fff;\\r\\n    }\\r\\n\\r\\n    .reader-nav {\\r\\n      display: flex;\\r\\n      align-items: center;\\r\\n      gap: 12px;\\r\\n      padding: 16px 20px;\\r\\n      background: #fff;\\r\\n      border-bottom: 1px solid #f0ebe5;\\r\\n      position: sticky;\\r\\n      top: 0;\\r\\n      z-index: 100;\\r\\n    }\\r\\n\\r\\n    .reader-progress-track {\\r\\n      display: none;\\r\\n      position: absolute;\\r\\n      left: 0;\\r\\n      right: 0;\\r\\n      bottom: -1px;\\r\\n      height: 3px;\\r\\n      background: #f0ebe5;\\r\\n    }\\r\\n    .reader-progress-fill {\\r\\n      height: 100%;\\r\\n      width: 0%;\\r\\n      background: #2d7d4e;\\r\\n      transition: width 0.15s linear;\\r\\n    }\\r\\n\\r\\n    /* Faixa de índice: mora DENTRO do header sticky, ancorada na borda de baixo\\r\\n       dele, e entra deslizando por cima do texto. Se entrasse no fluxo, o\\r\\n       parágrafo que a pessoa está lendo pularia pra baixo no instante em que ela\\r\\n       aparecesse. O z-index negativo a esconde atrás do fundo branco do próprio\\r\\n       header quando recolhida — como `.reader-nav` tem z-index, tudo isso segue\\r\\n       acima do corpo do texto. */\\r\\n    .reader-jump {\\r\\n      position: absolute;\\r\\n      left: 0;\\r\\n      right: 0;\\r\\n      top: 100%;\\r\\n      z-index: -1;\\r\\n      transform: translateY(-100%);\\r\\n      opacity: 0;\\r\\n      pointer-events: none;\\r\\n      transition: transform 0.22s ease, opacity 0.18s ease;\\r\\n    }\\r\\n\\r\\n    .reader-jump.up {\\r\\n      transform: translateY(0);\\r\\n      opacity: 1;\\r\\n      pointer-events: auto;\\r\\n    }\\r\\n\\r\\n    .reader-jump-bar {\\r\\n      width: 100%;\\r\\n      display: flex;\\r\\n      align-items: center;\\r\\n      gap: 8px;\\r\\n      padding: 10px 20px;\\r\\n      background: #f7f4f0;\\r\\n      border: none;\\r\\n      border-bottom: 1px solid #f0ebe5;\\r\\n      font-family: inherit;\\r\\n      text-align: left;\\r\\n      cursor: pointer;\\r\\n    }\\r\\n\\r\\n    .reader-jump-label {\\r\\n      flex: 1;\\r\\n      min-width: 0;\\r\\n      font-size: 13px;