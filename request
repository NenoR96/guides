).catch(error => debugLogError(\'setReaderMode:GuidesAPI\', error));\\r\\n      }\\r\\n      // Depois de trocar a classe `active`: agora getScrollContainer() já\\r\\n      // aponta pra tela nova, que é quem precisa começar do topo.\\r\\n      if (id \u0021== \'reader\') scrollContainerTo(0);\\r\\n      // As duas trilhas não abrem no topo: ancoram no \\"Começar\\". Fica aqui (e\\r\\n      // não em openJourney) pra valer em toda entrada na tela — inclusive na\\r\\n      // volta do leitor logo depois de marcar um guia como lido, que é quando\\r\\n      // a posição mais importa.\\r\\n      if (id === \'journey\') scrollPathToCurrent(document.getElementById(\'journey-path\'));\\r\\n      if (id === \'age\') scrollPathToCurrent(document.getElementById(\'journey-path-home\'));\\r\\n      // A estradinha depende de medida de layout, e trilha fora de vista mede\\r\\n      // zero. Um repinte feito com outra tela ativa (marcar guia como lido\\r\\n      // repinta a Home) deixa a curva sem desenhar — aqui ela é recuperada.\\r\\n      if (id === \'journey\' || id === \'age\') {\\r\\n        requestAnimationFrame(() => redrawAllJourneyTrails());\\r\\n      }\\r\\n      registerBuildfireBackButton();\\r\\n    }\\r\\n\\r\\n    // Rede de segurança: se o app for pra segundo plano/fechado enquanto ela\\r\\n    // lê (sem passar por showScreen), ainda assim guarda onde ela parou.\\r\\n    document.addEventListener(\'visibilitychange\', () => {\\r\\n      if (document.visibilityState \u0021== \'hidden\') return;\\r\\n      const activeScreen = document.querySelector(\'.screen.active\');\\r\\n      if (activeScreen && activeScreen.id === \'screen-reader\') saveReaderScrollPosition();\\r\\n    });\\r\\n\\r\\n    // ─────────────────────────────────────────────\\r\\n    // BIRTHDATE INPUT\\r\\n    // ─────────────────────────────────────────────\\r\\n    const input = document.getElementById(\'birthdate-input\');\\r\\n    const ageDisplay = document.getElementById(\'age-display\');\\r\\n    const ageText = document.getElementById(\'age-text\');\\r\\n    const ageSublabel = document.getElementById(\'age-sublabel\');\\r\\n    const btnContinue = document.getElementById(\'btn-continue\');\\r\\n\\r\\n    input.setAttribute(\'max\', new Date().toISOString().split(\'T\')[0]);\\r\\n\\r\\n    function updateAgeDisplay(val) {\\r\\n      const { months, days } = getAgeInMonths(val);\\r\\n\\r\\n      let display, sublabel;\\r\\n      if (months === 0) {\\r\\n        display = `${days} dias`;\\r\\n        sublabel = \'de vida\';\\r\\n      } else if (months < 24) {\\r\\n        display = `${months} meses`;\\r\\n        sublabel = days > 0 ? `e ${days} dias` : \'de vida\';\\r\\n      } else {\\r\\n        const years = Math.floor(months / 12);\\r\\n        const rem = months % 12;\\r\\n        display = `${years} ano${years > 1 ? \'s\' : \'\'}`;\\r\\n        sublabel = rem > 0 ? `e ${rem} meses` : \'de vida\';\\r\\n      }\\r\\n\\r\\n      ageText.textContent = display;\\r\\n      ageSublabel.textContent = sublabel;\\r\\n      ageDisplay.style.display = \'block\';\\r\\n      btnContinue.disabled = false;\\r\\n    }\\r\\n\\r\\n    input.addEventListener(\'change\', function () {\\r\\n      const val = this.value;\\r\\n      if (\u0021isValidBirthdate(val)) return;\\r\\n      babyBirthdate = val;\\r\\n      updateAgeDisplay(val);\\r\\n    });\\r\\n\\r\\n    function confirmBirthdateAndContinue() {\\r\\n      if (\u0021isValidBirthdate(babyBirthdate)) return;\\r\\n      saveReadGuides();\\r\\n      goToGuides();\\r\\n    }\\r\\n\\r\\n    // ─────────────────────────────────────────────\\r\\n    // GO TO GUIDES\\r\\n    // ─────────────────────────────────────────────\\r\\n    // ─────────────────────────────────────────────\\r\\n    // MONTHLY SUMMARY DATA\\r\\n    // ─────────────────────────────────────────────\\r\\n    const MONTHLY_SUMMARY = {\\r\\n      \\"5\\": {\\r\\n        title: \\"Como se preparar dos 0 aos 5 meses\\",\\r\\n        esperar: [\\r\\n          \\"Pode: leite materno ou fórmula\\",\\r\\n          \\"Não pode: alimentos em geral\\",\\r\\n          \\"Não pode: líquidos em geral\\",\\r\\n          \\"O bebê ainda não está pronto para a introdução alimentar\\",\\r\\n          \\"Ele pode demonstrar interesse pela comida dos adultos - é curiosidade, não fome\\"\\r\\n        ],\\r\\n        lembrese: [\\r\\n          \\"Estude sobre a introdução alimentar (tudo o que você precisa saber está nesse aplicativo). A informação aqui empodera e reduz dificuldades alimentares futuras\\",\\r\\n          \\"Aguarde: a introdução alimentar deve iniciar apenas após os 6 meses + sinais de prontidão, segundo a Sociedade Brasileira de Pediatria (SBP) e a Organização Mundial da Saúde (OMS)\\",\\r\\n          \\"Se o pediatra recomendou iniciar de forma precoce (devido a algum suposto baixo ganho de peso, volta ao trabalho, nova gestação...), busque uma segunda opinião\\",\\r\\n          \\"Entenda sobre o reflexo de gag, o engasgo, e aprenda a manobra. O alimento número 1 de engasgo é o leite\\",\\r\\n          \\"Se inspire diariamente com bebês explorando os alimentos no nosso instagram @BlwBrasilApp\\",\\r\\n          \\"Compartilhe esse aplicativo com a sua rede de apoio\\"\\r\\n        ]\\r\\n      },\\r\\n      \\"6\\": {\\r\\n        title: \\"O que esperar dos 6 meses\\",\\r\\n        esperar: [\\r\\n          \\"O bebê pode comer pouco ou nada\\",\\r\\n          \\"Pode beber pouca água ou nada\\",\\r\\n          \\"Ele terá dificuldade em pegar alguns alimentos\\",\\r\\n          \\"Ele vai cuspir muitos alimentos\\",\\r\\n          \\"Ele terá Gags (movimento de ânsia de vômito)\\",\\r\\n          \\"Vai ter muita sujeira\\",\\r\\n          \\"Ele continuará mamando (leite materno/fórmula) como fazia aos 5 meses\\"\\r\\n        ],\\r\\n        lembrese: [\\r\\n          \\"Inicie a introdução alimentar só se o bebê tiver <strong>todos</strong> os sinais de prontidão\\",\\r\\n          \\"Ofereça os alimen