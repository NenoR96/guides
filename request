\n        esperar: [\\r\\n          \\"O bebê pode começar a usar a pinça (polegar + indicador)\\",\\r\\n          \\"Maior interesse e envolvimento nas refeições\\",\\r\\n          \\"Menos gags, mais confiança ao comer\\",\\r\\n          \\"Pode demonstrar preferências por alguns alimentos\\",\\r\\n          \\"Começa a imitar os movimentos de mastigação dos adultos\\"\\r\\n        ],\\r\\n        lembrese: [\\r\\n          \\"Ofereça pedaços menores para estimular o desenvolvimento da pinça\\",\\r\\n          \\"Varie texturas: alimentos mais macios e alguns mais firmes\\",\\r\\n          \\"Continue sem sal, açúcar ou temperos industrializados\\",\\r\\n          \\"Respeite as preferências do bebê sem forçar\\",\\r\\n          \\"Essa fase é sobre aprendizado, não sobre quantidade comida\\"\\r\\n        ]\\r\\n      },\\r\\n      \\"9\\": {\\r\\n        title: \\"O que esperar dos 9 meses\\",\\r\\n        esperar: [\\r\\n          \\"Pinça cada vez mais desenvolvida e precisa\\",\\r\\n          \\"Come quantidade maior e mais variada\\",\\r\\n          \\"Pode começar a demonstrar autonomia - quer pegar sozinho\\",\\r\\n          \\"Maior participação nas refeições em família\\",\\r\\n          \\"Pode aparecer neofobia leve (recusa de novos alimentos)\\"\\r\\n        ],\\r\\n        lembrese: [\\r\\n          \\"Siga oferecendo alimentos mesmo após recusas - pode levar 10 a 15 tentativas\\",\\r\\n          \\"Introduza gradualmente alimentos mais firmes\\",\\r\\n          \\"Ofereça utensílios: colher precoce, copo aberto de silicone\\",\\r\\n          \\"Continue amamentando - o leite segue sendo importante\\",\\r\\n          \\"Não compare o bebê com outras crianças - cada um tem seu ritmo\\"\\r\\n        ]\\r\\n      },\\r\\n      \\"10\\": {\\r\\n        title: \\"O que esperar dos 10 meses\\",\\r\\n        esperar: [\\r\\n          \\"O bebê já come grande variedade de alimentos\\",\\r\\n          \\"Boa coordenação mão-boca desenvolvida\\",\\r\\n          \\"Pode começar a usar colher com ajuda\\",\\r\\n          \\"Come praticamente o mesmo que a família (sem sal e açúcar)\\",\\r\\n          \\"Refeições mais organizadas e previsíveis\\"\\r\\n        ],\\r\\n        lembrese: [\\r\\n          \\"Inclua o bebê nas refeições da família sempre\\",\\r\\n          \\"Ofereça colher e deixe ele tentar usá-la\\",\\r\\n          \\"Mantenha o ambiente de refeição sem telas ou distrações\\",\\r\\n          \\"Respeite os sinais de saciedade - nunca force\\",\\r\\n          \\"Faça da hora da comida um momento prazeroso\\"\\r\\n        ]\\r\\n      },\\r\\n      \\"11\\": {\\r\\n        title: \\"O que esperar dos 11 meses\\",\\r\\n        esperar: [\\r\\n          \\"Alta autonomia para comer sozinho\\",\\r\\n          \\"Uso crescente de colher e copo\\",\\r\\n          \\"Come a maioria dos alimentos da família\\",\\r\\n          \\"Pode surgir seletividade alimentar - fase normal do desenvolvimento\\",\\r\\n          \\"Refeições mais rápidas e eficientes\\"\\r\\n        ],\\r\\n        lembrese: [\\r\\n          \\"Continue oferecendo variedade mesmo com seletividade\\",\\r\\n          \\"Envolva o bebê na preparação dos alimentos quando possível\\",\\r\\n          \\"O leite materno ainda tem valor nutricional e emocional\\",\\r\\n          \\"Consulte o pediatra para avaliar crescimento e desenvolvimento\\",\\r\\n          \\"Celebrate essa fase - quase 1 aninho de BLW\u0021\\"\\r\\n        ]\\r\\n      },\\r\\n      \\"12\\": {\\r\\n        title: \\"O que esperar do 1 aninho\u0021\\",\\r\\n        esperar: [\\r\\n          \\"O bebê já é um comedorzão experiente\u0021\\",\\r\\n          \\"Come praticamente tudo que a família come\\",\\r\\n          \\"Usa colher e copo com boa desenvoltura\\",\\r\\n          \\"Refeições em família são naturais e prazerosas\\",\\r\\n          \\"A partir de agora pode introduzir mel e leite de vaca integral\\"\\r\\n        ],\\r\\n        lembrese: [\\r\\n          \\"Parabéns por 1 ano de BLW\u0021 É uma conquista enorme\\",\\r\\n          \\"Continue sem ultraprocessados, açúcar e sal em excesso\\",\\r\\n          \\"Celebre a autonomia alimentar conquistada\\",\\r\\n          \\"Mantenha as refeições em família como hábito\\",\\r\\n          \\"O leite materno pode continuar pelo tempo que for desejado\\"\\r\\n        ]\\r\\n      },\\r\\n      \\"24\\": {\\r\\n        title: \\"Criança grande - autonomia total\u0021\\",\\r\\n        esperar: [\\r\\n          \\"Total independência para comer sozinho\\",\\r\\n          \\"Usa talheres com desenvoltura crescente\\",\\r\\n          \\"Tem preferências e opiniões sobre a comida\\",\\r\\n          \\"Pode ter fases de seletividade alimentar - é normal\\",\\r\\n          \\"Refeições em família são fundamentais para o desenvolvimento\\"\\r\\n        ],\\r\\n        lembrese: [\\r\\n          \\"Mantenha variedade e equilíbrio no cardápio\\",\\r\\n          \\"Envolva a criança no planejamento das refeições\\",\\r\\n          \\"Sem pressão para comer - respeite a autonomia\\",\\r\\n          \\"Sirva os alimentos que a família come - sem preparos separados\\",\\r\\n          \\"Consulte o pediatra regularmente para acompanhar o crescimento\\"\\r\\n        ]\\r\\n      }\\r\\n    };\\r\\n\\r\\n    function renderMonthlySummary(phaseKey) {\\r\\n      const card = document.getElementById(\'month-summary-card\');\\r\\n      const data = MONTHLY_SUMMARY[phaseKey];\\r\\n      if (\u0021data) { card.style.display = \'none\'; return; }\\r\\n\\r\\n      card.style.display = \'\';\\r\\n      document.getElementById(\'mscard-title\').textContent = data.title;\\r\\n\\r\\n      const esperarEl = document.getElementById(\'mscard-esperar\');\\r\\n      esperarEl.innerHTML = data.esperar.map(t => `<li>${t}</li>`).join(\'\');\\r\\n\\r\\n      const lembreseEl = document.getElementById(\'mscard-lembrese\');\\r\\n      lembreseEl.innerHTML = data.lembrese.map(t => `<li>${t}</li>`).join(\'\');\\r\\n    }\\r\\n\\r\\n    let _summarySummaryOpen = false;\\r\\n    function toggleMonthlySummary() {\\r\\n      const card = document.getElementById(\'month-summary-card\');\\r\\n      _summarySummaryOpen = \u0021_summarySummaryOpen;\\r\\n      card.classList.toggle(\'open\', _summarySummaryOpen);\\r\\n    }\\r\\n\\r\\n    // ─────────────────────────────────────────────\\r\\n    // MARCO \\"O QUE ESPERAR\\" NA JORNADA\\r\\n    // Reaproveita os dados de MONTHLY_SUMMARY, mas abre num sheet por cima da\\r\\n    // tela em vez de navegar — não é um guia, não conta como lido/progresso.\\r\\n    // ─────────────────────────────────────────────\\r\\n    function openMilestoneSheet(phaseKey) {\\r\\n      const data = MONTHLY_SUMMARY[phaseKey];\\r\\n      if (\u0021data) return;\\r\\n\\r\\n      document.getElementById(\'milestone-sheet-title\').textContent = data.title;\\r\\n      document.getElementById(\'milestone-sheet-esperar\').innerHTML =\\r\\n        data.esperar.map(t => `<li>${t}</li>`).join(\'\');\\r\\n      document.getElementById(\'milestone-sheet-lembrese\').innerHTML =\\r\\n        data.lembrese.map(t => `<li>${t}</li>`).join(\'\');\\r\\n\\r\\n      document.getElementById(\'milestone-overlay\').classList.add(\'open\');\\r\\n    }\\r\\n\\r\\n    function closeMilestoneSheet() {\\r\\n      document.getElementById(\'milestone-overlay\').classList.remove(\'open\');\\r\\n    }\\r\\n\\r\\n    // Coleta todos os guias únicos do app (todas as fases), sem repetir por id.\\r\\n    // Usado tanto na tela \\"Todos os guias\\" quanto na tela personalizada, já que\\r\\n    // as duas agora mostram a biblioteca completa organizada por tema — a\\r\\n    // personalizada só acrescenta o destaque \\"Para o seu bebê agora\\" por cima.\\r\\n    function collectAllLibraryGuides() {\\r\\n      if (contractJourneySections \u0021== null) {\\r\\n        const fundamentals = new Set(FUNDAMENTALS.map(g => g.id));\\r\\n        return ALL_GUIDES_FLAT.filter(g => \u0021fundamentals.has(g.id));\\r\\n      }\\r\\n      const seen = new Set();\\r\\n      const arr = [];\\r\\n      FUNDAMENTALS.forEach(g => seen.add(g.id));\\r\\n      // Atemporais entram junto (na mesma posição que ocupam em ALL_GUIDES_FLAT):\\r\\n      // eles aparecem nos temas do accordion, então precisam existir também no\\r\\n      // índice da busca — senão a usuária vê o guia na tela e não o acha ao buscar.\\r\\n      AGELESS_GUIDES.forEach(g => {\\r\\n        if (\u0021seen.has(g.id)) { seen.add(g.id); arr.push(g); }\\r\\n      });\\r\\n      Object.values(GUIDES_DATA).forEach(phaseGuides => {\\r\\n        phaseGuides.forEach(g => {\\r\\n          if (\u0021seen.has(g.id)) { seen.add(g.id); arr.push(g); }\\r\\n        });\\r\\n      });\\r\\n      return arr;\\r\\n    }\\r\\n\\r\\n    function goToGuides() {\\r\\n      const { months } = getAgeInMonths(babyBirthdate);\\r\\n      const phase = getPhaseFromAge(months);\\r\\n      currentPhase = phase;\\r\\n      phaseHighlightGuides = GUIDES_DATA[phase.key] || []; // guias da fase atual → destaque\\r\\n      currentGuides = collectAllLibraryGuides(); // biblioteca completa → agrupada por tema\\r\\n      allCurrentGuides = [...FUNDAMENTALS, ...currentGuides];\\r\\n      _searchIndex = null; // reset index (biblioteca completa)\\r\\n\\r\\n      document.getElementById(\'guides-greeting\').textContent = \'Personalizados para você\';\\r\\n      document.getElementById(\'phase-chip\').textContent = \'📍 \' + phase.label;\\r\\n\\r\\n      _summarySummaryOpen = false; // reset collapsed state\\r\\n      renderMonthlySummary(phase.key);\\r\\n\\r\\n      renderCourseModules();\\r\\n      updateProgress();\\r\\n      showScreen(\'guides\');\\r\\n      startFearBannerCycle();\\r\\n    }\\r\\n\\r\\n    function goToAllGuides() {\\r\\n      currentPhase = { key: \'all\', label: \'Todos os guias\', icon: \'📚\' };\\r\\n      phaseHighlightGuides = []; // sem fase conhecida → sem destaque \\"para o seu bebê agora\\"\\r\\n      currentGuides = collectAllLibraryGuides();\\r\\n      allCurrentGuides = [...FUNDAMENTALS, ...currentGuides];\\r\\n      _searchIndex = null; // reset so index rebuilds with full guide list\\r\\n\\r\\n      document.getElementById(\'guides-greeting\').textContent = \'Biblioteca completa\';\\r\\n      document.getElementById(\'phase-chip\').textContent = \'📚 Todos os guias\';\\r\\n      document.getElementById(\'month-summary-card\').style.display = \'none\'; // no summary for \\"all guides\\"\\r\\n\\r\\n      renderCourseModules();\\r\\n      updateProgress();\\r\\n      showScreen(\'guides\');\\r\\n      startFearBannerCycle();\\r\\n    }\\r\\n\\r\\n    // ─────────────────────────────────────────────\\r\\n    // FEAR BANNER CYCLE\\r\\n    // ─────────────────────────────────────────────\\r\\n    const fearMessages = [\\r\\n      { icon: \'heart-pulse\', title: \'Você está no lugar certo\', text: \'Todos os guias foram revisados por nutricionistas e pediatras especializados em BLW.\' },\\r\\n      { icon: \'shield-alert\', title: \'Medo do engasgo? É normal.\', text: \'Aprenda a diferença entre o reflexo gag e engasgo real - e sinta mais tranquilidade.\' },\\r\\n      { icon: \'flask\', title: \'Baseado em ciência\', text: \'Todo o conteúdo é baseado em evidências e atualizado com as melhores práticas mundiais.\' },\\r\\n      { icon: \'clock-cycle\', title: \'Leia quando puder\', text: \'Os guias foram pensados para famílias ocupadas. Cada um no momento certo.\' },\\r\\n    ];\\r\\n    let fearIdx = 0;\\r\\n    let fearIntervalId = null;\\r\\n    function startFearBannerCycle() {\\r\\n      if (fearIntervalId) return; // don\'t start multiple intervals\\r\\n      fearIntervalId = setInterval(() => {\\r\\n        fearIdx = (fearIdx + 1) % fearMessages.length;\\r\\n        const m = fearMessages[fearIdx];\\r\\n        const banner = document.getElementById(\'fear-banner\');\\r\\n        if (banner) {\\r\\n          banner.style.opacity = \'0\';\\r\\n          banner.style.transition = \'opacity 0.4s\';\\r\\n          setTimeout(() => {\\r\\n            banner.innerHTML = `<div class=\\"fear-icon\\">${iconHTML(m.icon, 20)}</div><div class=\\"fear-text\\"><strong>${m.title}</strong>${m.text}</div>`;\\r\\n            banner.style.opacity = \'1\';\\r\\n          }, 400);\\r\\n        }\\r\\n      }, 5000);\\r\\n    }\\r\\n\\r\\n    // ─────────────────────────────────────────────\\r\\n    // COURSE MODULES (ACCORDION)\\r\\n    // ─────────────────────────────────────────────\\r\\n    // Estado aberto/fechado de cada bloco do accordion. Os temas entram\\r\\n    // explicitamente porque toggleModule() faz `\u0021moduleState[key]`: sem a chave\\r\\n    // semeada, o primeiro clique num tema calcularia `\u0021undefined === true` e o\\r\\n    // bloco (que já nasce aberto) não fecharia.\\r\\n    const moduleState = { phase: true };\\r\\n    LIST_THEMES.forEach(theme => { moduleState[theme.key] = true; });\\r\\n    moduleState[\'tema-outros\'] = true;\\r\\n\\r\\n    // ─────────────────────────────────────────────\\r\\n    // REFORÇO POSITIVO (sem pontuação/ranking) — celebração ao ler, selo ao\\r\\n    // completar um bloco/tema, e uma frase de apoio no fim de cada guia.\\r\\n    // ─────────────────────────────────────────────\\r\\n\\r\\n    // 1) Celebração rápida (aparece e some sozinha) ao marcar um guia como lido\\r\\n    const CELEBRATION_MESSAGES = [\\r\\n      \'Você está cuidando muito bem do seu bebê.\',\\r\\n      \'Mais um passo nessa jornada do BLW\u0021\',\\r\\n      \'Você está arrasando.\',\\r\\n      \'Isso\u0021 Cada guia lido é um cuidado a mais.\',\\r\\n      \'Você está construindo um conhecimento e tanto.\',\\r\\n      \'Você está no caminho certo. Continue\u0021\',\\r\\n    ];\\r\\n\\r\\n    let _celebrateTimeout = null;\\r\\n    // `message` opcional: sem ela sorteia uma das frases de leitura. Quem chama\\r\\n    // com texto próprio (o desbloqueio do bônus) precisa que ele apareça — a\\r\\n    // assinatura sem parâmetro fazia a mensagem do bônus ser descartada em\\r\\n    // silêncio e a pessoa via, no meio do quiz, um elogio sobre ler guias.\\r\\n    function showCelebration(message) {\\r\\n      const pick = message ||\\r\\n        CELEBRATION_MESSAGES[Math.floor(Math.random() * CELEBRATION_MESSAGES.length)];\\r\\n      document.getElementById(\'celebrate-msg\').textContent = pick;\\r\\n\\r\\n      const overlay = document.getElementById(\'celebrate-overlay\');\\r\\n      overlay.classList.add(\'open\');\\r\\n\\r\\n      clearTimeout(_celebrateTimeout);\\r\\n      _celebrateTimeout = setTimeout(() => overlay.classList.remove(\'open\'), 2000);\\r\\n    }\\r\\n\\r\\n    // 2) Selo de conquista ao completar um bloco/tema inteiro pela primeira vez\\r\\n    function showAchievement(groupTitle) {\\r\\n      document.getElementById(\'achievement-title\').textContent = `Você completou ${groupTitle}\u0021 🎉`;\\r\\n      document.getElementById(\'achievement-sub\').textContent =\\r\\n        \'Mais um bloco de conhecimento conquistado. Continue no seu ritmo - o próximo já te espera.\';\\r\\n      document.getElementById(\'achievement-overlay\').classList.add(\'open\');\\r\\n    }\\r\\n    function closeAchievement() {\\r\\n      document.getElementById(\'achievement-overlay\').classList.remove(\'open\');\\r\\n    }\\r\\n\\r\\n    // Verifica se o guia recém-marcado como lido completou algum bloco (Fundamentos,\\r\\n    // o destaque da fase atual, ou o grupo temático dele) — sempre a partir da\\r\\n    // biblioteca inteira, pra não depender de qual tela está ativa no momento.\\r\\n    function checkGroupCompletion(guideId) {\\r\\n      const guide = ALL_GUIDES_FLAT.find(g => g.id === guideId);\\r\\n      if (\u0021guide) return null;\\r\\n\\r\\n      const candidateGroups = [];\\r\\n\\r\\n      // Os Fundamentos não são mais uma seção da jornada, mas seguem sendo um\\r\\n      // conjunto reconhecível (\\"terminou a base\\") — por isso o selo continua,\\r\\n      // agora com o nome da fase que os abriga.\\r\\n      if (FUNDAMENTALS.find(f => f.id === guideId)) {\\r\\n        const section = buildPhaseSections().find(s => s.guides.some(g => g.id === guideId));\\r\\n        candidateGroups.push({ title: section ? section.label : \'\', guides: FUNDAMENTALS });\\r\\n      }\\r\\n      if (phaseHighlightGuides.find(g => g.id === guideId)) {\\r\\n        candidateGroups.push({ title: \'os guias da sua fase atual\', guides: phaseHighlightGuides });\\r\\n      }\\r\\n      // Tema do guia na taxonomia única (LIST_THEMES) — todo guia tem um, então\\r\\n      // aqui não há mais exceção para os Fundamentos: quem terminar \\"Comece por\\r\\n      // aqui\\" ou \\"Segurança sem medo\\" ganha o selo do tema.\\r\\n      const theme = themeSectionOfGuide(guideId);\\r\\n      if (theme && theme.guides.length) {\\r\\n        candidateGroups.push({ title: `o tema \\"${theme.label}\\"`, guides: theme.guides });\\r\\n      }\\r\\n\\r\\n      for (const grp of candidateGroups) {\\r\\n        if (\u0021grp.guides.length) continue;\\r\\n        const done = grp.guides.filter(g => readGuides.has(g.id)).length;\\r\\n        if (done === grp.guides.length) return grp.title;\\r\\n      }\\r\\n      return null;\\r\\n    }\\r\\n\\r\\n    // ─────────────────────────────────────────────\\r\\n    // CONTEÚDOS RELACIONADOS (sugeridos ao concluir um guia)\\r\\n    // ─────────────────────────────────────────────\\r\\n    // Prioriza guias ainda não lidos, começando pela mesma tag exata, depois\\r\\n    // pelo mesmo tema (LIST_THEMES — o mesmo tema em que ela acabou de ver esse\\r\\n    // guia na lista/accordion), e só recorre a guias já lidos se a biblioteca\\r\\n    // não tiver mais nada novo pra sugerir.\\r\\n    function getRelatedGuides(guide, limit, excludeIds) {\\r\\n      limit = limit || 2;\\r\\n      const themeKey = themeKeyOfGuide(guide.id);\\r\\n      const pool = ALL_GUIDES_FLAT.filter(g => g.id \u0021== guide.id && \u0021excludeIds.has(g.id));\\r\\n\\r\\n      const buckets = [\\r\\n        pool.filter(g => g.tag === guide.tag && \u0021readGuides.has(g.id)),\\r\\n        pool.filter(g => themeKeyOfGuide(g.id) === themeKey && g.tag \u0021== guide.tag && \u0021readGuides.has(g.id)),\\r\\n        pool.filter(g => \u0021readGuides.has(g.id)),\\r\\n        pool.filter(g => g.tag === guide.tag),\\r\\n        pool,\\r\\n      ];\\r\\n\\r\\n      const seen = new Set();\\r\\n      const related = [];\\r\\n      for (const bucket of buckets) {\\r\\n        for (const g of bucket) {\\r\\n          if (related.length >= limit) break;\\r\\n          if (seen.has(g.id)) continue;\\r\\n          seen.add(g.id);\\r\\n          related.push(g);\\r\\n        }\\r\\n        if (related.length >= limit) break;\\r\\n      }\\r\\n      return related;\\r\\n    }\\r\\n\\r\\n    // Mistura guias e quizzes: o quiz do próprio guia recém-concluído entra\\r\\n    // primeiro (é o próximo passo mais óbvio pra testar o que acabou de ler),\\r\\n    // o resto é preenchido com guias relacionados, e sobrando espaço ainda\\r\\n    // (guia sem quiz próprio e sem guias relacionados o bastante) cai pra\\r\\n    // qualquer outro quiz pendente da biblioteca.\\r\\n    function getRelatedItems(guide, limit) {\\r\\n      limit = limit || 2;\\r\\n      const items = [];\\r\\n      const seenIds = new Set();\\r\\n\\r\\n      const ownQuizzes = (QUIZ_BY_GUIDE_ID[guide.id] || []).filter(q => \u0021completedQuizzes.has(q.id));\\r\\n      for (const q of ownQuizzes) {\\r\\n        if (items.length >= limit) break;\\r\\n        if (seenIds.has(q.id)) continue;\\r\\n        seenIds.add(q.id);\\r\\n        items.push({ type: \'quiz\', ...q });\\r\\n      }\\r\\n\\r\\n      if (items.length < limit) {\\r\\n        const relatedGuides = getRelatedGuides(guide, limit - items.length, seenIds);\\r\\n        for (const g of relatedGuides) {\\r\\n          seenIds.add(g.id);\\r\\n          items.push({ type: \'guide\', ...g });\\r\\n        }\\r\\n      }\\r\\n\\r\\n      if (items.length < limit) {\\r\\n        const otherQuizzes = QUIZZES.filter(q => \u0021completedQuizzes.has(q.id) && \u0021seenIds.has(q.id));\\r\\n        for (const q of otherQuizzes) {\\r\\n          if (items.length >= limit) break;\\r\\n          seenIds.add(q.id);\\r\\n          items.push({ type: \'quiz\', ...q });\\r\\n        }\\r\\n      }\\r\\n\\r\\n      return items;\\r\\n    }\\r\\n\\r\\n    function buildRelatedItemRow(item) {\\r\\n      if (item.type === \'quiz\') {\\r\\n        return `\\r\\n        <div class=\\"related-guide-row\\" onclick=\\"openQuizPlay(\'${item.id}\')\\">\\r\\n          <div class=\\"lesson-em quiz-em\\"><span class=\\"quiz-em-text\\">Quiz</span></div>\\r\\n          <div class=\\"lesson-body\\">\\r\\n            <div class=\\"lesson-title\\">${item.title}</div>\\r\\n            <div class=\\"lesson-time\\">${item.questions} perguntas</div>\\r\\n          </div>\\r\\n          <svg class=\\"related-guide-chevron\\" width=\\"16\\" height=\\"16\\" viewBox=\\"0 0 16 16\\" fill=\\"none\\">\\r\\n            <path d=\\"M6 4l4 4-4 4\\" stroke=\\"currentColor\\" stroke-width=\\"2\\" stroke-linecap=\\"round\\" stroke-linejoin=\\"round\\"/>\\r\\n          </svg>\\r\\n        </div>`;\\r\\n      }\\r\\n      return `\\r\\n        <div class=\\"related-guide-row\\" onclick=\\"openGuide(\'${item.id}\', \'${lastListScreen}\')\\">\\r\\n          <div class=\\"lesson-em\\">${guideIconBadgeHTML(item, 20, 36)}</div>\\n          <div class=\\"lesson-body\\">\\r\\n            <div class=\\"lesson-title\\">${item.title}</div>\\r\\n            <div class=\\"lesson-time\\">⏱ ${item.readTime}</div>\\r\\n          </div>\\r\\n          <svg class=\\"related-guide-chevron\\" width=\\"16\\" height=\\"16\\" viewBox=\\"0 0 16 16\\" fill=\\"none\\">\\r\\n            <path d=\\"M6 4l4 4-4 4\\" stroke=\\"currentColor\\" stroke-width=\\"2\\" stroke-linecap=\\"round\\" stroke-linejoin=\\"round\\"/>\\r\\n          </svg>\\r\\n        </div>`;\\r\\n    }\\r\\n\\r\\n    // Só aparece quando o guia atual já foi concluído — some se a pessoa\\r\\n    // desmarcar \\"lido\\" de novo.\\r\\n    function renderRelatedGuides(guide) {\\r\\n      const section = document.getElementById(\'related-guides\');\\r\\n      const list = document.getElementById(\'related-guides-list\');\\r\\n      const related = readGuides.has(guide.id) ? getRelatedItems(guide, 2) : [];\\r\\n\\r\\n      if (\u0021related.length) {\\r\\n        section.style.display = \'none\';\\r\\n        list.innerHTML = \'\';\\r\\n        return;\\r\\n      }\\r\\n\\r\\n      list.innerHTML = related.map(buildRelatedItemRow).join(\'\');\\r\\n      section.style.display = \'block\';\\r\\n    }\\r\\n\\r\\n    function renderCourseModules() {\\r\\n      const wrap = document.getElementById(\'modules-wrap\');\\r\\n      if (\u0021wrap) return;\\r\\n      wrap.innerHTML = \'\';\\r\\n\\r\\n      // Destaque \\"Para o seu bebê agora\\": só existe na visão personalizada\\r\\n      // (quando sabemos a fase do bebê). Fica no topo, por cima da biblioteca\\r\\n      // temática. É um atalho, não uma seção exclusiva — os guias dele\\r\\n      // reaparecem abaixo, no tema a que pertencem.\\r\\n      if (phaseHighlightGuides.length > 0) {\\r\\n        const highlightDone = phaseHighlightGuides.filter(g => readGuides.has(g.id)).length;\\r\\n        wrap.appendChild(buildModule(\'phase\', \'pin\', \'Para o seu bebê agora\', \'Guias da sua fase\', phaseHighlightGuides, highlightDone));\\r\\n      }\\r\\n\\r\\n      // Biblioteca completa por tema, na MESMA taxonomia (LIST_THEMES) da visão\\r\\n      // em lista da Home — antes esta tela tinha a sua própria divisão, tirada\\r\\n      // do campo `tag`, e o app mostrava dois recortes temáticos concorrentes.\\r\\n      //\\r\\n      // Não há mais um bloco \\"A Base do BLW\\" separado aqui: os Fundamentos se\\r\\n      // dissolveram nos temas (\\"Comece por aqui\\" já era 6 dos 10 deles), e\\r\\n      // mantê-los à parte repetiria os mesmos guias em dois blocos da mesma\\r\\n      // tela. Na jornada, onde a ordem do currículo é o eixo, a seção\\r\\n      // \\"A Base do BLW\\" continua existindo.\\r\\n      buildThemeSections().forEach(section => {\\r\\n        if (\u0021section.guides.length) return;\\r\\n        const done = section.guides.filter(g => readGuides.has(g.id)).length;\\r\\n        wrap.appendChild(buildModule(section.key, section.icon, section.label, section.subtitle, section.guides, done));\\r\\n      });\\r\\n    }\\r\\n\\r\\n    function buildModule(key, icon, name, subtitle, guides, doneCount) {\\r\\n      const total = guides.length;\\r\\n      const pct = total ? Math.round((doneCount / total) * 100) : 0;\\r\\n      const isOpen = moduleState[key] \u0021== false;\\r\\n\\r\\n      const block = document.createElement(\'div\');\\r\\n      block.className = `module-block module-${key}${isOpen ? \' open\' : \'\'}`;\\r\\n      block.id = \'module-\' + key;\\r\\n\\r\\n      block.innerHTML = `\\r\\n    <div class=\\"module-header\\" onclick=\\"toggleModule(\'${key}\')\\">\\r\\n      <div class=\\"mod-icon\\">${iconHTML(icon, 22, \'#fff\')}</div>\\r\\n      <div class=\\"mod-info\\">\\r\\n        <div class=\\"mod-name\\">${name}</div>\\r\\n        <div class=\\"mod-count\\">${doneCount}/${total} lidos · ${subtitle}</div>\\r\\n      </div>\\r\\n      <svg class=\\"mod-chevron\\" width=\\"20\\" height=\\"20\\" viewBox=\\"0 0 20 20\\" fill=\\"none\\">\\r\\n        <path d=\\"M5 7.5l5 5 5-5\\" stroke=\\"currentColor\\" stroke-width=\\"2\\" stroke-linecap=\\"round\\" stroke-linejoin=\\"round\\"/>\\r\\n      </svg>\\r\\n      <div class=\\"mod-prog-bar\\"><div class=\\"mod-prog-fill\\" style=\\"width:${pct}%\\"></div></div>\\r\\n    </div>\\r\\n    <div class=\\"lessons-wrap\\">\\r\\n      ${guides.map(g => buildLessonRow(g)).join(\'\')}\\r\\n    </div>`;\\r\\n\\r\\n      return block;\\r\\n    }\\r\\n\\r\\n    // ─────────────────────────────────────────────\\r\\n    // PROGRESSO DE LEITURA (trilha e lista)\\r\\n    // ─────────────────────────────────────────────\\r\\n    // Quanto do guia já foi lido, de 0 a 1. Guia marcado como lido vale 1\\r\\n    // mesmo sem posição salva: dá pra marcar pelo botão sem rolar até o fim.\\r\\n    function guideReadFraction(guideId) {\\r\\n      if (readGuides.has(guideId)) return 1;\\r\\n      const fraction = readerScrollPositions[guideId];\\r\\n      return typeof fraction === \'number\' && fraction > 0 ? Math.min(1, fraction) : 0;\\r\\n    }\\r\\n\\r\\n    // O nó mede 62px de fora a fora (box-sizing: border-box, os 4px de borda\\r\\n    // branca já estão dentro). Raio 32 põe o anel encostado nessa borda, sem\\r\\n    // a folga de halo solto que r maior cria.\\r\\n    const JOURNEY_RING_RADIUS = 32;\\r\\n    const JOURNEY_RING_LENGTH = 2 * Math.PI * JOURNEY_RING_RADIUS;\\r\\n\\r\\n    // Anel que mostra o quanto do guia ela já leu. Só é chamado para guia\\r\\n    // começado e ainda não concluído — concluído já é a bolinha teal cheia.\\r\\n    function journeyNodeRingHTML(fraction) {\\r\\n      const clamped = Math.min(1, Math.max(0, fraction));\\r\\n      const offset = JOURNEY_RING_LENGTH * (1 - clamped);\\r\\n      return `<svg class=\\"journey-node-ring\\" width=\\"70\\" height=\\"70\\" viewBox=\\"0 0 70 70\\" aria-hidden=\\"true\\">\\r\\n      <circle cx=\\"35\\" cy=\\"35\\" r=\\"${JOURNEY_RING_RADIUS}\\" fill=\\"none\\" stroke=\\"#e3ddd4\\" stroke-width=\\"3\\"></circle>\\r\\n      <circle cx=\\"35\\" cy=\\"35\\" r=\\"${JOURNEY_RING_RADIUS}\\" fill=\\"none\\" stroke=\\"#1ABC9C\\" stroke-width=\\"3\\"\\r\\n        stroke-linecap=\\"round\\" stroke-dasharray=\\"${JOURNEY_RING_LENGTH.toFixed(2)}\\"\\r\\n        stroke-dashoffset=\\"${offset.toFixed(2)}\\" transform=\\"rotate(-90 35 35)\\"></circle>\\r\\n    </svg>`;\\r\\n    }\\r\\n\\r\\n    // Linha de progresso no rodapé da linha do guia, na visão em lista.\\r\\n    function lessonProgressHTML(guideId) {\\r\\n      const fraction = guideReadFraction(guideId);\\r\\n      if (fraction <= 0) return \'\';\\r\\n      return `<div class=\\"lesson-prog\\"><div class=\\"lesson-prog-fill\\" style=\\"width:${(fraction * 100).toFixed(1)}%\\"></div></div>`;\\r\\n    }\\r\\n\\r\\n    // Repinta tudo que mostra progresso. Sai daqui tanto o marcar/desmarcar\\r\\n    // quanto a saída do leitor com uma fração nova.\\r\\n    function refreshProgressViews() {\\r\\n      renderCourseModules();\\r\\n      updateProgress();\\r\\n      renderJourney();\\r\\n      renderJourneyHome();\\r\\n    }\\r\\n\\r\\n    function nextUnreadGuideId() {\\n      const next = curriculumOrder().find(item => item.kind === \'guide\' && \u0021readGuides.has(item.id));\\n      return next ? next.id : null;\\n    }\\n\\n    function guideStatusTag(guide, isCurrent, className) {\\n      const done = readGuides.has(guide.id);\\n      if (\u0021done && \u0021isCurrent) return \'\';\\n      const label = done ? guideLabel(\'guideRead\', \'Read\') : guideLabel(\'guideStart\', \'Start\');\\n      return `<span class=\\"${className}\\">${_escapeHtml(label)}</span>`;\\n    }\\n\\n    function buildLessonRow(guide) {\\n      const done = readGuides.has(guide.id);\\r\\n      const icColor = done ? \'#1ABC9C\' : undefined;\\r\\n      return `<div class=\\"lesson-row${done ? \' completed\' : (guide.id === nextUnreadGuideId() ? \' is-next\' : \'\')}\\" onclick=\\"openGuide(\'${guide.id}\')\\">\\n    <div class=\\"lesson-em\\">${guideIconBadgeHTML(guide, 20, 36)}</div>\\n    <div class=\\"lesson-body\\">\\r\\n      <div class=\\"lesson-title\\">${guide.title}${guideStatusTag(guide, guide.id === nextUnreadGuideId(), \'lesson-current-badge\')}</div>\\n      <div class=\\"lesson-time\\">⏱ ${guide.readTime}</div>\\r\\n    </div>\\r\\n    <div class=\\"lesson-check\\">\\r\\n      <svg class=\\"lesson-check-svg\\" width=\\"12\\" height=\\"12\\" viewBox=\\"0 0 12 12\\" fill=\\"none\\">\\r\\n        <path d=\\"M2 6l3 3 5-5\\" stroke=\\"#fff\\" stroke-width=\\"2\\" stroke-linecap=\\"round\\" stroke-linejoin=\\"round\\"/>\\r\\n      </svg>\\r\\n    </div>\\r\\n    ${lessonProgressHTML(guide.id)}\\r\\n  </div>`;\\r\\n    }\\r\\n\\r\\n    // Linha de guia na visão \\"lista\\" da jornada — igual à lesson-row do\\r\\n    // accordion de temas, mas com selo \\"Continuar aqui\\" no próximo guia não lido\\r\\n    // e um fromTag próprio (o botão de voltar do leitor precisa saber se veio\\r\\n    // da Home ou da trilha completa).\\r\\n    function buildJourneyListRow(guide, isCurrent, fromTag) {\\r\\n      const done = readGuides.has(guide.id);\\r\\n      const icColor = done ? \'#1ABC9C\' : undefined;\\r\\n      return `<div class=\\"lesson-row${done ? \' completed\' : (isCurrent ? \' is-next\' : \'\')}\\" onclick=\\"openGuide(\'${guide.id}\', \'${fromTag}\')\\">\\n    <div class=\\"lesson-em\\">${guideIconBadgeHTML(guide, 20, 36)}</div>\\n    <div class=\\"lesson-body\\">\\r\\n      <div class=\\"lesson-title\\">${guide.title}${guideStatusTag(guide, isCurrent, \'lesson-current-badge\')}</div>\\n      <div class=\\"lesson-time\\">⏱ ${guide.readTime}</div>\\r\\n    </div>\\r\\n    <div class=\\"lesson-check\\">\\r\\n      <svg class=\\"lesson-check-svg\\" width=\\"12\\" height=\\"12\\" viewBox=\\"0 0 12 12\\" fill=\\"none\\">\\r\\n        <path d=\\"M2 6l3 3 5-5\\" stroke=\\"#fff\\" stroke-width=\\"2\\" stroke-linecap=\\"round\\" stroke-linejoin=\\"round\\"/>\\r\\n      </svg>\\r\\n    </div>\\r\\n    ${lessonProgressHTML(guide.id)}\\r\\n  </div>`;\\r\\n    }\\r\\n\\r\\n    // Linha de quiz na visão em lista — mesmo layout da lesson-row, mas com\\r\\n    // fundo lilás, tag \\"Quiz\\" e um botão \\"Jogar\\" no lugar do check de lido,\\r\\n    // pra não ser confundida com um guia comum.\\r\\n    // Mesma lógica do puxadinho da jornada: a linha do quiz vem logo abaixo da\\r\\n    // do guia, então o assunto já está dito na linha de cima. O título do quiz\\r\\n    // aqui seria a mesma confusão de \\"isso é sobre o quê?\\" — a linha só diz\\r\\n    // que aquele guia tem um quiz, e quantas perguntas ele tem.\\r\\n    function buildJourneyQuizListRow(quiz, isCurrent) {\\r\\n      const done = completedQuizzes.has(quiz.id);\\r\\n      // A linha é recuada e o título é só \\"Quiz\\": ela vem sempre logo abaixo da\\r\\n      // linha do guia, e o selo à esquerda já diz o que é. \\"Quiz deste guia\\"\\r\\n      // repetido em toda linha virava enchimento — o recuo faz o mesmo trabalho\\r\\n      // sem palavra nenhuma, igual ao puxadinho da jornada.\\r\\n      return `<div class=\\"lesson-row quiz-row is-annex${done ? \' completed\' : \'\'}\\" onclick=\\"openQuizPlay(\'${quiz.id}\')\\">\\r\\n    <div class=\\"lesson-em quiz-em${done ? \' done\' : \'\'}\\"><span class=\\"quiz-em-text\\">Quiz</span></div>\\r\\n    <div class=\\"lesson-body\\">\\r\\n      <div class=\\"lesson-title\\">${quiz.questions} perguntas${isCurrent ? \'<span class=\\"lesson-current-badge\\">Continuar aqui</span>\' : \'\'}</div>\\r\\n    </div>\\r\\n    <div class=\\"lesson-check\\">\\r\\n      <svg class=\\"lesson-check-svg\\" width=\\"12\\" height=\\"12\\" viewBox=\\"0 0 12 12\\" fill=\\"none\\">\\r\\n        <path d=\\"M2 6l3 3 5-5\\" stroke=\\"#fff\\" stroke-width=\\"2\\" stroke-linecap=\\"round\\" stroke-linejoin=\\"round\\"/>\\r\\n      </svg>\\r\\n    </div>\\r\\n  </div>`;\\r\\n    }\\r\\n\\r\\n    // Nó de quiz na visão em mapa — quadrado (os guias são círculos), com o\\r\\n    // texto \\"Quiz\\" no lugar de um emoji e sem o zigue-zague da trilha (fica\\r\\n    // centralizado). Segue a mesma lógica de estado dos guias (upcoming/\\r\\n    // current/done), então também pode virar o \\"Começar\\" da vez — não fica\\r\\n    // fora do fluxo, só visualmente diferenciado por forma.\\r\\n    // O quiz na trilha é um PUXADINHO do guia acima, não um item com vida\\r\\n    // própria. Por isso não leva título aqui: como todo guia tem o seu quiz,\\r\\n    // um nome próprio (\\"Quem manda no prato?\\") só criava a dúvida \\"de que\\r\\n    // assunto é isso?\\" e empilhava três linhas de texto num nó secundário.\\r\\n    // Quem já leu o nome do guia logo acima não precisa de mais nada — o\\r\\n    // título com graça continua existindo, mas na abertura do quiz, que é\\r\\n    // onde ele serve pra convencer a jogar.\\r\\n    function buildJourneyQuizNode(quiz, isCurrent) {\\r\\n      const done = completedQuizzes.has(quiz.id);\\r\\n      const state = done ? \'done\' : (isCurrent ? \'current\' : \'upcoming\');\\r\\n      return `\\r\\n        <div class=\\"journey-quiz-node ${state}\\" onclick=\\"openQuizPlay(\'${quiz.id}\')\\">\\r\\n          ${isCurrent ? \'<div class=\\"journey-node-label\\">Começar</div>\' : \'\'}\\r\\n          <span class=\\"journey-quiz-node-text\\">Quiz</span>\\r\\n          ${done ? `<div class=\\"journey-node-check\\">${iconHTML(\'check-badge\', 12)}</div>` : \'\'}\\r\\n        </div>\\r\\n      `;\\r\\n    }\\r\\n\\r\\n    function toggleModule(key) {\\r\\n      moduleState[key] = \u0021moduleState[key];\\r\\n      const block = document.getElementById(\'module-\' + key);\\r\\n      if (block) block.classList.toggle(\'open\', moduleState[key]);\\r\\n    }\\r\\n\\r\\n    // ─────────────────────────────────────────────\\r\\n    // JORNADA GAMIFICADA (experimental)\\r\\n    // Trilha estilo Duolingo com TODOS os guias do app, em ordem de currículo\\r\\n    // (Fundamentos primeiro, depois cada fase etária, sem repetir guias).\\r\\n    // Não substitui a lista/acordeão de hoje — é uma visão alternativa.\\r\\n    // ─────────────────────────────────────────────\\r\\n    const PHASE_LABELS = {\\r\\n      \\"5\\": { icon: \'leaf\', label: \'0 a 5 meses\' },\\r\\n      \\"6\\": { icon: \'leaf\', label: \'6 meses - início da IA\' },\\r\\n      \\"7\\": { icon: \'leaf\', label: \'7 meses\' },\\r\\n      \\"8\\": { icon: \'leaf\', label: \'8 meses\' },\\r\\n      \\"9\\": { icon: \'leaf\', label: \'9 meses\' },\\r\\n      \\"10\\": { icon: \'leaf\', label: \'10 meses\' },\\r\\n      \\"11\\": { icon: \'leaf\', label: \'11 meses\' },\\r\\n      \\"12\\": { icon: \'leaf\', label: \'12 meses - 24 meses\' },\\r\\n      \\"24\\": { icon: \'leaf\', label: \'2 anos em diante\' },\\r\\n    };\\r\\n\\r\\n    // Lista única e ordenada de todos os guias do app (currículo completo)\\r\\n    const ALL_GUIDES_FLAT = (function () {\\r\\n      const seen = new Set();\\r\\n      const arr = [];\\r\\n      FUNDAMENTALS.forEach(g => { if (\u0021seen.has(g.id)) { seen.add(g.id); arr.push(g); } });\\r\\n      // Praticidade (atemporal) logo depois dos Fundamentos — mesma posição\\r\\n      // da seção na trilha visual, pra \\"Continuar aqui\\"/progresso baterem\\r\\n      // com o que a usuária vê.\\r\\n      AGELESS_GUIDES.forEach(g => { if (\u0021seen.has(g.id)) { seen.add(g.id); arr.push(g); } });\\r\\n      Object.keys(GUIDES_DATA).forEach(key => {\\r\\n        GUIDES_DATA[key].forEach(g => {\\r\\n          if (\u0021seen.has(g.id)) { seen.add(g.id); arr.push(g); }\\r\\n        });\\r\\n      });\\r\\n      return arr;\\r\\n    })();\\r\\n\\r\\n    // Sequência combinada de guias + quizzes, na mesma ordem em que aparecem\\r\\n    // na trilha (cada quiz entra logo após o guia do mesmo assunto) — usada\\r\\n    // pra calcular \\"o que vem a seguir\\" incluindo os quizzes no fluxo, não só\\r\\n    // guias (senão o quiz fica pulado, sem nunca virar o \\"Começar\\" da vez).\\r\\n    const ALL_ITEMS_FLAT = (function () {\\r\\n      const arr = [];\\r\\n      // Um quiz que serve dois guias (texto duplicado) aparece na trilha duas\\r\\n      // vezes de propósito, mas aqui só pode contar UMA: senão ele infla o\\r\\n      // total do progresso e uma partida marca duas conclusões.\\r\\n      const vistos = new Set();\\r\\n      ALL_GUIDES_FLAT.forEach(g => {\\r\\n        arr.push({ id: g.id, kind: \'guide\' });\\r\\n        const quizzes = QUIZ_BY_GUIDE_ID[g.id];\\r\\n        if (\u0021quizzes) return;\\r\\n        quizzes.forEach(q => {\\r\\n          if (vistos.has(q.id)) return;\\r\\n          vistos.add(q.id);\\r\\n          arr.push({ id: q.id, kind: \'quiz\' });\\r\\n        });\\r\\n      });\\r\\n      return arr;\\r\\n    })();\\r\\n\\r\\n    function isItemDone(item) {\\r\\n      return item.kind === \'guide\' ? readGuides.has(item.id) : completedQuizzes.has(item.id);\\r\\n    }\\r\\n\\r\\n    // Ordem canônica do currículo: a MESMA em que a jornada desenha os itens\\r\\n    // (fases por idade), com o quiz de cada guia logo depois dele.\\r\\n    //\\r\\n    // Não use ALL_ITEMS_FLAT pra decidir \\"o que vem a seguir\\": ele segue a ordem\\r\\n    // de ALL_GUIDES_FLAT, que DIVERGE da trilha. Os três guias `atemporal-*`\\r\\n    // vêm antes no array e depois na trilha, então o \\"Começar\\" caía neles e\\r\\n    // aparecia embaixo de três guias não lidos — a usuária lia isso como \\"o app\\r\\n    // pulou um monte de guias que eu não tinha lido\\" (relatado em 09/09/2026).\\r\\n    // ALL_ITEMS_FLAT continua servindo pra CONTAGEM, onde ordem não importa.\\r\\n    function curriculumOrder() {\\r\\n      const arr = [];\\r\\n      const vistos = new Set();\\r\\n      buildPhaseSections().forEach(sec => {\\r\\n        (sec.guides || []).forEach(g => {\\r\\n          arr.push({ id: g.id, kind: \'guide\' });\\r\\n          (QUIZ_BY_GUIDE_ID[g.id] || []).forEach(q => {\\r\\n            if (vistos.has(q.id)) return;\\r\\n            vistos.add(q.id);\\r\\n            arr.push({ id: q.id, kind: \'quiz\' });\\r\\n          });\\r\\n        });\\r\\n      });\\r\\n      return arr;\\r\\n    }\\r\\n\\r\\n    let journeyReturnScreen = \'guides\'; // para onde o botão de voltar da Jornada leva (age ou guides)\\r\\n    function openJourney() {\\r\\n      const active = document.querySelector(\'.screen.active\');\\r\\n      journeyReturnScreen = active ? active.id.replace(\'screen-\', \'\') : \'guides\';\\r\\n      renderJourney();\\r\\n      showScreen(\'journey\');\\r\\n    }\\r\\n\\r\\n    // Vitrine de quizzes — acessível pelo convite na seção atemporal da\\r\\n    // trilha (Home ou Jornada completa). Ainda sem motor de jogo: só a\\r\\n    // navegação/entrada, o \\"Jogar\\" em si vem depois.\\r\\n    // Abre a página de exemplo do quiz individual (sem motor de jogo ainda —\\r\\n    // só o botão de marcar como concluído, pra dar pra ver o estado feito).\\r\\n    // `fromTag` (o mesmo usado por openGuide) não serve aqui como id de tela —\\r\\n    // \\"journey-home\\"/\\"journey\\" são tokens do goBack() do leitor, não ids reais\\r\\n    // — por isso o retorno sempre olha pra tela ativa no momento do clique.\\r\\n    let quizReturnScreen = \'age\';\\r\\n    function openQuizPlay(quizId) {\\r\\n      const quiz = QUIZ_BY_ID[quizId];\\r\\n      if (\u0021quiz) return;\\r\\n      const active = document.querySelector(\'.screen.active\');\\r\\n      const from = active ? active.id.replace(\'screen-\', \'\') : \'age\';\\r\\n      // Abrir um quiz já estando num quiz não pode virar o destino do \\"voltar\\",\\r\\n      // senão o botão de sair passa a recarregar a própria tela.\\r\\n      if (from \u0021== \'quiz-play\') quizReturnScreen = from;\\r\\n      currentQuizId = quizId;\\r\\n\\r\\n      const content = QUIZ_CONTENT[quizId];\\r\\n      hideQuizFeedback(true);\\r\\n      quizRun = null;\\r\\n\\r\\n      if (\u0021content) {\\r\\n        // Sem perguntas escritas ainda: cai na página de exemplo antiga.\\r\\n        document.getElementById(\'quiz-play-title\').textContent = quiz.title;\\r\\n        document.getElementById(\'quiz-play-questions\').textContent = `${quiz.questions} ${guideLabel(\'questions\', \'perguntas\')}`;\\r\\n        renderQuizPlayButton();\\r\\n        setQuizStage(\'soon\');\\r\\n        showScreen(\'quiz-play\');\\r\\n        return;\\r\\n      }\\r\\n\\r\\n      renderQuizIntro(quiz, content);\\r\\n      setQuizStage(\'intro\');\\r\\n      showScreen(\'quiz-play\');\\r\\n    }\\r\\n\\r\\n    let currentQuizId = null;\\r\\n    function renderQuizPlayButton() {\\r\\n      const btn = document.getElementById(\'btn-mark-quiz-done\');\\r\\n      if (\u0021btn || \u0021currentQuizId) return;\\r\\n      const done = completedQuizzes.has(currentQuizId);\\r\\n      btn.textContent = done ? guideLabel(\'alreadyCompleted\', \'✓ Já concluído\u0021\') : guideLabel(\'markCompleted\', \'✓ Marcar como concluído\');\\r\\n      btn.className = \'btn-read\' + (done ? \' done\' : \'\');\\r\\n    }\\r\\n\\r\\n    // ═════════════════════════════════════════════\\r\\n    // MOTOR DO QUIZ\\r\\n    // ═════════════════════════════════════════════\\r\\n    // Não existe pontuação: um número abstrato (\\"225 pontos\\") não diz nada que\\r\\n    // a pessoa possa usar. O que conta é o que ela entende — acertos sobre o\\r\\n    // total, sequência e o selo do fim. O recorde a bater é em ACERTOS.\\r\\n    // Fração de acertos que destrava a bônus. Era um número fixo (6), o que\\r\\n    // tornava a bônus impossível num quiz de 5 perguntas. Como fração dá 6 de 8\\r\\n    // (o mesmo de antes) e 4 de 5.\\r\\n    const QUIZ_BONUS_UNLOCK_RATIO = 0.75;\\r\\n\\r\\n    let quizRun = null;\\r\\n\\r\\n    function setQuizStage(name) {\\r\\n      [\'intro\', \'play\', \'result\', \'soon\'].forEach(s => {\\r\\n        document.getElementById(\'quiz-stage-\' + s).classList.toggle(\'on\', s === name);\\r\\n      });\\r\\n      // A barra segmentada só faz sentido durante a partida.\\r\\n      const playing = name === \'play\' || name === \'result\';\\r\\n      document.getElementById(\'quiz-seg-track\').style.visibility = playing ? \'visible\' : \'hidden\';\\r\\n    }\\r\\n\\r\\n    function renderQuizIntro(quiz, content) {\\r\\n      document.getElementById(\'quiz-intro-title\').textContent = content.intro.title;\\r\\n      document.getElementById(\'quiz-intro-sub\').textContent = content.intro.sub;\\r\\n      document.getElementById(\'quiz-intro-qcount\').textContent = content.questions.length;\\r\\n\\r\\n      // Quem já jogou não recebe o mesmo convite de quem nunca jogou: aparece o\\r\\n      // cartão do recorde e o botão vira \\"bater meu recorde\\". É o gancho de\\r\\n      // VAIDADE que traz de volta — e a garantia de que o resultado dela não\\r\\n      // se perde quando ela sai da tela.\\r\\n      const best = quizScores[quiz.id];\\r\\n      const btn = document.getElementById(\'btn-quiz-start\');\\r\\n      const card = document.getElementById(\'quiz-done-card\');\\r\\n\\r\\n      if (best) {\\r\\n        card.style.display = \'flex\';\\r\\n        const perfeito = best.hits >= best.total;\\r\\n        // Zero acerto é o único caso em que a linguagem de recorde vira\\r\\n        // crueldade: \\"melhor resultado: 0 de 5\\" e \\"bater meu recorde (0 de 5)\\"\\r\\n        // sublinham o fracasso justo pra quem mais precisa de convite.\\r\\n        const zerado = best.hits === 0;\\r\\n        const vezes = best.plays > 1 ? ` · ${best.plays}ª tentativa` : \'\';\\r\\n        document.getElementById(\'quiz-done-title\').textContent =\\r\\n          perfeito ? \'Você zerou este quiz 🏆\'\\r\\n            : zerado ? \'Você já jogou este quiz\'\\r\\n              : \'Você já fez este quiz ✓\';\\r\\n        document.getElementById(\'quiz-done-stats\').innerHTML =\\r\\n          zerado\\r\\n            ? `Esse tema ainda é novo pra você - e é exatamente pra isso que serve${vezes}`\\r\\n            : `Melhor resultado: <b>${best.hits} de ${best.total}</b>${vezes}`;\\r\\n        btn.textContent = perfeito ? \'Jogar de novo\'\\r\\n          : zerado ? \'Tentar de novo\'\\r\\n            : `Bater meu recorde (${best.hits} de ${best.total})`;\\r\\n      } else {\\r\\n        card.style.display = \'none\';\\r\\n        btn.textContent = guideLabel(\'startQuiz\', \'Bora começar\');\\r\\n      }\\r\\n\\r\\n      // O atalho pro guia só aparece se o quiz aponta pra um guia de verdade.\\r\\n      const guideBtn = document.getElementById(\'btn-quiz-read-guide\');\\r\\n      guideBtn.style.display = content.sourceGuideId ? \'block\' : \'none\';\\r\\n    }\\r\\n\\r\\n\\r\\n    function openQuizSourceGuide() {\\r\\n      const content = QUIZ_CONTENT[currentQuizId];\\r\\n      if (\u0021content || \u0021content.sourceGuideId) return;\\r\\n      openGuide(content.sourceGuideId, quizReturnScreen);\\r\\n    }\\r\\n\\r\\n    function startQuizRun() {\\r\\n      const content = QUIZ_CONTENT[currentQuizId];\\r\\n      if (\u0021content) return;\\r\\n      quizRun = {\\r\\n        content: content,\\r\\n        list: content.questions.slice(),\\r\\n        idx: 0,\\r\\n        hits: 0,      // todos os acertos, bônus incluso (alimenta a sequência)\\r\\n        baseHits: 0,  // só as perguntas normais — é o que vira \\"X/8\\" e define o selo\\r\\n        streak: 0,\\r\\n        maxStreak: 0,\\r\\n        answers: [],\\r\\n        bonusPlayed: false,\\r\\n        bonusHit: false\\r\\n      };\\r\\n      renderQuizSegments();\\r\\n      setQuizStage(\'play\');\\r\\n      renderQuizQuestion();\\r\\n    }\\r\\n\\r\\n    function restartQuiz() {\\r\\n      hideQuizFeedback(true);\\r\\n      startQuizRun();\\r\\n    }\\r\\n\\r\\n    function exitQuiz() {\\r\\n      hideQuizFeedback(true);\\r\\n      showScreen(quizReturnScreen || \'age\');\\r\\n    }\\r\\n\\r\\n    // Um traço por pergunta, pintado conforme ela responde. A pergunta bônus\\r\\n    // ganha um traço extra que só aparece quando é desbloqueada — ver o traço\\r\\n    // surgir É a recompensa visual do desbloqueio.\\r\\n    function renderQuizSegments() {\\r\\n      if (\u0021quizRun) return;\\r\\n      const track = document.getElementById(\'quiz-seg-track\');\\r\\n      track.innerHTML = quizRun.list.map((q, i) => {\\r\\n        let cls = \'\';\\r\\n        const a = quizRun.answers[i];\\r\\n        if (a) cls = a.correct ? \' hit\' : \' miss\';\\r\\n        else if (i === quizRun.idx) cls = \' now\';\\r\\n        return `<div class=\\"quiz-seg${cls}\\"></div>`;\\r\\n      }).join(\'\');\\r\\n    }\\r\\n\\r\\n    function renderQuizQuestion() {\\r\\n      if (\u0021quizRun) return;\\r\\n      const q = quizRun.list[quizRun.idx];\\r\\n      if (\u0021q) return finishQuiz();\\r\\n\\r\\n      document.getElementById(\'quiz-q-tag-slot\').innerHTML =\\r\\n        `<span class=\\"quiz-q-tag ${q.tagKind || \'quiz\'}\\">${q.tagText}</span>`;\\r\\n      document.getElementById(\'quiz-scene-slot\').innerHTML =\\r\\n        q.scene ? `<div class=\\"quiz-scene\\">${q.scene}</div>` : \'\';\\r\\n      // o fio laranja lateral só existe quando a pergunta tem cena\\r\\n      document.getElementById(\'quiz-q-block\').classList.toggle(\'has-cena\', \u0021\u0021q.scene);\\r\\n      document.getElementById(\'quiz-q-text\').innerHTML = q.text;\\r\\n\\r\\n      const letters = [\'A\', \'B\', \'C\', \'D\', \'E\'];\\r\\n      document.getElementById(\'quiz-options\').innerHTML = q.options.map((opt, i) =>\\r\\n        `<button class=\\"quiz-opt\\" data-i=\\"${i}\\" onclick=\\"answerQuiz(${i})\\">\\r\\n           <span class=\\"quiz-opt-key\\">${letters[i]}</span><span>${opt}</span>\\r\\n         </button>`\\r\\n      ).join(\'\');\\r\\n\\r\\n      renderQuizSegments();\\r\\n      scrollContainerTo(0);\\r\\n    }\\r\\n\\r\\n    // Um lugar só decide se o bônus entra: `finishQuiz()` para desbloquear de\\r\\n    // fato e `showQuizFeedback()` para rotular o botão. Duplicar a conta faria o\\r\\n    // botão prometer \\"Ver meu resultado\\" e entregar mais uma pergunta.\\r\\n    function quizBonusUnlocksNow() {\\r\\n      if (\u0021quizRun) return false;\\r\\n      const content = quizRun.content;\\r\\n      return \u0021\u0021(content.bonus && \u0021quizRun.bonusPlayed &&\\r\\n        quizRun.baseHits >= Math.ceil(content.questions.length * QUIZ_BONUS_UNLOCK_RATIO));\\r\\n    }\\r\\n\\r\\n    function answerQuiz(i) {\\r\\n      if (\u0021quizRun) return;\\r\\n      const q = quizRun.list[quizRun.idx];\\r\\n      if (\u0021q || quizRun.answers[quizRun.idx]) return; // já respondeu\\r\\n\\r\\n      const correct = i === q.correct;\\r\\n\\r\\n      // Trava as opções e revela a certa junto com a escolhida. Mostrar a\\r\\n      // resposta certa SEMPRE (mesmo quando ela erra) é o que mantém a\\r\\n      // promessa de SEGURANÇA feita na abertura.\\r\\n      document.querySelectorAll(\'#quiz-options .quiz-opt\').forEach((btn, bi) => {\\r\\n        btn.disabled = true;\\r\\n        if (bi === q.correct) btn.classList.add(\'right\');\\r\\n        else if (bi === i) btn.classList.add(\'wrong\');\\r\\n        else btn.classList.add(\'dim\');\\r\\n      });\\r\\n\\r\\n      if (correct) {\\r\\n        quizRun.hits++;\\r\\n        if (q.isBonus) quizRun.bonusHit = true; else quizRun.baseHits++;\\r\\n        quizRun.streak++;\\r\\n        quizRun.maxStreak = Math.max(quizRun.maxStreak, quizRun.streak);\\r\\n      } else {\\r\\n        quizRun.streak = 0;\\r\\n      }\\r\\n\\r\\n      quizRun.answers[quizRun.idx] = { correct: correct, chosen: i };\\r\\n      renderQuizSegments();\\r\\n      showQuizFeedback(q, correct);\\r\\n    }\\r\\n\\r\\n    // Texto da sequência — vira um selo DENTRO da gaveta de devolutiva, não um\\r\\n    // balão flutuante: flutuando ele cobria a tag da pergunta e, no fim, o\\r\\n    // próprio card de resultado. Só existe a partir do 2º acerto seguido; se\\r\\n    // aparecesse no primeiro, não seria conquista nenhuma.\\r\\n    function quizStreakLabel(n) {\\r\\n      const msgs = {\\r\\n        2: \'🔥 2 seguidas\',\\r\\n        3: \'🔥 3 seguidas - pegando fogo\',\\r\\n        4: \'🔥 4 seguidas, quem é você?\',\\r\\n        5: \'⚡ 5 seguidas. Sério.\',\\r\\n        6: \'⚡ 6 seguidas, imparável\',\\r\\n        7: \'👑 7 seguidas - realeza\',\\r\\n        8: \'👑 8 seguidas. PERFEITO.\'\\r\\n      };\\r\\n      return msgs[n] || `🔥 ${n} seguidas`;\\r\\n    }\\r\\n\\r\\n    function showQuizFeedback(q, correct) {\\r\\n      const fb = document.getElementById(\'quiz-feedback\');\\r\\n      fb.classList.toggle(\'ok\', correct);\\r\\n      fb.classList.toggle(\'no\', \u0021correct);\\r\\n      document.getElementById(\'quiz-fb-mark\').textContent = correct ? \'✓\' : \'\u0021\';\\r\\n      document.getElementById(\'quiz-fb-title\').textContent =\\r\\n        correct ? q.rightTitle : q.wrongTitle;\\r\\n      document.getElementById(\'quiz-fb-body\').innerHTML = q.why;\\r\\n\\r\\n      const streak = document.getElementById(\'quiz-fb-streak\');\\r\\n      const showStreak = correct && quizRun.streak >= 2;\\r\\n      streak.textContent = showStreak ? quizStreakLabel(quizRun.streak) : \'\';\\r\\n      streak.style.display = showStreak ? \'inline-block\' : \'none\';\\r\\n\\r\\n      const did = document.getElementById(\'quiz-fb-did\');\\r\\n      did.innerHTML = q.did ? `<b>Sabia?</b> ${q.did}` : \'\';\\r\\n      did.style.display = q.did ? \'block\' : \'none\';\\r\\n\\r\\n      const belong = document.getElementById(\'quiz-fb-social\');\\r\\n      belong.innerHTML = q.belong ? `<span>♥</span> ${q.belong}` : \'\';\\r\\n      belong.style.display = q.belong ? \'flex\' : \'none\';\\r\\n\\r\\n      // Na última pergunta normal já se sabe se o bônus vai entrar, porque\\r\\n      // `baseHits` acabou de ser fechado em answerQuiz(). Anunciar isso aqui é o\\r\\n      // que evita a pessoa clicar em \\"Ver meu resultado\\" e cair noutra pergunta.\\r\\n      const isLast = quizRun.idx >= quizRun.list.length - 1;\\r\\n      const bonusVem = isLast && quizBonusUnlocksNow();\\r\\n      document.getElementById(\'btn-quiz-next\').textContent =\\r\\n        bonusVem ? \'Desbloquear pergunta bônus 🎁\'\\r\\n          : isLast ? \'Ver meu resultado\' : \'Continuar\';\\r\\n\\r\\n      // Guarda o rAF pra poder cancelar: sem isso, um \\"continuar\\" disparado no\\r\\n      // mesmo frame da resposta deixaria a gaveta subir DEPOIS de já ter sido\\r\\n      // fechada, e ela apareceria por cima da tela seguinte.\\r\\n      cancelAnimationFrame(quizFeedbackRaf);\\r\\n      quizFeedbackRaf = requestAnimationFrame(() => fb.classList.add(\'up\'));\\r\\n    }\\r\\n\\r\\n    let quizFeedbackRaf = 0;\\r\\n\\r\\n    function hideQuizFeedback(instant) {\\r\\n      const fb = document.getElementById(\'quiz-feedback\');\\r\\n      if (\u0021fb) return;\\r\\n      cancelAnimationFrame(quizFeedbackRaf);\\r\\n      fb.classList.remove(\'up\');\\r\\n      if (instant) fb.classList.remove(\'ok\', \'no\');\\r\\n    }\\r\\n\\r\\n    function nextQuizQuestion() {\\r\\n      hideQuizFeedback();\\r\\n      if (\u0021quizRun) return;\\r\\n      if (quizRun.idx >= quizRun.list.length - 1) return finishQuiz();\\r\\n      quizRun.idx++;\\r\\n      renderQuizQuestion();\\r\\n    }\\r\\n\\r\\n    function finishQuiz() {\\r\\n      if (\u0021quizRun) return;\\r\\n      const content = quizRun.content;\\r\\n\\r\\n      // Desbloqueio da pergunta bônus: só depois de fechar todas as normais e\\r\\n      // com 75%+ de acerto. Ela entra como uma pergunta extra na mesma partida,\\r\\n      // então o caminho de volta é o mesmo — nada de tela nova.\\r\\n      if (quizBonusUnlocksNow()) {\\r\\n        quizRun.bonusPlayed = true;\\r\\n        quizRun.list.push(Object.assign({ isBonus: true }, content.bonus));\\r\\n        quizRun.idx = quizRun.list.length - 1;\\r\\n        renderQuizSegments();\\r\\n        renderQuizQuestion();\\r\\n        showCelebration(\'🎁 Pergunta bônus desbloqueada\u0021\');\\r\\n        return;\\r\\n      }\\r\\n\\r\\n      const total = content.questions.length;\\r\\n      // O selo olha só pras perguntas normais: a bônus é prêmio, não prova.\\r\\n      const tier = (content.results || []).find(r => quizRun.baseHits >= r.min) ||\\r\\n        { tone: \'low\', title: \'Resultado\', sub: \'\' };\\r\\n\\r\\n      const card = document.getElementById(\'quiz-result-card\');\\r\\n      card.className = \'quiz-result-card\' + (tier.tone ? \' \' + tier.tone : \'\');\\r\\n      document.getElementById(\'quiz-result-title\').textContent = tier.title;\\r\\n      document.getElementById(\'quiz-result-sub\').textContent =\\r\\n        tier.sub + (quizRun.bonusHit ? \' E ainda matou a pergunta bônus. 🏆\' : \'\');\\r\\n      document.getElementById(\'quiz-result-hits\').textContent = `${quizRun.baseHits}/${total}`;\\r\\n      document.getElementById(\'quiz-result-streak\').textContent = quizRun.maxStreak;\\r\\n\\r\\n      renderQuizRecap();\\r\\n\\r\\n      // Recorde por quiz (VAIDADE + motivo pra voltar). Guarda só o MELHOR\\r\\n      // resultado, mas o contador de tentativas sempre sobe: assim a partida\\r\\n      // ruim de hoje nunca apaga o recorde de ontem.\\r\\n      const best = quizScores[currentQuizId];\\r\\n      const plays = (best && best.plays ? best.plays : 0) + 1;\\r\\n      const bateuRecorde = best && quizRun.baseHits > best.hits;\\r\\n      const recordeAnterior = best ? best.hits : 0;\\r\\n      if (\u0021best || quizRun.baseHits > best.hits) {\\r\\n        quizScores[currentQuizId] = {\\r\\n          hits: quizRun.baseHits, total: total, plays: plays\\r\\n        };\\r\\n      } else {\\r\\n        best.plays = plays;\\r\\n      }\\r\\n      // Bater o próprio recorde é a única coisa que merece ser dita antes do\\r\\n      // selo: é a recompensa de quem voltou.\\r\\n      if (bateuRecorde) {\\r\\n        const sub = document.getElementById(\'quiz-result-sub\');\\r\\n        sub.textContent = `🎉 Novo recorde\u0021 Você superou seus ${recordeAnterior} acertos anteriores. ` + sub.textContent;\\r\\n      }\\r\\n      // Jogou até o fim = concluído. Não exige nota mínima de propósito:\\r\\n      // travar a trilha por nota transformaria o quiz em prova.\\r\\n      completedQuizzes.add(currentQuizId);\\r\\n      saveReadGuides();\\r\\n      if (typeof renderJourneyHome === \'function\') renderJourneyHome();\\r\\n\\r\\n      setQuizStage(\'result\');\\r\\n      if (quizRun.baseHits >= total - 1) fireQuizConfetti();\\r\\n      scrollContainerTo(0);\\r\\n    }\\r\\n\\r\\n    // Recapitulação só do que ela errou: revisar 8 acertos é enfadonho, revisar\\r\\n    // 2 erros é útil. Zero erro vira uma linha de comemoração.\\r\\n    function renderQuizRecap() {\\r\\n      const wrap = document.getElementById(\'quiz-result-recap\');\\r\\n      const misses = quizRun.list\\r\\n        .map((q, i) => ({ q: q, a: quizRun.answers[i] }))\\r\\n        .filter(x => x.a && \u0021x.a.correct);\\r\\n\\r\\n      if (\u0021misses.length) {\\r\\n        wrap.innerHTML = `\\r\\n          <div class=\\"quiz-recap-title\\">Revisão</div>\\r\\n          <div class=\\"quiz-recap-item\\">\\r\\n            <div class=\\"quiz-recap-mark ok\\">✓</div>\\r\\n            <div class=\\"quiz-recap-text\\">\\r\\n              <span class=\\"quiz-recap-head\\">Nada a revisar.</span>\\r\\n              Você acertou tudo. Esse conteúdo já é seu - agora é só usar quando alguém questionar.\\r\\n            </div>\\r\\n          </div>`;\\r\\n        return;\\r\\n      }\\r\\n\\r\\n      wrap.innerHTML = `\\r\\n        <div class=\\"quiz-recap-title\\">${misses.length === 1 ? \'Guarde essa daqui\' : \'Guarde essas \' + misses.length + \' daqui\'}</div>\\r\\n        ` + misses.map(x => `\\r\\n          <div class=\\"quiz-recap-item\\">\\r\\n            <div class=\\"quiz-recap-mark no\\">\u0021</div>\\r\\n            <div class=\\"quiz-recap-text\\">\\r\\n              <span class=\\"quiz-recap-head\\">${x.q.tagText}</span>\\r\\n              ${x.q.why}\\r\\n            </div>\\r\\n          </div>`).join(\'\');\\r\\n    }\\r\\n\\r\\n    function fireQuizConfetti() {\\r\\n      const wrap = document.getElementById(\'quiz-confetti\');\\r\\n      if (\u0021wrap) return;\\r\\n      const cores = [\'#FFCF4E\', \'#F9A247\', \'#1ABC9C\', \'#3B82C4\', \'#EB5757\'];\\r\\n      wrap.innerHTML = Array.from({ length: 26 }, (_, i) =>\\r\\n        `<i style=\\"left:${Math.round(Math.random() * 100)}%;background:${cores[i % cores.length]};animation-delay:${(Math.random() * 0.7).toFixed(2)}s\\"></i>`\\r\\n      ).join(\'\');\\r\\n      setTimeout(() => { wrap.innerHTML = \'\'; }, 2600);\\r\\n    }\\r\\n\\r\\n    function toggleQuizComplete() {\\r\\n      if (\u0021currentQuizId) return;\\r\\n      if (completedQuizzes.has(currentQuizId)) {\\r\\n        completedQuizzes.delete(currentQuizId);\\r\\n      } else {\\r\\n        completedQuizzes.add(currentQuizId);\\r\\n      }\\r\\n      saveReadGuides();\\r\\n      renderQuizPlayButton();\\r\\n      // Reflete o novo estado (nó/linha \\"concluído\\") assim que ela voltar pra trilha.\\r\\n      if (typeof renderJourneyHome === \'function\') renderJourneyHome();\\r\\n    }\\r\\n\\r\\n    // Seções da JORNADA — só fases de idade, na ordem do currículo. \\"A Base do\\r\\n    // BLW\\" e \\"Praticidade\\" deixaram de ser seções próprias: as duas foram\\r\\n    // dissolvidas dentro de \\"0 a 5 meses\\", que agora é a porta de entrada da\\r\\n    // trilha (entender o método, decidir, preparar a cozinha). Toda fase\\r\\n    // carrega `phaseKey`, que é o que faz aparecer o marco \\"o que esperar\\".\\r\\n    function buildPhaseSections() {\\r\\n      if (contractJourneySections \u0021== null) return contractJourneySections;\\r\\n      const seen = new Set();\\r\\n      const sections = [];\\r\\n\\r\\n      Object.keys(GUIDES_DATA).forEach(key => {\\r\\n        const novos = GUIDES_DATA[key].filter(g => \u0021seen.has(g.id));\\r\\n        novos.forEach(g => seen.add(g.id));\\r\\n        if (novos.length > 0) {\\r\\n          const meta = PHASE_LABELS[key] || { icon: \'leaf\', label: key + \' meses\' };\\r\\n          sections.push({ icon: meta.icon, label: meta.label, guides: novos, phaseKey: key, key: key });\\r\\n        }\\r\\n      });\\r\\n      return sections;\\r\\n    }\\r\\n\\r\\n    // Abre a trilha já no nó do \\"Começar\\" (o próximo conteúdo sugerido), em vez\\r\\n    // de sempre no topo: quem já leu vários guias não deve ter que rolar a\\r\\n    // trilha inteira toda vez pra reencontrar o que ler agora.\\r\\n    //\\r\\n    // Deixa UM item acima do \\"Começar\\" à mostra, de propósito — assim ele não\\r\\n    // cola no topo e continua claro que existe trilha antes dele. Quando o\\r\\n    // \\"Começar\\" é o primeiro nó da seção (ou a seção está fechada), quem faz\\r\\n    // esse papel é a faixa da fase, que ainda mostra em que idade ela está.\\r\\n    //\\r\\n    // Adia um tique pra sair da mesma tarefa que acabou de mexer no DOM (a\\r\\n    // repintura da trilha, a troca de tela). Uma âncora por vez: showScreen e\\r\\n    // renderJourneyHome às vezes pedem a mesma rolagem no mesmo tique.\\r\\n    //\\r\\n    // setTimeout, e NÃO requestAnimationFrame: dentro do iframe do plugin o\\r\\n    // navegador estrangula o rAF quando considera o quadro não-renderizado, e\\r\\n    // aí o callback simplesmente nunca roda — medido, a âncora não disparava\\r\\n    // uma vez sequer. setTimeout dispara de qualquer jeito. Não faz falta\\r\\n    // esperar por pintura aqui: scrollIntoView já força o layout sozinho antes\\r\\n    // de calcular a posição.\\r\\n    let pathAnchorTimer = null;\\r\\n    function scrollPathToCurrent(pathEl) {\\r\\n      if (\u0021pathEl || \u0021JOURNEY_ANCHOR_ENABLED) return;\\r\\n      clearTimeout(pathAnchorTimer);\\r\\n      pathAnchorTimer = setTimeout(() => applyPathAnchor(pathEl), 0);\\r\\n    }\\r\\n\\r\\n    function applyPathAnchor(pathEl) {\\r\\n      // offsetParent nulo = trilha fora de vista (tela inativa, ou embed\\r\\n      // escondido pela busca na Home). Medir aí daria posição errada.\\r\\n      if (\u0021pathEl.offsetParent) return;\\r\\n      // A visão em lista agrupa por tema, não por idade, e abre do começo.\\r\\n      if (pathEl.classList.contains(\'list-mode\')) return;\\r\\n      // Trilha intocada abre do topo, como antes — não há o que reencontrar.\\r\\n      if (\u0021ALL_ITEMS_FLAT.some(isItemDone)) return;\\r\\n\\r\\n      const currentRow = pathEl.querySelector(\'.journey-node-row.is-current\');\\r\\n      if (\u0021currentRow) return; // tudo concluído: não existe \\"Começar\\" pra ancorar\\r\\n      const section = currentRow.closest(\'.journey-section\');\\r\\n      let target = currentRow.previousElementSibling;\\r\\n      if (\u0021target || (section && section.classList.contains(\'collapsed\'))) {\\r\\n        target = section && section.querySelector(\'.journey-section-banner\');\\r\\n      }\\r\\n      if (\u0021target) return;\\r\\n\\r\\n      // scrollIntoView, e NÃO window.scrollTo: dentro do BuildFire o plugin não\\r\\n      // tem scroll próprio. O iframe é esticado até a altura do conteúdo todo\\r\\n      // (medido: iframe 6015px, window.innerHeight 6015px, rolável por dentro\\r\\n      // ZERO) e quem rola é a página que hospeda o plugin. Um window.scrollTo\\r\\n      // daqui mira num scroller inexistente: não sai do lugar, e no WebView do\\r\\n      // iOS ainda trava o scroll de verdade. scrollIntoView sobe a cadeia de\\r\\n      // scrollers, atravessa a fronteira do iframe e rola quem realmente rola —\\r\\n      // seja a página pai no app, seja a janela quando o arquivo abre sozinho.\\r\\n      // O recuo do topo vem do CSS (scroll-margin-top), não de conta na mão,\\r\\n      // porque daqui não dá pra medir o cabeçalho de quem hospeda.\\r\\n      target.scrollIntoView({ block: \'start\' });\\r\\n    }\\r\\n\\r\\n    // Seções TEMÁTICAS — por tema (LIST_THEMES), sem `phaseKey`: aqui não se\\r\\n    // fala de idade, então nenhum marco \\"o que esperar dos X meses\\" entra.\\r\\n    // Alimenta a visão em lista da Home E o accordion de screen-guides\\r\\n    // (renderCourseModules), que é o que garante uma taxonomia só no app.\\r\\n    // Qualquer guia novo que ainda não esteja em LIST_THEMES cai num tema\\r\\n    // \\"Outros guias\\" no fim — nunca se esconde conteúdo por esquecimento de\\r\\n    // mapear, e a sobra fica visível pra ser classificada depois.\\r\\n    function buildThemeSections() {\\r\\n      const mapped = new Set();\\r\\n      const sections = LIST_THEMES.map(theme => {\\r\\n        theme.guides.forEach(g => mapped.add(g.id));\\r\\n        return {\\r\\n          icon: theme.icon,\\r\\n          label: theme.label,\\r\\n          subtitle: theme.subtitle,\\r\\n          guides: theme.guides,\\r\\n          key: theme.key\\r\\n        };\\r\\n      });\\r\\n\\r\\n      const sobra = ALL_GUIDES_FLAT.filter(g => \u0021mapped.has(g.id));\\r\\n      if (sobra.length) {\\r\\n        sections.push({ icon: \'book\', label: guideLabel(\'otherGuides\', \'Outros guias\'), subtitle: guideLabel(\'moreContent\', \'Mais conteúdos\'), guides: sobra, key: \'tema-outros\' });\\r\\n      }\\r\\n      return sections;\\r\\n    }\\r\\n\\r\\n    // Constrói a trilha completa (nós + faixas de seção) dentro de `pathEl`,\\r\\n    // atualizando opcionalmente uma barra/label de progresso. `fromTag` é\\r\\n    // passado a openGuide() para o botão de voltar do leitor saber para onde\\r\\n    // retornar (tela cheia da Jornada ou trilha embutida na home).\\r\\n    function paintJourney(pathEl, progLabelEl, progFillEl, fromTag, mode) {\\r\\n      if (\u0021pathEl) return;\\r\\n      mode = mode === \'list\' ? \'list\' : \'journey\';\\r\\n      pathEl.classList.toggle(\'list-mode\', mode === \'list\');\\r\\n\\r\\n      // A jornada agrupa por idade (fases); a lista agrupa por tema. São dois\\r\\n      // eixos diferentes de propósito — ver buildThemeSections/LIST_THEMES.\\r\\n      const sections = mode === \'list\' ? buildThemeSections() : buildPhaseSections();\\r\\n\\r\\n      // Próximo item não concluído (guia OU quiz) na ordem em que a trilha\\r\\n      // DESENHA — os quizzes entram no mesmo fluxo, senão ficam pulados e nunca\\r\\n      // viram o \\"Começar\\" da vez. A ordem vem de curriculumOrder(), não de\\r\\n      // ALL_ITEMS_FLAT: ver a nota lá sobre as duas ordens divergirem.\\r\\n      const curriculo = curriculumOrder();\\r\\n      let nextIdx = curriculo.findIndex(item => \u0021isItemDone(item));\\r\\n      if (nextIdx === -1) nextIdx = curriculo.length; // tudo concluído\\r\\n      // O selo \\"Continuar aqui\\" é o mesmo item nas duas visões. A lista reagrupa\\r\\n      // por tema, mas quem manda é a ordem da jornada (o currículo de verdade),\\r\\n      // então o alvo é comparado por id, não pela posição na seção.\\r\\n      const nextItemId = nextIdx < curriculo.length ? curriculo[nextIdx].id : null;\\n      const nextGuideId = nextUnreadGuideId();\\n\\r\\n      const doneCount = ALL_ITEMS_FLAT.filter(isItemDone).length;\\r\\n      const totalCount = ALL_ITEMS_FLAT.length;\\r\\n      const journeyPct = totalCount ? Math.round(doneCount / totalCount * 100) : 0;\\r\\n      if (progLabelEl) progLabelEl.innerHTML = `${iconHTML(plantStageIcon(journeyPct), 15)} ${doneCount} ${_escapeHtml(guideLabel(\'progressOf\', \'de\'))} ${totalCount}`;\\r\\n      if (progFillEl) progFillEl.style.width = journeyPct + \'%\';\\r\\n\\r\\n      pathEl.innerHTML = \'\';\\r\\n      // Contador só do zigue-zague da jornada (alimenta o Math.sin do offset).\\r\\n      // Não é mais posição no currículo — quem marca \\"o que vem a seguir\\" é\\r\\n      // nextItemId, por id, porque a lista reordena os guias por tema.\\r\\n      let globalIdx = 0;\\r\\n\\r\\n      sections.forEach(section => {\\r\\n        // Marco \\"O que esperar\\" da fase — não é um guia, então em vez de um\\r\\n        // cartão à parte (que competia visualmente com a faixa da seção), vive\\r\\n        // como uma segunda linha, mais discreta, dentro do mesmo cartão.\\r\\n        const summary = section.phaseKey && MONTHLY_SUMMARY[section.phaseKey];\\r\\n\\r\\n        // Cada seção fica dentro de um bloco recolhível — a usuária pode\\r\\n        // fechar seções que já leu (ex.: \\"A Base do BLW\\") para não ficar\\r\\n        // rolando por conteúdo que já viu. O título continua sempre visível;\\r\\n        // só os guias daquela seção somem quando ela está fechada. O estado\\r\\n        // é lembrado por usuária (collapsedJourneySections).\\r\\n        const isCollapsed = collapsedJourneySections.has(section.key);\\r\\n        const sectionWrap = document.createElement(\'div\');\\r\\n        sectionWrap.className = \'journey-section\' + (isCollapsed ? \' collapsed\' : \'\') + (mode === \'list\' ? \' list-mode\' : \'\');\\r\\n\\r\\n        const banner = document.createElement(\'div\');\\r\\n        banner.className = \'journey-section-banner\';\\r\\n        banner.innerHTML = `\\r\\n      <div class=\\"jsb-row\\">\\r\\n        ${mode === \'list\' ? \'\' : `<span class=\\"jsb-icon\\">${iconHTML(section.icon, 19)}</span>`}<span>${section.label}</span>\\r\\n        <svg class=\\"jsb-toggle\\" width=\\"16\\" height=\\"16\\" viewBox=\\"0 0 20 20\\" fill=\\"none\\">\\r\\n          <path d=\\"M5 7.5l5 5 5-5\\" stroke=\\"currentColor\\" stroke-width=\\"2\\" stroke-linecap=\\"round\\" stroke-linejoin=\\"round\\"/>\\r\\n        </svg>\\r\\n      </div>\\r\\n      ${section.subtitle ? `\\r\\n        <div class=\\"jsb-subtitle\\">\\r\\n          <span>${section.subtitle}</span>\\r\\n          <span class=\\"jsb-count\\">${section.guides.filter(g => readGuides.has(g.id)).length}/${section.guides.length}</span>\\r\\n        </div>` : \'\'}\\r\\n      ${summary ? `\\r\\n        <div class=\\"jsb-milestone\\">\\r\\n          <span class=\\"jsb-milestone-icon\\">${iconHTML(\'baby-face\', 16)}</span>\\r\\n          <span class=\\"jsb-milestone-text\\">${summary.title}</span>\\r\\n          <span class=\\"jsb-milestone-arrow\\">→</span>\\r\\n        </div>` : \'\'}\\r\\n    `;\\r\\n        if (summary) {\\r\\n          banner.querySelector(\'.jsb-milestone\').onclick = (e) => {\\r\\n            e.stopPropagation();\\r\\n            openMilestoneSheet(section.phaseKey);\\r\\n          };\\r\\n        }\\r\\n        banner.querySelector(\'.jsb-row\').onclick = () => {\\r\\n          const nowCollapsed = sectionWrap.classList.toggle(\'collapsed\');\\r\\n          if (nowCollapsed) collapsedJourneySections.add(section.key);\\r\\n          else collapsedJourneySections.delete(section.key);\\r\\n          saveReadGuides();\\r\\n          // Recolher/expandir muda a altura da trilha e some com nós inteiros:\\r\\n          // sem redesenhar, a curva continua com o traçado do estado anterior.\\r\\n          // Chamada direta, não em rAF: o toggle de `display` é síncrono e o\\r\\n          // getBoundingClientRect lá dentro já força o reflow. Via rAF isso\\r\\n          // ficaria refém do quadro seguinte — e rAF não dispara com a tela\\r\\n          // escondida, deixando a curva velha à espera de outro gatilho.\\r\\n          drawJourneyTrail(pathEl);\\r\\n        };\\r\\n        sectionWrap.appendChild(banner);\\r\\n\\r\\n        const body = document.createElement(\'div\');\\r\\n        body.className = \'journey-section-body\';\\r\\n\\r\\n        if (mode === \'list\') {\\r\\n          // Visão em lista: seções por tema, guias como lista compacta\\r\\n          // (lesson-row) em vez do mapa de nós. Quizzes relacionados\\r\\n          // (QUIZ_BY_GUIDE_ID) entram logo depois do guia do mesmo assunto,\\r\\n          // com visual próprio pra não parecer guia.\\r\\n          const listWrap = document.createElement(\'div\');\\r\\n          listWrap.className = \'journey-list-items\';\\r\\n          listWrap.innerHTML = section.guides.map(guide => {\\r\\n            let html = buildJourneyListRow(guide, guide.id === nextGuideId, fromTag);\\n            const relatedQuizzes = QUIZ_BY_GUIDE_ID[guide.id];\\r\\n            if (relatedQuizzes) {\\r\\n              html += relatedQuizzes.map(q => buildJourneyQuizListRow(q, q.id === nextItemId)).join(\'\');\\r\\n            }\\r\\n            return html;\\r\\n          }).join(\'\');\\r\\n          body.appendChild(listWrap);\\r\\n        } else {\\r\\n          section.guides.forEach(guide => {\\r\\n            const row = document.createElement(\'div\');\\r\\n            row.className = \'journey-node-row\';\\r\\n\\r\\n            const offset = Math.round(Math.sin(globalIdx * 0.9) * 78);\\r\\n            const isDone = readGuides.has(guide.id);\\r\\n            const isCurrent = \u0021isDone && guide.id === nextGuideId;\\n            const state = isDone ? \'done\' : (isCurrent ? \'current\' : \'upcoming\');\\r\\n            // Alvo da âncora de abertura da trilha (scrollPathToCurrent).\\r\\n            if (isCurrent) row.classList.add(\'is-current\');\\r\\n\\r\\n            const col = document.createElement(\'div\');\\r\\n            col.className = \'journey-node-col\';\\r\\n            col.style.transform = `translateX(${offset}px)`;\\r\\n            // Start and Read use coloured backgrounds; Unread stays white.\\n            const nodeIconColor = isDone || isCurrent ? \'#fff\' : undefined;\\n            // Guia começado e ainda não concluído ganha o anel com a fração\\r\\n            // lida. Concluído não precisa: a bolinha já fica teal por inteiro.\\r\\n            const readFraction = isDone ? 1 : guideReadFraction(guide.id);\\r\\n            const ringHTML = \u0021isDone && readFraction > 0 ? journeyNodeRingHTML(readFraction) : \'\';\\r\\n            col.innerHTML = `\\r\\n          <div class=\\"journey-node ${state}\\" onclick=\\"openGuide(\'${guide.id}\', \'${fromTag}\')\\">\\r\\n            ${guideStatusTag(guide, isCurrent, \'journey-node-label\')}\\n            ${ringHTML}\\r\\n            ${iconHTML(guideIconId(guide), 26, nodeIconColor)}\\r\\n            ${isDone ? `<div class=\\"journey-node-check\\">${iconHTML(\'check-badge\', 12)}</div>` : \'\'}\\r\\n          </div>\\r\\n          <div class=\\"journey-node-title\\">${guide.title}</div>\\r\\n        `;\\r\\n            row.appendChild(col);\\r\\n            body.appendChild(row);\\r\\n            globalIdx++;\\r\\n\\r\\n            // Quiz relacionado logo após o nó do guia — nó quadrado e menor,\\r\\n            // pendurado no guia como um puxadinho. Herda o MESMO offset do\\r\\n            // serpenteado do guia: centralizado ele ficava até 78px de\\r\\n            // distância do nó a que pertence e voltava a parecer uma parada\\r\\n            // independente da trilha, que é exatamente o que não é.\\r\\n            const relatedQuizzes = QUIZ_BY_GUIDE_ID[guide.id];\\r\\n            if (relatedQuizzes) {\\r\\n              relatedQuizzes.forEach(quiz => {\\r\\n                const quizIsCurrent = quiz.id === nextItemId;\\r\\n                globalIdx++;\\r\\n                const quizRow = document.createElement(\'div\');\\r\\n                quizRow.className = \'journey-node-row is-quiz-annex\' + (quizIsCurrent ? \' is-current\' : \'\');\\r\\n                const quizCol = document.createElement(\'div\');\\r\\n                quizCol.className = \'journey-node-col\';\\r\\n                // Deslocado PRA FORA da estrada: alinhado ao guia, o chip fica\\r\\n                // bem em cima do trecho de curva que desce pro próximo guia.\\r\\n                // E não basta jogar pra qualquer lado — tem que ser o lado\\r\\n                // CONTRÁRIO ao rumo da estrada, senão a curva alcança o chip\\r\\n                // no meio do caminho. Como o serpenteado é determinístico\\r\\n                // (sin do índice), dá pra saber pra onde ela vai antes de\\r\\n                // desenhar: o próximo guia usa o índice já incrementado.\\r\\n                const proxOffset = Math.round(Math.sin(globalIdx * 0.9) * 78);\\r\\n                const quizSide = proxOffset > offset ? -52 : 52;\\r\\n                quizCol.style.transform = `translateX(${offset + quizSide}px)`;\\r\\n                quizCol.innerHTML = buildJourneyQuizNode(quiz, quizIsCurrent);\\r\\n                quizRow.appendChild(quizCol);\\r\\n                body.appendChild(quizRow);\\r\\n              });\\r\\n            }\\r\\n          });\\r\\n        }\\r\\n\\r\\n        sectionWrap.appendChild(body);\\r\\n        pathEl.appendChild(sectionWrap);\\r\\n      });\\r\\n\\r\\n      // Completion copy and visibility are configured per journey.\\r\\n      const finish = hydrateContractContent.finishCard || {};\\r\\n      if (finish.enabled \u0021== false) {\\r\\n        const finishCard = document.createElement(\'div\');\\r\\n        finishCard.className = \'journey-finish-card\';\\r\\n        const copy = (key, fallback) => typeof finish[key] === \'string\' ? finish[key] : guideLabel(\'finish\' + key[0].toUpperCase() + key.slice(1), fallback);\\r\\n        const title = document.createElement(\'div\');\\r\\n        title.className = \'journey-finish-title\';\\r\\n        title.textContent = mode === \'list\' ? copy(\'listTitle\', \\"Seu beb\\\\u00ea j\\\\u00e1 passou dos 2 anos?\\") : copy(\'title\', \\"Parab\\\\u00e9ns, voc\\\\u00ea chegou na \\\\u00faltima etapa\u0021\\");\\r\\n        const description = document.createElement(\'div\');\\r\\n        description.className = \'journey-finish-text\';\\r\\n        description.textContent = mode === \'list\' ? copy(\'listText\', \\"A jornada da alimenta\\\\u00e7\\\\u00e3o continua no Garfinho, nosso app para crian\\\\u00e7as a partir de 2 anos.\\") : copy(\'text\', \\"Agora \\\\u00e9 hora de continuar a jornada da alimenta\\\\u00e7\\\\u00e3o no Garfinho, nosso app para crian\\\\u00e7as a partir de 2 anos.\\");\\r\\n        const button = document.createElement(\'button\');\\r\\n        button.className = \'journey-finish-btn\';\\r\\n        button.textContent = copy(\'buttonLabel\', \\"Conhecer o Garfinho \\\\u2192\\");\\r\\n        button.type = \'button\';\\r\\n        button.onclick = () => {\\r\\n          if (finish.actionItem) {\\r\\n            GuidesAPI.openActionItem(finish.actionItem).catch(error => debugLogError(\'completion:openActionItem\', error));\\r\\n          } else {\\r\\n            openGarfinhoApp();\\r\\n          }\\r\\n        };\\r\\n        finishCard.append(title, description, button);\\r\\n        pathEl.appendChild(finishCard);\\r\\n      }\\r\\n\\r\\n      // A estradinha só pode ser medida depois que tudo já está no DOM.\\r\\n      // O rAF espera o layout assentar: medir no mesmo quadro devolve\\r\\n      // posições do estado anterior e a curva nasce desencontrada dos nós.\\r\\n      requestAnimationFrame(() => drawJourneyTrail(pathEl));\\r\\n    }\\r\\n\\r\\n    // Abre o app Garfinho (continuação da jornada para 2+ anos) via deep link.\\r\\n    function openGarfinhoApp() {\\r\\n      const url = \'https://garfinho.app.link/pagina2anos\';\\r\\n      GuidesAPI.openUrl(url).catch(e => debugLogError(\'openGarfinhoApp:GuidesAPI\', e));\\r\\n    }\\r\\n\\r\\n    // ─────────────────────────────────────────────\\r\\n    // A ESTRADINHA DA TRILHA\\r\\n    // ─────────────────────────────────────────────\\r\\n    // Antes isso era um `::before` reto no meio da `.journey-path`. Só que os\\r\\n    // nós serpenteiam (translateX de até ±78px) e a linha não: ela passava\\r\\n    // longe dos nós deslocados e atravessava rótulo. Agora é um SVG desenhado\\r\\n    // a partir da posição REAL de cada nó, então a curva passa por dentro de\\r\\n    // cada guia.\\r\\n    //\\r\\n    // A curva liga guia a guia e ignora o chip do quiz de propósito: assim o\\r\\n    // quiz fica visivelmente pendurado FORA do caminho, que é o que ele é —\\r\\n    // um anexo opcional, não uma parada obrigatória.\\r\\n    //\\r\\n    // Como depende de medida de layout, precisa ser redesenhada toda vez que a\\r\\n    // trilha muda de forma: repinte, recolher/expandir seção, virar a tela e\\r\\n    // entrar na tela (a Home é repintada até com o leitor aberto, e ali as\\r\\n    // medidas são todas zero).\\r\\n    function drawJourneyTrail(pathEl) {\\r\\n      if (\u0021pathEl) return;\\r\\n      const antiga = pathEl.querySelector(\':scope > svg.journey-trail\');\\r\\n      if (antiga) antiga.remove();\\r\\n\\r\\n      // Na visão em lista não existe serpenteado — não existe estrada.\\r\\n      if (pathEl.classList.contains(\'list-mode\')) return;\\r\\n      // Tela fora de vista: getBoundingClientRect devolve zeros e a curva\\r\\n      // sairia toda errada. Quem entra na tela redesenha.\\r\\n      if (\u0021pathEl.offsetParent && pathEl.offsetHeight === 0) return;\\r\\n\\r\\n      const caixa = pathEl.getBoundingClientRect();\\r\\n      if (\u0021caixa.height) return;\\r\\n\\r\\n      const centro = el => {\\r\\n        const r = el.getBoundingClientRect();\\r\\n        if (\u0021r.height) return null; // dentro de seção recolhida\\r\\n        return {\\r\\n          x: r.left - caixa.left + r.width / 2,\\r\\n          y: r.top - caixa.top + r.height / 2,\\r\\n          raio: r.width / 2\\r\\n        };\\r\\n      };\\r\\n\\r\\n      // Percorre na ordem do DOM guardando o último guia visto: o chip de quiz\\r\\n      // que vem depois dele é o galho daquele guia.\\r\\n      const pontos = [];\\r\\n      const galhos = [];\\r\\n      let ultimoGuia = null;\\r\\n      pathEl.querySelectorAll(\'.journey-node, .journey-quiz-node\').forEach(el => {\\r\\n        const c = centro(el);\\r\\n        if (\u0021c) return;\\r\\n        if (el.classList.contains(\'journey-quiz-node\')) {\\r\\n          if (ultimoGuia) galhos.push([ultimoGuia, c]);\\r\\n        } else {\\r\\n          pontos.push(c);\\r\\n          ultimoGuia = c;\\r\\n        }\\r\\n      });\\r\\n      if (pontos.length < 2) return;\\r\\n\\r\\n      // Controles sempre na vertical (mesmo x do nó, y no meio do trecho): é o\\r\\n      // que faz a linha sair e chegar \\"por cima e por baixo\\" de cada nó, com\\r\\n      // cara de estrada sinuosa em vez de zigue-zague de linhas tortas.\\r\\n      let d = `M ${pontos[0].x} ${pontos[0].y}`;\\r\\n      for (let i = 1; i < pontos.length; i++) {\\r\\n        const a = pontos[i - 1], b = pontos[i], meio = (b.y - a.y) / 2;\\r\\n        d += ` C ${a.x} ${a.y + meio}, ${b.x} ${b.y - meio}, ${b.x} ${b.y}`;\\r\\n      }\\r\\n\\r\\n      const NS = \'http://www.w3.org/2000/svg\';\\r\\n      const svg = document.createElementNS(NS, \'svg\');\\r\\n      svg.setAttribute(\'class\', \'journey-trail\');\\r\\n      // Sem viewBox de propósito: as coordenadas já estão em px da própria\\r\\n      // caixa, então 1 unidade = 1 px e nada é reescalado (dash não deforma).\\r\\n      svg.setAttribute(\'width\', caixa.width);\\r\\n      svg.setAttribute(\'height\', caixa.height);\\r\\n\\r\\n      // Galhos primeiro, pra ficarem POR BAIXO da estrada onde se cruzarem.\\r\\n      // Mais finos e sem tracejado: é ramificação, não caminho — a diferença\\r\\n      // de traço é o que diz \\"esse desvio é opcional\\".\\r\\n      galhos.forEach(([guia, chip]) => {\\r\\n        const dx = chip.x - guia.x, dy = chip.y - guia.y;\\r\\n        const dist = Math.hypot(dx, dy) || 1;\\r\\n        // Sai da BORDA do guia e para na BORDA do chip: linha entrando por\\r\\n        // baixo do círculo apareceria como risco atravessando o ícone.\\r\\n        const ax = guia.x + dx / dist * guia.raio, ay = guia.y + dy / dist * guia.raio;\\r\\n        const bx = chip.x - dx / dist * chip.raio, by = chip.y - dy / dist * chip.raio;\\r\\n        const galho = document.createElementNS(NS, \'path\');\\r\\n        galho.setAttribute(\'d\', `M ${ax} ${ay} Q ${ax} ${by}, ${bx} ${by}`);\\r\\n        galho.setAttribute(\'fill\', \'none\');\\r\\n        galho.setAttribute(\'stroke\', \'#e0d8ce\');\\r\\n        galho.setAttribute(\'stroke-width\', \'2.5\');\\r\\n        galho.setAttribute(\'stroke-linecap\', \'round\');\\r\\n        svg.appendChild(galho);\\r\\n      });\\r\\n\\r\\n      const linha = document.createElementNS(NS, \'path\');\\r\\n      linha.setAttribute(\'d\', d);\\r\\n      linha.setAttribute(\'fill\', \'none\');\\r\\n      linha.setAttribute(\'stroke\', \'#e8e0d8\');\\r\\n      linha.setAttribute(\'stroke-width\', \'6\');\\r\\n      linha.setAttribute(\'stroke-linecap\', \'round\');\\r\\n      linha.setAttribute(\'stroke-dasharray\', \'10 10\');\\r\\n      svg.appendChild(linha);\\r\\n      pathEl.insertBefore(svg, pathEl.firstChild);\\r\\n    }\\r\\n\\r\\n    function redrawAllJourneyTrails() {\\r\\n      drawJourneyTrail(document.getElementById(\'journey-path\'));\\r\\n      drawJourneyTrail(document.getElementById(\'journey-path-home\'));\\r\\n    }\\r\\n\\r\\n    let journeyTrailResizeTimer = null;\\r\\n    window.addEventListener(\'resize\', () => {\\r\\n      clearTimeout(journeyTrailResizeTimer);\\r\\n      journeyTrailResizeTimer = setTimeout(redrawAllJourneyTrails, 120);\\r\\n    });\\r\\n\\r\\n    function renderJourney() {\\r\\n      paintJourney(\\r\\n        document.getElementById(\'journey-path\'),\\r\\n        document.getElementById(\'journey-progress-label\'),\\r\\n        document.getElementById(\'journey-progress-fill\'),\\r\\n        \'journey\'\\r\\n      );\\r\\n    }\\r\\n\\r\\n    // Trilha embutida na tela inicial (home), visível antes de escolher a idade.\\r\\n    // A Home é a única tela com o toggle jornada/lista — a tela cheia\\r\\n    // \\"screen-journey\\" continua sempre no formato de mapa.\\r\\n    function renderJourneyHome() {\\r\\n      renderHomeViewToggle();\\r\\n      paintJourney(\\r\\n        document.getElementById(\'journey-path-home\'),\\r\\n        document.getElementById(\'journey-progress-label-home\'),\\r\\n        document.getElementById(\'journey-progress-fill-home\'),\\r\\n        \'journey-home\',\\r\\n        homeViewMode\\r\\n      );\\r\\n      // A trilha acabou de ser repintada: reancora no \\"Começar\\". Sai sozinho\\r\\n      // quando a Home não está à vista (o offsetParent da trilha é nulo) — é o\\r\\n      // caso do repinte que acontece com o leitor aberto, ao marcar como lido.\\r\\n      scrollPathToCurrent(document.getElementById(\'journey-path-home\'));\\r\\n    }\\r\\n\\r\\n    function renderHomeViewToggle() {\\r\\n      const journeyBtn = document.getElementById(\'view-toggle-journey\');\\r\\n      const listBtn = document.getElementById(\'view-toggle-list\');\\r\\n      if (\u0021journeyBtn || \u0021listBtn) return;\\r\\n      journeyBtn.classList.toggle(\'active\', homeViewMode \u0021== \'list\');\\r\\n      listBtn.classList.toggle(\'active\', homeViewMode === \'list\');\\r\\n    }\\r\\n\\r\\n    function setHomeViewMode(mode) {\\r\\n      mode = mode === \'list\' ? \'list\' : \'journey\';\\r\\n      if (homeViewMode === mode) return;\\r\\n      homeViewMode = mode;\\r\\n      saveReadGuides();\\r\\n      renderJourneyHome();\\r\\n    }\\r\\n\\r\\n    // ─────────────────────────────────────────────\\r\\n    // OPEN GUIDE\\r\\n    // ─────────────────────────────────────────────\\r\\n    // ─────────────────────────────────────────────\\r\\n    // PROCESS GUIDE HTML (TOC links, paragraph merge, references)\\r\\n    // ─────────────────────────────────────────────\\r\\n    // Chamada pelo onclick inline dos links do \\"Neste guia\\" (ver processGuideHTML\\r\\n    // abaixo). Não pode ser addEventListener: o HTML dos links é montado numa\\r\\n    // <div> temporária e devolvido como STRING (wrap.innerHTML) — só atributos\\r\\n    // (href, onclick) sobrevivem a essa serialização, listeners não.\\r\\n    function scrollToGuideSection(secId) {\\r\\n      const target = document.getElementById(secId);\\r\\n      if (\u0021target) return;\\r\\n      // scrollIntoView(block:\'start\')/salto nativo de #hash alinham o topo do\\r\\n      // título com o topo da tela — mas o header do leitor é sticky e cobre\\r\\n      // esse espaço, escondendo o título atrás dele. Desconta a altura do\\r\\n      // header (+ uma folguinha) na posição final.\\r\\n      const navEl = document.querySelector(\'.reader-nav\');\\r\\n      const offset = (navEl ? navEl.offsetHeight : 0) + 12;\\r\\n      const y = target.getBoundingClientRect().top + getScrollMetrics().top - offset;\\r\\n      scrollContainerTo(y, true);\\r\\n    }\\r\\n\\r\\n    function processGuideHTML(rawHTML) {\\r\\n      const wrap = document.createElement(\'div\');\\r\\n      wrap.innerHTML = rawHTML;\\r\\n\\r\\n      // ── 1. Remove junk artifact nodes ──\\r\\n      wrap.querySelectorAll(\'p\').forEach(p => {\\r\\n        const t = p.textContent.trim();\\r\\n        const hasMedia = \u0021\u0021p.querySelector(\'img, video, audio, iframe, picture, svg\');\\r\\n        if ((\u0021t && \u0021hasMedia) || /^[·\\\\-\\\\.\\\\s]{1,3}$/.test(t) || /^mais\\\\d+$/.test(t)) p.remove();\\r\\n      });\\r\\n\\r\\n      // Authored WYSIWYG tables of contents arrive as one paragraph containing\\r\\n      // two or more #anchor links separated by <br> tags. Turn that very\\r\\n      // specific shape into the same card UI as an inferred \\"Neste guia\\" TOC.\\r\\n      // Requiring every link to resolve inside this guide keeps ordinary links\\r\\n      // and the image-based \\"voltar ao topo\\" controls unchanged.\\r\\n      const guideTargetIds = new Set(\\r\\n        [...wrap.querySelectorAll(\'[id]\')].map(el => el.id).filter(Boolean)\\r\\n      );\\r\\n      const authoredTocParagraph = [...wrap.querySelectorAll(\'p\')].find(p => {\\r\\n        if (p.querySelector(\'img, video, audio, iframe, picture, svg\')) return false;\\r\\n        const links = [...p.querySelectorAll(\'a\')];\\r\\n        if (links.length < 2) return false;\\r\\n        if (\u0021[...p.childNodes].every(node =>\\r\\n          node.nodeType === 3\\r\\n            ? \u0021node.textContent.trim()\\r\\n            : node.nodeType === 1 && (node.tagName === \'A\' || node.tagName === \'BR\')\\r\\n        )) return false;\\r\\n        return links.every(a => {\\r\\n          const href = a.getAttribute(\'href\') || \'\';\\r\\n          return href.startsWith(\'#\') && href.length > 1 &&\\r\\n            guideTargetIds.has(href.slice(1)) && a.textContent.trim();\\r\\n        });\\r\\n      });\\r\\n\\r\\n      if (authoredTocParagraph) {\\r\\n        const authoredToc = document.createElement(\'div\');\\r\\n        authoredToc.className = \'guide-toc\';\\r\\n\\r\\n        const tocLabel = document.createElement(\'div\');\\r\\n        tocLabel.className = \'toc-label\';\\r\\n        tocLabel.textContent = \'\\\\uD83D\\\\uDCCB \' + guideLabel(\'inThisGuide\', \'Neste guia\');\\r\\n        authoredToc.appendChild(tocLabel);\\r\\n\\r\\n        authoredTocParagraph.querySelectorAll(\'a\').forEach(sourceLink => {\\r\\n          const href = sourceLink.getAttribute(\'href\');\\r\\n          const link = document.createElement(\'a\');\\r\\n          link.className = \'toc-link\';\\r\\n          link.href = href;\\r\\n          link.textContent = sourceLink.textContent\\r\\n            .replace(/^[\\\\s\\\\u2022\\\\u00b7\\\\u25aa\\\\u2023\\\\u25e6\\\\-\\\\u2013\\\\u2014]+/, \'\')\\r\\n            .trim();\\r\\n          link.setAttribute(\\r\\n            \'onclick\',\\r\\n            \\"scrollToGuideSection(this.getAttribute(\'href\').slice(1)); return false;\\"\\r\\n          );\\r\\n          authoredToc.appendChild(link);\\r\\n        });\\r\\n\\r\\n        authoredTocParagraph.parentNode.replaceChild(authoredToc, authoredTocParagraph);\\r\\n      }\\r\\n\\r\\n      // ── 2. Merge broken paragraphs ──\\r\\n      // IMPORTANT: no /i flag — only merge when NEXT starts with lowercase.\\r\\n      // This preserves uppercase TOC items and section headers as separate nodes.\\r\\n      let merged = true;\\r\\n      while (merged) {\\r\\n        merged = false;\\r\\n        const ps = [...wrap.querySelectorAll(\'p\')];\\r\\n        for (let i = 0; i < ps.length - 1; i++) {\\r\\n          const a = ps[i], b = ps[i + 1];\\r\\n          if (a.parentNode \u0021== b.parentNode) continue;\\r\\n          // Links are intentional standalone WYSIWYG content. In particular,\\r\\n          // never merge adjacent BuildFire Action Items into one paragraph.\\r\\n          if (a.querySelector(\'a\') || b.querySelector(\'a\')) continue;\\r\\n          const aText = a.textContent.trim();\\r\\n          const bText = b.textContent.trim();\\r\\n          if (\u0021aText || \u0021bText) continue;\\r\\n          if (\u0021/[.\u0021?:;»\\"\')\\\\]]$/.test(aText) && /^[a-záàâãéêíóôõúüçñ]/.test(bText)) {\\r\\n            a.innerHTML = a.innerHTML.trimEnd() + \' \' + b.innerHTML.trimStart();\\r\\n            b.remove();\\r\\n            merged = true;\\r\\n            break;\\r\\n          }\\r\\n        }\\r\\n      }\\r\\n\\r\\n      // ── 3. Detect TOC items at top ──\\r\\n      // TOC items: short <p> tags that appear before any long body paragraph,\\r\\n      // don\'t end with sentence punctuation, start with any letter. \\"?\\" is\\r\\n      // allowed at the end (some guides title their topics as questions, e.g.\\r\\n      // \\"O que é BLW?\\"), so it doesn\'t count as \\"hit body text\\" on its own.\\r\\n      const allPs = [...wrap.querySelectorAll(\'p\')];\\r\\n      const tocItems = [];\\r\\n      const hasAuthoredAnchors = \u0021\u0021wrap.querySelector(\'a[href^=\\"#\\"]:not([href=\\"#\\"]), a[data-action-item]\');\\r\\n      // Legacy BuildFire WYSIWYG guides often contain their own table of\\r\\n      // contents. Preserve those authored links and IDs instead of replacing\\r\\n      // them with the shell\'s inferred TOC.\\r\\n      if (\u0021hasAuthoredAnchors) {\\r\\n        for (let i = 0; i < allPs.length; i++) {\\r\\n          const text = allPs[i].textContent.trim();\\r\\n          if (\u0021text) continue;\\r\\n          if (text.length > 110 || /[.,;\u0021]$/.test(text)) {\\r\\n            // Hit body text - stop collecting TOC\\r\\n            break;\\r\\n          }\\r\\n          tocItems.push({ el: allPs[i], text, secId: null });\\r\\n        }\\r\\n      }\\r\\n      // Need at least 2 items for a real TOC\\r\\n      if (tocItems.length < 2) tocItems.length = 0;\\r\\n\\r\\n      // ── 4. Promote short standalone <p> to <h3> (section headers) ──\\r\\n      // This runs BEFORE matching TOC items so newly-created h3s can be found.\\r\\n      // Leading \\"1. \\"/\\"2) \\" numbering is stripped before comparing/labeling -\\r\\n      // the TOC item has it (from the numbered list) but the matching section\\r\\n      // paragraph in the body usually doesn\'t.\\r\\n      const stripNum = s => s.replace(/^\\\\d+[.)]\\\\s*/, \'\');\\r\\n      const normStr = s => stripNum(s).toLowerCase().replace(/[^\\\\wáàâãéêíóôõúüç]/g, \'\');\\r\\n      const tocEls = new Set(tocItems.map(t => t.el));\\r\\n\\r\\n      wrap.querySelectorAll(\'p\').forEach(p => {\\r\\n        if (tocEls.has(p)) return; // skip TOC items\\r\\n        if (p.querySelector(\'a\')) return; // preserve authored WYSIWYG links and Action Items\\r\\n        const text = p.textContent.trim();\\r\\n        if (\u0021text) return;\\r\\n        const words = text.split(/\\\\s+/).length;\\r\\n        if (\\r\\n          text.length >= 4 && text.length <= 85 &&\\r\\n          /^[A-ZÁÀÂÃÉÊÍÓÔÕÚÜÇ0-9]/.test(text) && // starts uppercase or number\\r\\n          \u0021/[.,;\u0021]$/.test(text) &&                // no sentence punctuation at end (\\"?\\" allowed - section titles can be questions)\\r\\n          words <= 10                              // max 10 words\\r\\n        ) {\\r\\n          const h3 = document.createElement(\'h3\');\\r\\n          h3.innerHTML = p.innerHTML;\\r\\n          p.parentNode.replaceChild(h3, p);\\r\\n        }\\r\\n      });\\r\\n\\r\\n      // ── 5. Match TOC items to promoted h3 section headers ──\\r\\n      if (tocItems.length >= 2) {\\r\\n        const h3s = [...wrap.querySelectorAll(\'h3\')];\\r\\n\\r\\n        tocItems.forEach((toc, i) => {\\r\\n          const tocN = normStr(toc.text);\\r\\n          let best = null, bestLen = 0;\\r\\n          for (const h of h3s) {\\r\\n            const hN = normStr(h.textContent);\\r\\n            const check = Math.min(tocN.length, hN.length, 22);\\r\\n            if (check < 4) continue;\\r\\n            if (tocN.substring(0, check) === hN.substring(0, check) && check > bestLen) {\\r\\n              bestLen = check;\\r\\n              best = h;\\r\\n            }\\r\\n          }\\r\\n          if (best) {\\r\\n            best.id = \'gs\' + i;\\r\\n            toc.secId = \'gs\' + i;\\r\\n          }\\r\\n        });\\r\\n\\r\\n        // O 1º item do sumário costuma ser a pergunta que o guia já começa\\r\\n        // respondendo (ex.: \\"O que é BLW?\\") - sem uma seção própria pra achar,\\r\\n        // mas o começo do corpo do texto É a resposta. Aponta pra lá.\\r\\n        const firstToc = tocItems[0];\\r\\n        if (firstToc && \u0021firstToc.secId) {\\r\\n          const firstBodyEl = tocItems[tocItems.length - 1].el.nextElementSibling;\\r\\n          if (firstBodyEl) {\\r\\n            firstBodyEl.id = \'gs-intro\';\\r\\n            firstToc.secId = \'gs-intro\';\\r\\n          }\\r\\n        }\\r\\n\\r\\n        // Build the TOC box\\r\\n        const tocDiv = document.createElement(\'div\');\\r\\n        tocDiv.className = \'guide-toc\';\\r\\n        const label = document.createElement(\'div\');\\r\\n        label.className = \'toc-label\';\\r\\n        label.textContent = \'📋 \' + guideLabel(\'inThisGuide\', \'Neste guia\');\\r\\n        tocDiv.appendChild(label);\\r\\n        tocItems.forEach(({ el, secId, text }) => {\\r\\n          const a = document.createElement(\'a\');\\r\\n          a.className = \'toc-link\' + (secId ? \'\' : \' toc-link-noanchor\');\\r\\n          a.textContent = stripNum(text);\\r\\n          if (secId) {\\r\\n            a.href = \'#\' + secId;\\r\\n            // onclick inline, não addEventListener: este <a> é montado numa\\r\\n            // <div> temporária e devolvido como string (ver nota acima em\\r\\n            // scrollToGuideSection) - um listener JS não sobreviveria.\\r\\n            a.setAttribute(\'onclick\', `scrollToGuideSection(\'${secId}\'); return false;`);\\r\\n          }\\r\\n          tocDiv.appendChild(a);\\r\\n          el.remove();\\r\\n        });\\r\\n        wrap.insertBefore(tocDiv, wrap.firstChild);\\r\\n      }\\r\\n\\r\\n      // ── 6. Style references ONLY when explicit \\"Referências\\" heading exists ──\\r\\n      // Real academic references follow an explicit heading - numbered tips do NOT count.\\r\\n      let refHeading = null;\\r\\n      wrap.querySelectorAll(\'h3, p\').forEach(el => {\\r\\n        if (/^referên/i.test(el.textContent.trim())) refHeading = el;\\r\\n      });\\r\\n\\r\\n      if (refHeading) {\\r\\n        const refDiv = document.createElement(\'div\');\\r\\n        refDiv.className = \'guide-refs\';\\r\\n        refDiv.innerHTML = \'<div class=\\"refs-label\\">📚 \' + _escapeHtml(guideLabel(\'references\', \'Referências\')) + \'</div>\';\\r\\n        let node = refHeading.nextSibling;\\r\\n        refHeading.remove();\\r\\n        while (node) {\\r\\n          const next = node.nextSibling;\\r\\n          if (node.nodeType === 1) {\\r\\n            const item = document.createElement(\'div\');\\r\\n            item.className = \'ref-item\';\\r\\n            let html = node.innerHTML || \'\';\\r\\n            html = html.replace(/(https?:\\\\/\\\\/[^\\\\s<]+)/g, \'<a href=\\"$1\\" target=\\"_blank\\" rel=\\"noopener\\">$1</a>\');\\r\\n            item.innerHTML = html;\\r\\n            refDiv.appendChild(item);\\r\\n            node.remove();\\r\\n          }\\r\\n          node = next;\\r\\n        }\\r\\n        if (refDiv.querySelectorAll(\'.ref-item\').length > 0) wrap.appendChild(refDiv);\\r\\n      }\\r\\n\\r\\n      return wrap.innerHTML;\\r\\n    }\\r\\n\\r\\n    function parseBuildFireActionItem(value) {\\r\\n      const source = String(value || \'\').trim();\\r\\n      const candidates = [source];\\r\\n      try { candidates.push(decodeURIComponent(source)); } catch (error) { /* legacy Latin-1 encoding */ }\\r\\n      if (typeof window.unescape === \'function\') candidates.push(window.unescape(source));\\r\\n      for (const candidate of candidates) {\\r\\n        try {\\r\\n          const parsed = JSON.parse(candidate);\\r\\n          if (parsed && typeof parsed === \'object\') return parsed;\\r\\n        } catch (error) { /* try the next supported encoding */ }\\r\\n      }\\r\\n      return null;\\r\\n    }\\r\\n\\r\\n    function prepareWysiwygGuideContent(content) {\\r\\n      if (\u0021content) return;\\r\\n      content.querySelectorAll(\'script\').forEach(script => script.remove());\\r\\n      content.querySelectorAll(\'*\').forEach(element => {\\r\\n        Array.from(element.attributes).forEach(attribute => {\\r\\n          const name = attribute.name.toLowerCase();\\r\\n          const value = attribute.value.trim().toLowerCase();\\r\\n          if (name.startsWith(\'on\') || name === \'srcdoc\') element.removeAttribute(attribute.name);\\r\\n          else if ([\'href\', \'src\', \'xlink:href\'].includes(name) && value.startsWith(\'javascript:\')) {\\r\\n            element.removeAttribute(attribute.name);\\r\\n          }\\r\\n        });\\r\\n      });\\r\\n      // The same reader container is reused when opening another guide.\\r\\n      if (content.dataset.guidesActionsBound) return;\\r\\n      content.dataset.guidesActionsBound = \'true\';\\r\\n      content.addEventListener(\'click\', event => {\\r\\n        const link = event.target.closest && event.target.closest(\'[data-action-item], [data-execute], a\');\\r\\n        if (\u0021link || \u0021content.contains(link)) return;\\r\\n        const encodedAction = link.getAttribute(\'data-action-item\') || link.getAttribute(\'data-execute\');\\r\\n        if (encodedAction) {\\r\\n          event.preventDefault();\\r\\n          event.stopImmediatePropagation();\\r\\n          const action = parseBuildFireActionItem(encodedAction);\\r\\n          if (action && typeof GuidesAPI.openActionItem === \'function\') {\\r\\n            GuidesAPI.openActionItem(action).catch(error => debugLogError(\'openActionItem:GuidesAPI\', error));\\r\\n          }\\r\\n          return;\\r\\n        }\\r\\n        const href = link.getAttribute(\'href\') || \'\';\\r\\n        if (href.length > 1 && href.charAt(0) === \'#\') {\\r\\n          const targetId = decodeURIComponent(href.slice(1));\\r\\n          if (document.getElementById(targetId)) {\\r\\n            event.preventDefault();\\r\\n            event.stopImmediatePropagation();\\r\\n            scrollToGuideSection(targetId);\\r\\n          }\\r\\n        } else if (/^https?:\\\\/\\\\//i.test(href)) {\\r\\n          event.preventDefault();\\r\\n          event.stopImmediatePropagation();\\r\\n          GuidesAPI.openUrl(href).catch(error => debugLogError(\'openUrl:GuidesAPI\', error));\\r\\n        }\\r\\n      }, true);\\r\\n    }\\r\\n\\r\\n    // ─────────────────────────────────────────────\\r\\n    // ASSINATURA (Buildfire in-app purchase)\\r\\n    // ─────────────────────────────────────────────\\r\\n    function checkIsPurchased(subscriptionIds) {\\r\\n      const perProduct = [];\\r\\n      const checks = subscriptionIds.map((subscriptionId) => {\\r\\n        return new Promise((resolve) => {\\r\\n          const options = { productId: subscriptionId, type: \\"subscriptions\\" };\\r\\n          window.__legacyBuildFireDisabled.services.commerce.inAppPurchase.checkIsPurchased(options, (err, purchased) => {\\r\\n            console.log(\'[assinatura] checkIsPurchased(\' + subscriptionId + \') =>\', err || null, purchased);\\r\\n            if (err) {\\r\\n              perProduct.push({ productId: subscriptionId, err: debugSafe(err) });\\r\\n              console.error(\'Error:\', subscriptionId, err);\\r\\n              resolve(false);\\r\\n              return;\\r\\n            }\\r\\n            perProduct.push({ productId: subscriptionId, purchased });\\r\\n            resolve(purchased);\\r\\n          });\\r\\n        });\\r\\n      });\\r\\n      return Promise.all(checks).then(results => {\\r\\n        debugState.checkIsPurchasedPerProduct = perProduct;\\r\\n        return results.some(r => r === true);\\r\\n      });\\r\\n    }\\r\\n\\r\\n    // Fora do Buildfire de verdade (testando puro no navegador) libera tudo, igual\\r\\n    // ao comportamento do código de referência para platform === \\"web\\". Mas se o\\r\\n    // Buildfire existe e o serviço de commerce/IAP não está disponível, NÃO libera\\r\\n    // por padrão - bloqueia (fail-closed) e avisa no console, porque isso indica\\r\\n    // um problema de configuração do plugin de Commerce, não um teste fora do app.\\r\\n    function getSubscriptions() {\\r\\n      return new Promise((resolve) => {\\r\\n        try {\\r\\n          if (\u0021window.__legacyBuildFireDisabled) {\\r\\n            hasSubscriptions = true;\\r\\n            debugState.platform = \'sem buildfire (fora do app)\';\\r\\n            debugState.hasSubscriptionsResolved = true;\\r\\n            console.log(\'[assinatura] Buildfire indisponível (fora do app) - liberando tudo.\');\\r\\n            resolve();\\r\\n            return;\\r\\n          }\\r\\n          debugState.platform = debugSafe(window.__legacyBuildFireDisabled.getContext && window.__legacyBuildFireDisabled.getContext().device && window.__legacyBuildFireDisabled.getContext().device.platform);\\r\\n          if (window.__legacyBuildFireDisabled.getContext && window.__legacyBuildFireDisabled.getContext().device && window.__legacyBuildFireDisabled.getContext().device.platform === \'web\') {\\r\\n            hasSubscriptions = true;\\r\\n            debugState.hasSubscriptionsResolved = true;\\r\\n            console.log(\'[assinatura] platform=web - liberando tudo.\');\\r\\n            resolve();\\r\\n            return;\\r\\n          }\\r\\n          debugState.commerceAvailable = \u0021\u0021(window.__legacyBuildFireDisabled.services && window.__legacyBuildFireDisabled.services.commerce && window.__legacyBuildFireDisabled.services.commerce.inAppPurchase);\\r\\n          if (\u0021window.__legacyBuildFireDisabled.services || \u0021window.__legacyBuildFireDisabled.services.commerce || \u0021window.__legacyBuildFireDisabled.services.commerce.inAppPurchase || \u0021window.__legacyBuildFireDisabled.auth) {\\r\\n            hasSubscriptions = false;\\r\\n            debugState.hasSubscriptionsResolved = false;\\r\\n            debugLogError(\'getSubscriptions:commerce-indisponivel\'